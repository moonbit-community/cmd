----
import {
  "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process", "moonbitlang/core/env",
  "moonbitlang/core/json", "moonbitlang/x@0.5.5/crypto", "moonbitlang/x@0.5.5/path",
}
----

fn field(value : Json,key : String) -> Json {match value {Object(fields)=>fields.get(key).unwrap_or(Json::null());_=>Json::null()}}
fn text(value : Json) -> String raise {guard value is String(text) else{fail("expected string")};text}
fn rows(value : Json) -> Array[Json] raise {guard value is Array(rows) else{fail("expected array")};rows}
fn valid_sha256(value : String) -> Bool {
  value.length()==64 && value.iter().all(c=>(c>='0' && c<='9') || (c>='a' && c<='f'))
}
fn disclosed_sources(value : Json) -> Array[Json] raise {
  guard field(value,"schema")==Json(1) && field(value,"retention")==Json("append-only") && field(value,"classification")==Json("ordinary-after-disclosure") else {fail("invalid disclosed-source inventory schema or classification")}
  let sources=rows(field(value,"sources"))
  guard !sources.is_empty() else {fail("disclosed-source inventory must retain its historical identities")}
  let seen : Set[String]=Set([])
  for source in sources {
    let sha=text(field(source,"sha256"))
    guard valid_sha256(sha) && !seen.contains(sha) else {fail("invalid or duplicate disclosed source SHA-256")}
    seen.add(sha)
    guard field(source,"split")==Json("ordinary") && field(source,"classification")==Json("ordinary-after-disclosure") else {fail("disclosed source has a stale reserved/holdout classification")}
    for key in ["path","provider","url","provenance","license"] {guard !text(field(source,key)).trim().is_empty() else {fail("incomplete disclosed source provenance: "+key)}}
    let bytes : Int64=@json.from_json(field(source,"bytes"))
    let disclosure=field(source,"disclosure")
    let observed : Int64=@json.from_json(field(disclosure,"observed_at_ms"))
    guard bytes>0L && observed>0L && field(disclosure,"kind")==Json("reserved-evaluation") && [Json("failed"),Json("passed"),Json("started-not-adjudicated")].contains(field(disclosure,"outcome")) else {fail("invalid disclosed evaluation provenance")}
    for key in ["candidate_sha256","selection_sha256","manifest_sha256","evidence_sha256"] {guard valid_sha256(text(field(disclosure,key))) else {fail("invalid disclosed evaluation identity: "+key)}}
  }
  // These first disclosed sources must survive even before the ledger's first
  // commit. Later additions are preserved by the append-only record operation.
  for sha in ["a33695f21dff308ba3e900244a083450331d8aa215a641f612eb218e49b272d9","57194e43b001b8f832987b21b82953d997aeeaebeb53a8520140bc12d7d8cfcc","2af5abf98554af1599e516f31f7f1698085e6faa12b816401f569c097b9f7ef6"] {guard sources.any(source=>field(source,"sha256")==Json(sha) && field(field(source,"disclosure"),"outcome")==Json("failed") && field(field(source,"disclosure"),"evidence_sha256")==Json("647ccca2d8014ba7c00dd4ac20f04a0434150814275770ac7f7bcc2a615edfe3")) else {fail("disclosed-source inventory lost or relabeled an original failed evaluation identity")}}
  sources
}
async fn verify_committed_history(sources : Array[Json]) -> Unit {
  let path="tests/fixtures/benchmark/disclosed-sources.json"
  let committed=@process.collect_output("git",["show","HEAD:"+path],extra_env=Map([("LC_ALL","C")]))
  if committed.0==0 {
    let previous=disclosed_sources(@json.parse(committed.1.text()))
    guard sources.length()>=previous.length() && sources[:previous.length()]==previous[:] else {fail("disclosed-source ledger rewrites or removes committed history")}
  }else{
    // Bootstrap is anchored by the three failed-evaluation identities above.
    guard committed.0==128 && committed.2.text().contains("exists on disk, but not in 'HEAD'") else {fail("cannot establish committed disclosed-source history")}
  }
}

///|
async fn known_source_union(disclosed : Array[Json]) -> Array[String] {
  let seen : Set[String]=Set([])
  for source in disclosed {seen.add(text(field(source,"sha256")))}
  for path in ["tests/fixtures/benchmark/rg-real-inputs.json","tests/fixtures/benchmark/natural-sources.json","tests/benchmark/natural.json","tests/fixtures/benchmark/real-sources.json"] {
    let data=@json.parse(@fs.read_file(path).text())
    let records=match data {Array(items)=>items;{"files":Array(items),..}=>items;{"workloads":Array(items),..}=>items;_=>abort("invalid observed source inventory")}
    for item in records {
      let value=match item {{"sha256":String(sha),..}=>Some(sha);{"source":{"sha256":String(sha),..},..}=>Some(sha);_=>None}
      if value is Some(sha) {guard valid_sha256(sha) else {fail("invalid SHA-256 in observed source inventory: "+path)};seen.add(sha)}
    }
  }
  let seen=seen.to_array();seen.sort();seen
}

async fn hash(path : String) -> String {
  let input=@fs.open(path,mode=ReadOnly)
  defer input.close()
  let digest=@crypto.SHA256::new()
  let buffer=FixedArray::make(65536,b'\x00')
  let bytes=buffer.unsafe_reinterpret_as_bytes()
  while input.read(buffer) is count && count>0 {digest.update(bytes[:count])}
  @crypto.bytes_to_hex_string(digest.finalize())
}
async fn copy(source : String,target : String) -> String {
  @fs.mkdir(@path.Path(target).dirname().to_string(),recursive=true,allow_exist=true)
  let input=@fs.open(source,mode=ReadOnly)
  defer input.close()
  let output=@fs.create(target,allow_existing=false)
  defer output.close()
  let buffer=FixedArray::make(65536,b'\x00')
  let bytes=buffer.unsafe_reinterpret_as_bytes()
  while input.read(buffer) is count && count>0 {output.write(bytes[:count])}
  output.close()
  let digest=hash(target)
  assert_eq(hash(source),digest)
  digest
}
async fn main {
  let args=@env.args()
  if args.length()==2 && args[1]=="--check-known-inventories" {
    let disclosed=disclosed_sources(@json.parse(@fs.read_file("tests/fixtures/benchmark/disclosed-sources.json").text()))
    verify_committed_history(disclosed)
    println(({"seen_sha256":Json(known_source_union(disclosed)),"scope":"declared observed-source union only; no candidate or reservation acceptance"} : Json).stringify(indent=2))
    return
  }
  if args.length()==3 && args[1]=="--check-ledger" {
    let sources=disclosed_sources(@json.parse(@fs.read_file(args[2]).text()))
    verify_committed_history(sources)
    println("Valid append-only disclosed-source inventory: "+sources.length().to_string()+" identities")
    return
  }
  guard args.length()==4 && @path.Path(args[1]).is_absolute() else {fail("Usage: freeze_candidate.mbtx FRESH_ABS_DIRECTORY ABS_BENCHMARK ABS_MOONRUN; test evidence only")}
  let target=args[1]
  @fs.mkdir(target,recursive=true,allow_exist=false)
  let disclosure_path="tests/fixtures/benchmark/disclosed-sources.json"
  let disclosure_sha=copy(disclosure_path,target+"/disclosed-sources.json")
  let disclosed=disclosed_sources(@json.parse(@fs.read_file(target+"/disclosed-sources.json").text()))
  verify_committed_history(disclosed)
  for source in disclosed {let observed : Int64=@json.from_json(field(field(source,"disclosure"),"observed_at_ms"));guard observed<=@async.now() else {fail("disclosed-source observation is in the future")}}
  let listed=@process.collect_output("git",["ls-files","--cached","--others","--exclude-standard","-z","core","commands"])
  assert_eq(listed.0,0)
  let identities : Array[(String,String)]=[]
  for path in listed.1.text().split("\u0000") {
    if !path.is_empty() {let path=path.to_owned();identities.push((path,copy(path,target+"/source/"+path)))}
  }
  let capture=@process.redirect_to_file(target+"/build.log")
  let status=@process.run("moon",["build","--target","wasm","--release","--deny-warn"],stdout=capture,stderr=capture)
  capture.close()
  assert_eq(status,0)
  for (path,digest) in identities {assert_eq(hash(path),digest,msg="source changed during snapshot build")}
  let artifacts : Array[Json]=[]
  for command in @fs.readdir("commands") {
    if !(@fs.kind("commands/"+command) is Directory) || !@fs.exists("commands/"+command+"/moon.mod") {continue}
    let path="cli/"+command+"/"+command+".wasm"
    artifacts.push({"command":command,"path":path,"sha256":copy("_build/wasm/release/build/"+path,target+"/wasm/"+path)})
  }
  assert_eq(artifacts.length(),80)
  let policy : Array[(String,String)]=[]
  for path in ["tests/benchmark/reservation-policy.json","tests/benchmark/mode-definitions.json","tests/benchmark/real.json","tests/benchmark/real-coverage.json","tests/benchmark/reserved.mbtx","tests/benchmark/freeze_candidate.mbtx",disclosure_path,"tests/fixtures/benchmark/rg-real-inputs.json","tests/fixtures/benchmark/natural-sources.json","tests/benchmark/natural.json","tests/fixtures/benchmark/real-sources.json"] {policy.push((path,hash(path)))}
  let seen=known_source_union(disclosed)
  assert_eq(hash(disclosure_path),disclosure_sha,msg="disclosed-source inventory changed during candidate freeze")
  let result : Json={"schema":1,"purpose":"unchanged-candidate reserved correctness evidence; no release package or publication","source_files":Json(identities),"artifacts":artifacts,"policy_files":Json(policy),"disclosure_inventory":{"path":disclosure_path,"snapshot_path":"disclosed-sources.json","sha256":disclosure_sha,"sources":disclosed},"seen_sha256":Json(seen),"benchmark_sha256":hash(args[2]),"moonrun_sha256":hash(args[3]),"frozen_at_ms":@async.now()}
  @fs.write_file(target+"/candidate.json",result.stringify(indent=2)+"\n")
  println("Frozen test candidate and source-selection policy: "+target)
}
