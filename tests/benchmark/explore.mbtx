    "join-ordered",
    "join",
    [lab + "/ordered", lab + "/ordered"],
    "empty",
    "unused",
  )
  add(
    "comm-ordered",
    "comm",
    [lab + "/ordered", lab + "/ordered"],
    "empty",
    "unused",
  )
  add("paste-serial-8m", "paste", ["-s"], "text8m", cu + "paste")
  for
    command in [
      "cksum", "md5sum", "sha1sum", "sha256sum", "sha512sum", "nl", "paste",
    ] {
    add(command + "-8m", command, [], "text8m", cu + command)
  }
  let selected = args[4].split(",").map(x => x.to_owned()).collect()
  let trials = @string.parse_int(args[5])
  guard trials > 0 else { fail("positive pair count required") }
  guard !selected.is_empty() &&
    selected.all(id => cases.any(case => case.id == id)) else {
    fail("unknown or empty case selection")
  }
  if mode == "profiles" {
    println(Json(cases.filter(case => selected.contains(case.id))).stringify())
    return
  }
  let temporary = @fs.tmpdir(prefix="cmd-perf-id-")
  let root = lab +
    "/results/" +
    mode +
    "-" +
    temporary.split("/").last().unwrap().to_owned()
  @fs.remove(temporary)
  @fs.mkdir(root)
  let rows : Array[Json] = []
  let mut all_passed = true
  for case in cases {
    if !selected.is_empty() && !selected.contains(case.id) {
      continue
    }
    let candidate : Invocation = {
      program: "moonrun",
      args: [wasmroot + case.command + "/" + case.command + ".wasm", "--"],
    }
    candidate.args.append(case.args)
    let reference = if mode == "ab" {
      let original : Invocation = {
        program: candidate.program,
        args: [
          args[6].trim_end(chars="/").to_owned() +
          "/" +
          case.command +
          "/" +
          case.command +
          ".wasm",
          "--",
        ],
      }
      original.args.append(case.args)
      original
    } else {
      case.oracle
    }
    let left = root + "/" + case.id + "-wasm"
    let right = root + "/" + case.id + "-upstream"
    let raw : Array[Json] = []
    let cs : Array[Double] = []
    let rs : Array[Double] = []
    let mut passed = true
    for trial in 0..<(trials + 1) {
      let (a, b) = if trial % 2 == 0 {
        let a = measure(candidate, case.input, left)
        let b = measure(reference, case.input, right)
        (a, b)
      } else {
        let b = measure(reference, case.input, right)
        let a = measure(candidate, case.input, left)
        (a, b)
      }
      let mut equivalent = a.status == Some(case.status) &&
        b.status == Some(case.status) &&
        @fs.read_file(left + ".err").binary() == @utf8.encode(case.stderr) &&
        @fs.read_file(right + ".err").binary() == @utf8.encode(case.stderr)
      if equivalent && case.gzip {
        for side in [left, right] {
          let decoded = measure(
            { program: gzip, args: ["-d", "-c"], },
            side + ".out",
            side + ".decoded",
          )
          equivalent = equivalent &&
            decoded.status == Some(0) &&
            equal_files(case.input, side + ".decoded.out")
        }
      } else if equivalent {
        equivalent = equal_files(left + ".out", right + ".out")
      }
      raw.push({
        "trial": trial,
        "warmup": trial == 0,
        "candidate": Json(a),
        "reference": Json(b),
        "equivalent": equivalent,
      })
      if !equivalent {
        passed = false
        break
      }
      if trial > 0 {
        cs.push(a.elapsed_us)
        rs.push(b.elapsed_us)
      }
    }
    let row : Json = {
      "settle_ms": @env.get_env_var("CMD_BENCH_SETTLE_MS").unwrap_or("0"),
      "preload": @env.get_env_var("CMD_BENCH_PRELOAD").unwrap_or("0"),
      "rusage": @env.get_env_var("CMD_BENCH_RUSAGE").unwrap_or("0"),
      "perf": @env.get_env_var("CMD_BENCH_PERF").unwrap_or(""),
      "case": Json(case),
      "candidate_invocation": Json(candidate),
      "reference_invocation": Json(reference),
      "passed": passed,
      "samples": raw,
      "candidate_median_us": if cs.is_empty() {
        Json::null()
      } else {
        Json(median(cs))
      },
      "reference_median_us": if rs.is_empty() {
        Json::null()
      } else {
        Json(median(rs))
      },
      "ratio": if cs.is_empty() {
        Json::null()
      } else {
        Json(median(cs) / median(rs))
      },
    }
    rows.push(row)
    all_passed = all_passed && passed
    @fs.write_file(root + "/report.json", @utf8.encode(Json(rows).stringify()))
    println(row.stringify())
  }
  println("REPORT " + root + "/report.json")
  guard all_passed else {
    fail("one or more exploration rows failed correctness")
  }
}

///|
async fn main {
  let args = @env.args()
  if args.length() > 4 &&
    (args[3] == "ab" || args[3] == "prototype") &&
    (args[4].contains("curl-loopback") || args[4].contains("wget-loopback")) {
    let payload = @fs.read_file(lab + "/text8m").binary()
    @async.with_task_group <| group => {
      let server = @http.Server(@socket.Addr::parse("127.0.0.1:0"))
      group.add_defer(() => server.close())
      group.spawn_bg(no_wait=true) <| () => {
        server.run_forever() <| ((_, _, connection) => {
          connection.send_response(200, "OK", extra_headers={
            "Content-Length": payload.length().to_string(),
          })
          connection..write(payload).end_response()
        })
      }
      loopback_url.val = "http://127.0.0.1:\{server.addr.port()}/fixed"
      run_cases()
    }
  } else {
    run_cases()
  }
}
