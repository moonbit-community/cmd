----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/bench",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}
----

///|
let lab : String = @env.args().get(1).unwrap_or("")

///|
let cases : Array[Case] = []

///|
fn add(
  id : String,
  command : String,
  argv : Array[String],
  input : String,
  oracle : String,
  status~ : Int32 = 0,
  compressed~ : Bool = false,
) -> Unit {
  cases.push({
    id,
    command,
    args: argv,
    input: lab + "/" + input,
    oracle: { program: oracle, args: argv, },
    status,
    gzip: compressed,
  })
}

///|
struct Invocation {
  program : String
  args : Array[String]
} derive(ToJson)

///|
struct Case {
  id : String
  command : String
  args : Array[String]
  input : String
  oracle : Invocation
  status : Int32
  gzip : Bool
} derive(ToJson)

///|
struct Sample {
  elapsed_us : Double
  status : Int32?
  stdout_bytes : Int64
} derive(ToJson)

///|
async fn measure(
  invocation : Invocation,
  input : String,
  prefix : String,
) -> Sample {
  let output = @process.redirect_to_file(prefix + ".out")
  defer output.close()
  let errors = @process.redirect_to_file(prefix + ".err")
  defer errors.close()
  let stdin = @process.redirect_from_file(input)
  let start = @bench.monotonic_clock_start()
  let status = @async.with_timeout_opt(20000, () => {
    @process.run(
      invocation.program,
      invocation.args,
      stdin~,
      stdout=output,
      stderr=errors,
      extra_env=Map([
        ("LC_ALL", "C"),
        ("LANG", "C"),
        ("TZ", "UTC"),
        ("RIPGREP_CONFIG_PATH", ""),
      ]),
      cancel_handler=@process.hard_cancel(),
    )
  })
  let elapsed_us = @bench.monotonic_clock_end(start)
  { elapsed_us, status, stdout_bytes: @fs.file_size(prefix + ".out"), }
}

///|
async fn equal_files(a : String, b : String) -> Bool {
  let left = @fs.open(a, mode=ReadOnly)
  defer left.close()
  let right = @fs.open(b, mode=ReadOnly)
  defer right.close()
  let size = left.size()
  if size != right.size() {
    return false
  }
  let mut offset = 0L
  while offset < size {
    let count = (size - offset).min(65536L).to_int()
    if left.read_exactly_at(count, position=offset) !=
      right.read_exactly_at(count, position=offset) {
      return false
    }
    offset += count.to_int64()
  }
  true
}

///|
fn median(samples : Array[Double]) -> Double {
  let sorted = samples.copy()
  sorted.sort()
  let middle = sorted.length() / 2
  if sorted.length() % 2 == 0 {
    (sorted[middle - 1] + sorted[middle]) / 2.0
  } else {
    sorted[middle]
  }
}

///|
async fn corpus(
  name : String,
  size : Int32,
  record : Int32,
  json : Bool,
  entropy~ : Bool = false,
) -> Unit {
  let file = @fs.create(lab + "/" + name)
  defer file.close()
  let json_line = b"{\"id\":123,\"name\":\"alpha\",\"active\":true}\n"
  let seed = b"alpha beta gamma 0123456789 delta omega "
  let mut offset = 0
  let mut random = 123456789U
  while offset < size {
    let count = (size - offset).min(65536)
    let chunk = FixedArray::make(count, b'\x00')
    for index in 0..<count {
      let pos = offset + index
      let column = pos % record
      chunk[index] = if entropy {
        random = random ^ (random << 13)
        random = random ^ (random >> 17)
        random = random ^ (random << 5)
        (random & 255U).to_byte()
      } else if json {
        json_line[pos % json_line.length()]
      } else if column == record - 1 || pos == size - 1 {
        b'\n'
      } else if column < 8 {
        let rank = ((pos / record).to_int64() * 1103515245L + 12345L) %
          100000000L
        let places = [
          10000000L, 1000000L, 100000L, 10000L, 1000L, 100L, 10L, 1L,
        ]
        ((rank / places[column] % 10L).to_int() + 48).to_byte()
      } else {
        seed[(column - 8) % seed.length()]
      }
    }
    file.write(chunk.unsafe_reinterpret_as_bytes())
    offset += count
  }
}

///|
async fn main {
  let args = @env.args()
  guard args.length() >= 6 else {
    fail(
      "Usage: explore.mbtx LAB WASM_CLI_ROOT prepare|prototype|ab|ci CASE_IDS PAIRS [BASELINE_CLI_ROOT|ORACLE_BIN]",
    )
  }
  let mode = args[3]
  guard mode == "prepare" || mode == "prototype" || mode == "ab" || mode == "ci" else {
    fail("invalid mode")
  }
  if mode == "ab" && args.length() != 7 {
    fail("ab requires a baseline root")
  }
  if mode == "ci" && args.length() != 7 {
    fail("ci requires an exported oracle bin directory")
  }
  if mode == "prepare" {
    @fs.write_file(lab + "/empty", b"")
    @fs.write_file(lab + "/overlap8k", Bytes::make(8192, b'a') + b"\n")
    @fs.write_file(lab + "/overlap16k", Bytes::make(16384, b'a') + b"\n")
    corpus("text8m", 8388608, 80, false)
    corpus("text64m", 67108864, 80, false)
    corpus("long8m", 8388608, 1048576, false)
    corpus("long64m", 67108864, 1048576, false)
    corpus("text1m", 1048576, 80, false)
    corpus("entropy8m", 8388608, 80, false, entropy=true)
    corpus(
      "json1m",
      b"{\"id\":123,\"name\":\"alpha\",\"active\":true}\n".length() * 25000,
      40,
      true,
    )
    let tiny = @fs.create(lab + "/tiny8m")
    defer tiny.close()
    let repeated = @fs.create(lab + "/repeat8m")
    defer repeated.close()
    let block = Bytes::makei(65536, index => {
      if index % 2 == 1 {
        b'\n'
      } else if index % 4 == 0 {
        b'a'
      } else {
        b'b'
      }
    })
    let same = Bytes::makei(65536, index => {
      if index % 64 == 63 {
        b'\n'
      } else {
        b'x'
      }
    })
    for _ in 0..<128 {
      tiny.write(block)
      repeated.write(same)
    }
    println("corpora prepared")
    return
  }
  let cu = if mode == "ci" { args[6].trim_end(chars="/").to_owned() + "/" } else { lab + "/oracles/coreutils-9.11/src/" }
  let gnugrep = if mode == "ci" { cu + "grep" } else { lab + "/oracles/grep-3.12/src/grep" }
  let gzip = if mode == "ci" { cu + "gzip" } else { lab + "/oracles/gzip-1.14/gzip" }
  let wasmroot = args[2].trim_end(chars="/").to_owned() + "/"
  add("true-empty", "true", [], "empty", cu + "true")
  add("cat-64m", "cat", [], "text64m", cu + "cat")
  add("wc-l-64m", "wc", ["-l"], "text64m", cu + "wc")
  add("wc-c-64m", "wc", ["-c"], "text64m", cu + "wc")
  add("wc-w-64m", "wc", ["-w"], "text64m", cu + "wc")
  add("base64-8m", "base64", ["-w0"], "text8m", cu + "base64")
  add("base32-8m", "base32", ["-w0"], "text8m", cu + "base32")
  add("sort-8m", "sort", [], "text8m", cu + "sort")
  add("sort-n-8m", "sort", ["-n"], "text8m", cu + "sort")
  add("sha256-8m", "sha256sum", [], "text8m", cu + "sha256sum")
  add("sha512-8m", "sha512sum", [], "text8m", cu + "sha512sum")
  add("cut-8m", "cut", ["-b", "1-8"], "text8m", cu + "cut")
  add("tr-8m", "tr", ["a-z", "A-Z"], "text8m", cu + "tr")
  add("uniq-8m", "uniq", [], "text8m", cu + "uniq")
  add("grep-fixed-8m", "grep", ["-F", "-c", "alpha"], "text8m", gnugrep)
  add("grep-fixed-64m", "grep", ["-F", "-c", "alpha"], "text64m", gnugrep)
  let needles = ["absent0", "absent1", "absent2", "absent3", "absent4", "absent5", "absent6", "absent7", "absent8", "absent9", "absent10", "absent11", "absent12", "absent13", "absent14", "gamma"]
  let many_count = ["-F", "-c"]
  let many_span = ["-F", "-o"]
  let many_miss = ["-F", "-c"]
  for needle in needles {
    many_count.append(["-e", needle])
    many_span.append(["-e", needle])
    many_miss.append(["-e", if needle == "gamma" { "absent15" } else { needle }])
  }
  add("grep-many-count-8m", "grep", many_count, "text8m", gnugrep)
  add("grep-many-count-64m", "grep", many_count, "text64m", gnugrep)
  add("grep-many-span-1m", "grep", many_span, "text1m", gnugrep)
  add("grep-many-miss-8m", "grep", many_miss, "text8m", gnugrep, status=1)
  for (name, patterns, status) in [
    ("short", ["a", "be", "ga", "0"], 0),
    ("dense", ["alpha", "beta", "gamma", "012"], 0),
    ("distributed", ["zebra", "jungle", "quartz", "violet", "window", "xenon", "yellow", "kernel", "orange", "purple", "socket", "tensor", "umber", "vector", "walrus", "yonder"], 1),
  ] {
    let options = ["-F", "-c"]
    for pattern in patterns { options.append(["-e", pattern]) }
    add("grep-set-" + name + "-64m", "grep", options, "text64m", gnugrep, status~)
  }
  add("grep-overlap-8k", "grep", ["-E", "-o", "a|a.*z"], "overlap8k", gnugrep)
  add("grep-overlap-16k", "grep", ["-E", "-o", "a|a.*z"], "overlap16k", gnugrep)
  add("grep-span-many-1m", "grep", ["-E", "-o", "[a-z]+"], "text1m", gnugrep)
  add("grep-span-literal-1m", "grep", ["-o", "alpha"], "text1m", gnugrep)
  add("grep-span-long-8m", "grep", ["-E", "-o", "[0-9]{4}.*gamma"], "long8m", gnugrep)
  add("grep-span-word-1m", "grep", ["-w", "-E", "-o", "[a-z]+"], "text1m", gnugrep)
  add("grep-span-empty-1m", "grep", ["-E", "-o", "a?"], "text1m", gnugrep)
  add(
    "grep-miss-8m",
    "grep",
    ["-F", "-c", "absent_xyz"],
    "text8m",
    gnugrep,
    status=1,
  )
  add(
    "grep-regex-1m",
    "grep",
    ["-E", "-c", "[0-9]{4}.*gamma"],
    "text1m",
    gnugrep,
  )
  add(
    "rg-fixed-8m",
    "rg",
    ["-F", "-c", "alpha", "-"],
    "text8m",
    lab + "/oracles/bin/rg",
  )
  add(
    "rg-regex-1m",
    "rg",
    ["-c", "[0-9]{4}.*gamma", "-"],
    "text1m",
    lab + "/oracles/bin/rg",
  )
  add("gzip-text-8m", "gzip", ["-n", "-c"], "text8m", gzip, compressed=true)
  add(
    "gzip-entropy-8m",
    "gzip",
    ["-n", "-c"],
    "entropy8m",
    gzip,
    compressed=true,
  )
  add("jq-identity-1m", "jq", ["-c", "."], "json1m", lab + "/oracles/bin/jq")
  add("jq-select-1m", "jq", ["-c", ".id"], "json1m", lab + "/oracles/bin/jq")
  add("cut-fields-8m", "cut", ["-f", "1,3", "-d", " "], "text8m", cu + "cut")
  add("cut-long-8m", "cut", ["-b", "1-8"], "long8m", cu + "cut")
  add("cut-long-64m", "cut", ["-b", "1-8"], "long64m", cu + "cut")
  add("cut-tiny-8m", "cut", ["-b", "1"], "tiny8m", cu + "cut")
  add("uniq-repeated-8m", "uniq", ["-c"], "repeat8m", cu + "uniq")
  add("uniq-long-8m", "uniq", [], "long8m", cu + "uniq")
  add("uniq-tiny-8m", "uniq", [], "tiny8m", cu + "uniq")
  add(
    "grep-regex-64m",
    "grep",
    ["-E", "-c", "[0-9]{4}.*gamma"],
    "text64m",
    gnugrep,
  )
  add(
    "grep-regex-miss-8m",
    "grep",
    ["-E", "-c", "[0-9]{4}.*absent_xyz"],
    "text8m",
    gnugrep,
    status=1,
  )
  add("grep-regex-miss-64m", "grep", ["-E", "-c", "[0-9]{4}.*absent_xyz"], "text64m", gnugrep, status=1)
  add(
    "grep-regex-empty",
    "grep",
    ["-E", "-c", "[0-9]{4}.*gamma"],
    "empty",
    gnugrep,
    status=1,
  )
  add(
    "grep-span-1m",
    "grep",
    ["-E", "-o", "[0-9]{4}.*gamma"],
    "text1m",
    gnugrep,
  )
  add("wc-all-64m", "wc", ["-lwmc", "--total=only"], "text64m", cu + "wc")
  let selected = args[4].split(",").map(x => x.to_owned()).collect()
  let trials = @string.parse_int(args[5])
  guard trials > 0 else { fail("positive pair count required") }
  guard !selected.is_empty() &&
    selected.all(id => cases.any(case => case.id == id)) else {
    fail("unknown or empty case selection")
  }
  let temporary = @fs.tmpdir(prefix="cmd-perf-id-")
  let root = lab +
    "/results/" +
    mode +
    "-" +
    temporary.split("/").last().unwrap().to_owned()
  @fs.remove(temporary)
  @fs.mkdir(root)
  let rows : Array[Json] = []
  let mut all_passed = true
  for case in cases {
    if !selected.is_empty() && !selected.contains(case.id) {
      continue
    }
    let candidate : Invocation = {
      program: "moonrun",
      args: [wasmroot + case.command + "/" + case.command + ".wasm", "--"],
    }
    candidate.args.append(case.args)
    let reference = if mode == "ab" {
      let original : Invocation = {
        program: candidate.program,
        args: [args[6].trim_end(chars="/").to_owned() + "/" + case.command + "/" + case.command + ".wasm", "--"],
      }
      original.args.append(case.args)
      original
    } else {
      case.oracle
    }
    let left = root + "/" + case.id + "-wasm"
    let right = root + "/" + case.id + "-upstream"
    let raw : Array[Json] = []
    let cs : Array[Double] = []
    let rs : Array[Double] = []
    let mut passed = true
    for trial in 0..<(trials + 1) {
      let (a, b) = if trial % 2 == 0 {
        let a = measure(candidate, case.input, left)
        let b = measure(reference, case.input, right)
        (a, b)
      } else {
        let b = measure(reference, case.input, right)
        let a = measure(candidate, case.input, left)
        (a, b)
      }
      let mut equivalent = a.status == Some(case.status) &&
        b.status == Some(case.status) &&
        @fs.file_size(left + ".err") == 0L &&
        @fs.file_size(right + ".err") == 0L
      if equivalent && case.gzip {
        for side in [left, right] {
          let decoded = measure(
            { program: gzip, args: ["-d", "-c"], },
            side + ".out",
            side + ".decoded",
          )
          equivalent = equivalent &&
            decoded.status == Some(0) &&
            equal_files(case.input, side + ".decoded.out")
        }
      } else if equivalent {
        equivalent = equal_files(left + ".out", right + ".out")
      }
      raw.push({
        "trial": trial,
        "warmup": trial == 0,
        "candidate": Json(a),
        "reference": Json(b),
        "equivalent": equivalent,
      })
      if !equivalent {
        passed = false
        break
      }
      if trial > 0 {
        cs.push(a.elapsed_us)
        rs.push(b.elapsed_us)
      }
    }
    let row : Json = {
      "case": Json(case),
      "candidate_invocation": Json(candidate),
      "reference_invocation": Json(reference),
      "passed": passed,
      "samples": raw,
      "candidate_median_us": if cs.is_empty() {
        Json::null()
      } else {
        Json(median(cs))
      },
      "reference_median_us": if rs.is_empty() {
        Json::null()
      } else {
        Json(median(rs))
      },
      "ratio": if cs.is_empty() {
        Json::null()
      } else {
        Json(median(cs) / median(rs))
      },
    }
    rows.push(row)
    all_passed = all_passed && passed
    @fs.write_file(root + "/report.json", @utf8.encode(Json(rows).stringify()))
    println(row.stringify())
  }
  println("REPORT " + root + "/report.json")
  guard all_passed else {
    fail("one or more exploration rows failed correctness")
  }
}
