----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/http",
  "moonbitlang/async@0.22.5/socket",
  "moonbitlang/core/bench",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}
----

///|
let lab : String = @env.args().get(1).unwrap_or("")

///|
let cases : Array[Case] = []

///|
let loopback_url : Ref[String] = Ref("http://127.0.0.1:0/fixed")

///|
fn add(
  id : String,
  command : String,
  argv : Array[String],
  input : String,
  oracle : String,
  status~ : Int32 = 0,
  compressed~ : Bool = false,
  stderr~ : String = "",
) -> Unit {
  cases.push({
    id,
    command,
    args: argv,
    input: lab + "/" + input,
    oracle: { program: oracle, args: argv, },
    status,
    gzip: compressed,
    stderr,
  })
}

///|
struct Invocation {
  program : String
  args : Array[String]
} derive(ToJson)

///|
struct Case {
  id : String
  command : String
  args : Array[String]
  input : String
  oracle : Invocation
  status : Int32
  gzip : Bool
  stderr : String
} derive(ToJson)

///|
struct Sample {
  elapsed_us : Double
  status : Int32?
  stdout_bytes : Int64
  rusage : String?
  perf : String?
} derive(ToJson)

///|
async fn measure(
  invocation : Invocation,
  input : String,
  prefix : String,
) -> Sample {
  // Diagnostic settling is outside the complete child-process interval.
  // The default and acceptance profile retain zero delay.
  let settle = @string.parse_int(
    @env.get_env_var("CMD_BENCH_SETTLE_MS").unwrap_or("0"),
  )
  guard settle >= 0 && settle <= 1000 else {
    fail("invalid diagnostic settling interval")
  }
  if settle > 0 {
    @async.sleep(settle)
  }
  let preload = @env.get_env_var("CMD_BENCH_PRELOAD").unwrap_or("0")
  guard preload == "0" || preload == "1" else {
    fail("invalid preload setting")
  }
  if preload == "1" {
    let file = @fs.open(input, mode=ReadOnly)
    defer file.close()
    let buffer = FixedArray::make(65536, b'\x00')
    while file.read(buffer) > 0 {
      ()
    }
  }
  let rusage = @env.get_env_var("CMD_BENCH_RUSAGE").unwrap_or("0")
  guard rusage == "0" || rusage == "1" else { fail("invalid rusage setting") }
  let perf = @env.get_env_var("CMD_BENCH_PERF").unwrap_or("")
  guard perf.is_empty() || rusage == "0" else {
    fail("counter observers must use separate diagnostic arms")
  }
  let output = @process.redirect_to_file(prefix + ".out")
  defer output.close()
  let errors = @process.redirect_to_file(prefix + ".err")
  defer errors.close()
  let stdin = @process.redirect_from_file(input)
  let start = @bench.monotonic_clock_start()
  let environment = Map([
    ("LC_ALL", "C"),
    ("LANG", "C"),
    ("TZ", "UTC"),
    ("RIPGREP_CONFIG_PATH", ""),
  ])
  let status = if !perf.is_empty() {
    Some(
      @process.run(
        "/usr/bin/timeout",
        [
          "--kill-after=2s",
          "20s",
          perf,
          "stat",
          "--null",
          "-o",
          prefix + ".perf",
          "--",
          invocation.program,
          ..invocation.args,
        ],
        stdin~,
        stdout=output,
        stderr=errors,
        extra_env=environment,
      ),
    )
  } else if rusage == "1" {
    // GNU timeout owns a process group, so its deadline covers time and the
    // measured descendant. Counter collection is a separate diagnostic arm.
    Some(
      @process.run(
        "/usr/bin/timeout",
        [
          "--kill-after=2s",
          "20s",
          "/usr/bin/time",
          "-f",
          "user_seconds=%U\nsystem_seconds=%S\nvoluntary_switches=%w\ninvoluntary_switches=%c\nminor_faults=%R\nmajor_faults=%F\nmax_rss_kib=%M\nexit=%x",
          "-o",
          prefix + ".rusage",
          invocation.program,
          ..invocation.args,
        ],
        stdin~,
        stdout=output,
        stderr=errors,
        extra_env=environment,
      ),
    )
  } else {
    @async.with_timeout_opt(20000, () => {
      @process.run(
        invocation.program,
        invocation.args,
        stdin~,
        stdout=output,
        stderr=errors,
        extra_env=environment,
        cancel_handler=@process.hard_cancel(),
      )
    })
  }
  let elapsed_us = @bench.monotonic_clock_end(start)
  let perf_report = if perf.is_empty() {
    None
  } else {
    let report = @fs.read_file(prefix + ".perf").text()
    for field in ["seconds time elapsed", "seconds user", "seconds sys"] {
      guard report.contains(field) else {
        fail("incomplete perf accounting: \{field}")
      }
    }
    Some(report)
  }
  {
    elapsed_us,
    status,
    stdout_bytes: @fs.file_size(prefix + ".out"),
    perf: perf_report,
    rusage: if rusage == "1" {
      Some(@fs.read_file(prefix + ".rusage").text())
    } else {
      None
    },
  }
}

///|
async fn equal_files(a : String, b : String) -> Bool {
  let left = @fs.open(a, mode=ReadOnly)
  defer left.close()
  let right = @fs.open(b, mode=ReadOnly)
  defer right.close()
  let size = left.size()
  if size != right.size() {
    return false
  }
  let mut offset = 0L
  while offset < size {
    let count = (size - offset).min(65536L).to_int()
    if left.read_exactly_at(count, position=offset) !=
      right.read_exactly_at(count, position=offset) {
      return false
    }
    offset += count.to_int64()
  }
  true
}

///|
fn median(samples : Array[Double]) -> Double {
  let sorted = samples.copy()
  sorted.sort()
  let middle = sorted.length() / 2
  if sorted.length() % 2 == 0 {
    (sorted[middle - 1] + sorted[middle]) / 2.0
  } else {
    sorted[middle]
  }
}

///|
async fn corpus(
  name : String,
  size : Int32,
  record : Int32,
  json : Bool,
  entropy~ : Bool = false,
) -> Unit {
  let file = @fs.create(lab + "/" + name)
  defer file.close()
  let json_line = b"{\"id\":123,\"name\":\"alpha\",\"active\":true}\n"
  let seed = b"alpha beta gamma 0123456789 delta omega "
  let mut offset = 0
  let mut random = 123456789U
  while offset < size {
    let count = (size - offset).min(65536)
    let chunk = FixedArray::make(count, b'\x00')
    for index in 0..<count {
      let pos = offset + index
      let column = pos % record
      chunk[index] = if entropy {
        random = random ^ (random << 13)
        random = random ^ (random >> 17)
        random = random ^ (random << 5)
        (random & 255U).to_byte()
      } else if json {
        json_line[pos % json_line.length()]
      } else if column == record - 1 || pos == size - 1 {
        b'\n'
      } else if column < 8 {
        let rank = ((pos / record).to_int64() * 1103515245L + 12345L) %
          100000000L
        let places = [
          10000000L, 1000000L, 100000L, 10000L, 1000L, 100L, 10L, 1L,
        ]
        ((rank / places[column] % 10L).to_int() + 48).to_byte()
      } else {
        seed[(column - 8) % seed.length()]
      }
    }
    file.write(chunk.unsafe_reinterpret_as_bytes())
    offset += count
  }
}

///|
fn adaptive_patterns(marker : Int32, length~ : Int32 = 32) -> Array[Bytes] {
  Array::makei(16, number => {
    Bytes::makei(length, index => {
      if index == marker {
        (98 + number).to_byte()
      } else {
        b'a'
      }
    })
  })
}

///|
async fn adaptive_corpora() -> Unit {
  for (name, size) in [("64k", 65536), ("256k", 262144), ("1m", 1048576)] {
    @fs.write_file(lab + "/collision-" + name, Bytes::make(size, b'a') + b"\n")
  }
  let sparse = Bytes::make(1048575, b'Z') + b"\n"
  @fs.write_file(lab + "/sparse-1m", sparse)
  let large = @fs.create(lab + "/sparse-64m")
  defer large.close()
  let mixed = @fs.create(lab + "/mixed-64m")
  defer mixed.close()
  mixed.write(Bytes::make(8192, b'a') + b"\n")
  for _ in 0..<64 {
    large.write(sparse)
    mixed.write(sparse)
  }
  let dense = @fs.create(lab + "/dense-literals-1m")
  defer dense.close()
  let patterns = adaptive_patterns(28)
  for index in 0..<32768 {
    dense.write(patterns[index % patterns.length()] + b"\n")
  }
}

///|
async fn boolean_count_corpora() -> Unit {
  let prefix = b"0001 gamma\n".repeat(16)
  let block = prefix + Bytes::make(262144 - prefix.length() - 1, b'x') + b"\n"
  @fs.write_file(lab + "/count-density-shift8m", block.repeat(32))
  @fs.write_file(lab + "/count-false-positive", b"xxxx gamma gamma gamma\n".repeat(350000))
  @fs.write_file(lab + "/count-sparse", (b"0001 gamma\n" + b"miss\n".repeat(8192)).repeat(200))
  @fs.write_file(lab + "/count-repetition", b"xx abababz xx\nzz baztail\nmiss\n".repeat(250000))
  @fs.write_file(lab + "/count-unicode", @utf8.encode("πσ12345 x\nα99999 π\nmiss\n").repeat(250000))
  @fs.write_file(lab + "/count-budget", b"ababababbaba\n".repeat(500000))
  @fs.write_file(lab + "/count-long8m", b"0001" + Bytes::make(8 * 1048576, b'x') + b"gamma")
}

///|
async fn boolean_long_corpora() -> Unit {
  cache_pressure_corpus()
  @fs.write_file(lab + "/pilot-late-prefix-hit", b"xxxx gamma gamma\n".repeat(524288) + b"0001 gamma\n")
  @fs.write_file(lab + "/pilot-short-prefix", b"1 gamma\n".repeat(1048576))
  @fs.write_file(lab + "/pilot-long-output-hit", b"0001" + Bytes::make(8388608, b'x') + b"Q\nmiss\nZZ\n")
  let alphabet = b"xQZY0123"
  let bytes = FixedArray::make(8388608, b'x')
  let mut random = 104729U
  for i in 0..<bytes.length() {
    random = random ^ (random << 13)
    random = random ^ (random >> 17)
    random = random ^ (random << 5)
    bytes[i] = alphabet[(random & 7U).reinterpret_as_int()]
  }
  let frequent = b"0001" + Bytes::from_array(bytes)
  @fs.write_file(lab + "/pilot-frequent-exits", frequent)
  @fs.write_file(lab + "/pilot-frequent-exits-hit", frequent + b"QXYZ123")
  @fs.write_file(lab + "/min-constructor-long", Bytes::make(8388608, b'a') + b"Q")
  @fs.write_file(lab + "/min-constructor-alternation", b"ababababbaba".repeat(699050))
  @fs.write_file(lab + "/min-broad-frequent", (Bytes::make(40, b'a') + b"c").repeat(204600))
  @fs.write_file(lab + "/min-broad-sparse", (Bytes::make(4096, b'a') + b"c").repeat(2047))
  for (name, period, offset) in [
    ("stream-phase-16", 4097, 16),
    ("stream-phase-4095", 4097, 4095),
    ("stream-period-513", 513, 7),
    ("stream-period-1009", 1009, 21),
  ] {
    @fs.write_file(lab + "/" + name, Bytes::makei(8388608, i =>
      if (i + offset) % period == period - 1 { b'c' } else { b'a' }))
  }
}

///|
async fn cache_pressure_corpus() -> Unit {
  let path = lab + "/cache-pressure"
  guard !@fs.exists(path) else { fail("cache pressure fixture already exists; preserve it") }
  let bytes = FixedArray::make(8 * 32769, b'a')
  let mut random = 104729U
  for i in 0..<bytes.length() {
    random = random ^ (random << 13)
    random = random ^ (random >> 17)
    random = random ^ (random << 5)
    bytes[i] = if i % 32769 == 32768 { b'\n' } else if (random & 1U) == 0U { b'a' } else { b'b' }
  }
  @fs.write_file(path, Bytes::from_array(bytes))
}

///|
async fn growth_corpora() -> Unit {
  let seed = b"0123456789 alpha beta gamma "
  for
    (name, size, terminated) in [
      ("growth8m", 8388608, true),
      ("growth20m", 20971520, true),
      ("growth32m", 33554432, true),
      ("growth64m", 67108864, true),
      ("growth-tail8m", 8388608, false),
    ] {
    @fs.write_file(
      lab + "/" + name,
      Bytes::makei(size, i => {
        if terminated && i + 1 == size {
          b'\n'
        } else {
          seed[i % seed.length()]
        }
      }),
    )
  }
}

///|
async fn run_cases() -> Unit {
  let args = @env.args()
  guard args.length() >= 6 else {
    fail(
      "Usage: explore.mbtx LAB WASM_CLI_ROOT prepare|prepare-growth|prepare-architecture|prepare-cache-pressure|profiles|prototype|ab|ci CASE_IDS PAIRS [BASELINE_CLI_ROOT|ORACLE_BIN]",
    )
  }
  let mode = args[3]
  guard mode == "prepare" ||
    mode == "prepare-growth" ||
    mode == "prepare-architecture" ||
    mode == "prepare-cache-pressure" ||
    mode == "profiles" ||
    mode == "prototype" ||
    mode == "ab" ||
    mode == "ci" else {
    fail("invalid mode")
  }
  if mode == "ab" && args.length() != 7 {
    fail("ab requires a baseline root")
  }
  if mode == "ci" && args.length() != 7 {
    fail("ci requires an exported oracle bin directory")
  }
  if mode == "prepare-cache-pressure" {
    cache_pressure_corpus()
    return
  }
  if mode == "prepare-growth" {
    growth_corpora()
    return
  }
  if mode == "prepare-architecture" {
    let makefile = lab + "/make-control.mk"
    let compressed = lab + "/text8m.gz"
    guard !@fs.exists(makefile) && !@fs.exists(compressed) else {
      fail("architecture fixtures already exist; preserve them")
    }
    @fs.write_file(
      makefile, ".PHONY: all\nall:\n\t@i=0; while test \"$$i\" -lt 5000; do i=$$((i+1)); if test \"$$i\" -eq 2500; then continue; fi; :; done; printf '%s\\n' \"$$i\"\n",
    )
    let output = @process.redirect_to_file(compressed)
    defer output.close()
    let input = @process.redirect_from_file(lab + "/text8m")
    guard @process.run(
        "moonrun",
        [args[2] + "/gzip/gzip.wasm", "--", "-n", "-c"],
        stdin=input,
        stdout=output,
      ) ==
      0 else {
      fail("baseline gzip fixture generation failed")
    }
    return
  }
  if mode == "prepare" {
    @fs.mkdir(lab, recursive=true, allow_exist=true)
    @fs.mkdir(lab + "/results", allow_exist=true)
    growth_corpora()
    adaptive_corpora()
    boolean_count_corpora()
    boolean_long_corpora()
    @fs.write_file(lab + "/empty", b"")
    @fs.write_file(lab + "/overlap8k", Bytes::make(8192, b'a') + b"\n")
    @fs.write_file(lab + "/overlap16k", Bytes::make(16384, b'a') + b"\n")
    corpus("text8m", 8388608, 80, false)
    corpus("text64m", 67108864, 80, false)
    corpus("long8m", 8388608, 1048576, false)
    corpus("long64m", 67108864, 1048576, false)
    corpus("text1m", 1048576, 80, false)
    corpus("entropy8m", 8388608, 80, false, entropy=true)
    let entropy = @fs.read_file(lab + "/entropy8m").binary()
    @fs.write_file(
      lab + "/ascii-entropy8m",
      Bytes::makei(entropy.length(), index => {
        if index % 80 == 79 {
          b'\n'
        } else {
          (97 + entropy[index].to_int() % 26).to_byte()
        }
      }),
    )
    @fs.write_file(
      lab + "/ascii-entropy-long8m",
      Bytes::makei(entropy.length(), index => {
        if index % 1048576 == 1048575 {
          b'\n'
        } else {
          (97 + entropy[index].to_int() % 26).to_byte()
        }
      }),
    )
    @fs.write_file(
      lab + "/tiny1m",
      Bytes::makei(1048576, index => {
        if index % 2 == 1 {
          b'\n'
        } else if index % 4 == 0 {
          b'a'
        } else {
          b'b'
        }
      }),
    )
    @fs.write_file(
      lab + "/column-cache-cap8m",
      Bytes::makei(8388608, i => {
        if i % 4096 == 4095 {
          b'\n'
        } else if i % 1024 == 1023 {
          b':'
        } else {
          b'x'
        }
      }),
    )
    @fs.write_file(
      lab + "/column-dense-fields1m",
      Bytes::makei(1048576, i => {
        if i % 2048 == 2047 {
          b'\n'
        } else if i % 2 == 1 {
          b':'
        } else {
          b'a'
        }
      }),
    )
    let tail_fields = @fs.create(lab + "/field-tail8m")
    defer tail_fields.close()
    let field_record = b"a|" + Bytes::make(1048571, b'x') + b"|z\n"
    for _ in 0..<8 {
      tail_fields.write(field_record)
    }
    corpus(
      "json1m",
      b"{\"id\":123,\"name\":\"alpha\",\"active\":true}\n".length() * 25000,
      40,
      true,
    )
    let tiny = @fs.create(lab + "/tiny8m")
    defer tiny.close()
    let repeated = @fs.create(lab + "/repeat8m")
    defer repeated.close()
    let block = Bytes::makei(65536, index => {
      if index % 2 == 1 {
        b'\n'
      } else if index % 4 == 0 {
        b'a'
      } else {
        b'b'
      }
    })
    let same = Bytes::makei(65536, index => {
      if index % 64 == 63 {
        b'\n'
      } else {
        b'x'
      }
    })
    for _ in 0..<128 {
      tiny.write(block)
      repeated.write(same)
    }
    let ordered = StringBuilder()
    for index in 0..<100000 {
      let digits = index.to_string()
      ordered.write_string(
        "0".repeat(6 - digits.length()) + digits + " value value\n",
      )
    }
    @fs.write_file(lab + "/ordered", ordered.to_string())
    @fs.mkdir(lab + "/tree", allow_exist=false)
    for index in 0..<512 {
      let directory = lab + "/tree/" + (index / 32).to_string()
      @fs.mkdir(directory, allow_exist=true)
      @fs.write_file(
        directory + "/" + index.to_string() + ".txt",
        b"alpha\nbeta\n",
      )
    }
    @fs.write_file(lab + "/tree/.ignore", "7\n*.log\n")
    println("corpora prepared")
    return
  }
  let cu = if mode == "ci" {
    args[6].trim_end(chars="/").to_owned() + "/"
  } else {
    lab + "/oracles/coreutils-9.11/src/"
  }
  add(
    "ln-symbolic-validation",
    "ln",
    ["-s"],
    "empty",
    "unused",
    status=1,
    stderr="ln: missing operand\n",
  )
  let gnugrep = if mode == "ci" {
    cu + "grep"
  } else {
    lab + "/oracles/grep-3.12/src/grep"
  }
  let gzip = if mode == "ci" {
    cu + "gzip"
  } else {
    lab + "/oracles/gzip-1.14/gzip"
  }
  let wasmroot = args[2].trim_end(chars="/").to_owned() + "/"
  for (family, marker) in [("shared", 28), ("diverse", 0)] {
    let options = ["-F", "-c"]
    for pattern in adaptive_patterns(marker) {
      options.append(["-e", @utf8.decode(pattern)])
    }
    for size in ["64k", "256k", "1m"] {
      add(
        "grep-adaptive-" + family + "-collision-" + size,
        "grep",
        options,
        "collision-" + size,
        gnugrep,
        status=1,
      )
    }
    for size in ["1m", "64m"] {
      add(
        "grep-adaptive-" + family + "-sparse-" + size,
        "grep",
        options,
        "sparse-" + size,
        gnugrep,
        status=1,
      )
    }
    if family == "diverse" {
      add(
        "grep-adaptive-mixed-64m",
        "grep",
        options,
        "mixed-64m",
        gnugrep,
        status=1,
      )
    } else {
      add(
        "grep-adaptive-dense-1m", "grep", options, "dense-literals-1m", gnugrep,
      )
    }
  }
  let budget_options = ["-F", "-c"]
  for pattern in adaptive_patterns(0, length=256) {
    budget_options.append(["-e", @utf8.decode(pattern)])
  }
  add(
    "grep-adaptive-budget-64k",
    "grep",
    budget_options,
    "collision-64k",
    gnugrep,
    status=1,
  )
  add("rg-output-sparse-8m", "rg", ["^0", "-"], "text8m", "unused")
  for (name, input, options, status) in [
    ("long8", "growth8m", ["-a","-c","[0-9]{4}.*Q|ZZ"], 1),
    ("long20", "growth20m", ["-a","-c","[0-9]{4}.*Q|ZZ"], 1),
    ("long32", "growth32m", ["-a","-c","[0-9]{4}.*Q|ZZ"], 1),
    ("long64", "growth64m", ["-a","-c","[0-9]{4}.*Q|ZZ"], 1),
    ("dense64", "text64m", ["-a","-c","[0-9]{4}.*gamma"], 0),
    ("miss64", "text64m", ["-a","-c","[0-9]{4}.*absent_xyz"], 1),
    ("chain", "min-constructor-long", ["-a","-c","[ab]{32}Q"], 0),
    ("frequent", "min-broad-frequent", ["-a","-c","[ab]{32}Q"], 1),
    ("sparse", "min-broad-sparse", ["-a","-c","[ab]{32}Q"], 1),
    ("empty", "empty", ["-a","-c","[0-9]{4}.*Q|ZZ"], 1),
    ("phase-16", "stream-phase-16", ["-a","-c","[ab]{32}Q"], 1),
    ("phase-4095", "stream-phase-4095", ["-a","-c","[ab]{32}Q"], 1),
    ("period-513", "stream-period-513", ["-a","-c","[ab]{32}Q"], 1),
    ("period-1009", "stream-period-1009", ["-a","-c","[ab]{32}Q"], 1),
  ] {
    add("rg-stream-"+name, "rg", [..options,"-"], input, "unused", status~)
  }
  for (name, input, options, status) in [
    ("repeat", "text8m", ["-E","^[0-9]+alpha"], 0),
    ("repeat-count", "text8m", ["-E","-c","^[0-9]+alpha"], 0),
    ("branch", "text8m", ["-E","^([0-4][0-9]*|[5-9][0-9]*)alpha"], 0),
    ("false-positive", "text8m", ["-E","^[a-z]+alpha"], 1),
    ("ambiguous", "text1m", ["-E","^([0-9]|[0-9][0-9])*alpha"], 0),
    ("end", "text8m", ["-E","^[0-9]+alpha beta gamma [0-9]+ delta omega alpha beta gamma [0-9]+ del$"], 0),
    ("empty", "empty", ["-E","^[0-9]+alpha"], 1),
    ("only", "text1m", ["-E","-o","^[0-9]+alpha"], 0),
