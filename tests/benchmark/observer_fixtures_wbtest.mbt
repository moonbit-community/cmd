// Bounded generated bytes exercise test-tool observers only; timing admits real sources.

///|
async fn write_observer_input(path : String, size : Int32) -> Unit {
  let file = @fs.create(path)
  defer file.close()
  let chunk = Bytes::makei(65536, index => {
    if index % 64 == 63 {
      b'\n'
    } else {
      (97 + index % 26).to_byte()
    }
  })
  for _ in 0..<(size / 65536) {
    file.write(chunk)
  }
  if size % 65536 != 0 {
    file.write(chunk[:size % 65536].to_owned())
  }
}

///|
// These bounded whitebox fixtures validate decoded bytes independently.
// This buffering helper is excluded from real-source timing execution.
async fn gzip_roundtrip(
  compressed : String,
  expected : String,
  decoded : String,
) -> Bool {
  let output = @fs.open(decoded, mode=WriteOnly, create_mode=CreateOrTruncate)
  defer output.close()
  let trailing = @gzipops.decode(
    @fs.read_file(compressed).binary(),
    output,
    false,
  )
  !trailing && files_equal(decoded, expected)
}
