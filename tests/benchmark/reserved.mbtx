----
import {
  "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process", "moonbitlang/core/env",
  "moonbitlang/core/json", "moonbitlang/x@0.5.5/crypto",
}
----

fn field(value : Json,key : String) -> Json {match value {Object(fields)=>fields.get(key).unwrap_or(Json::null());_=>Json::null()}}
fn text(value : Json) -> String raise {guard value is String(text) else{fail("expected string")};text}
fn rows(value : Json) -> Array[Json] raise {guard value is Array(rows) else{fail("expected array")};rows}
fn valid_sha256(value : String) -> Bool {
  value.length()==64 && value.iter().all(c=>(c>='0' && c<='9') || (c>='a' && c<='f'))
}
fn disclosed_sources(value : Json) -> Array[Json] raise {
  guard field(value,"schema")==Json(1) && field(value,"retention")==Json("append-only") && field(value,"classification")==Json("ordinary-after-disclosure") else {fail("invalid disclosed-source inventory schema or classification")}
  let sources=rows(field(value,"sources"))
  guard !sources.is_empty() else {fail("disclosed-source inventory must retain its historical identities")}
  let seen : Set[String]=Set([])
  for source in sources {
    let sha=text(field(source,"sha256"))
    guard valid_sha256(sha) && !seen.contains(sha) else {fail("invalid or duplicate disclosed source SHA-256")}
    seen.add(sha)
    guard field(source,"split")==Json("ordinary") && field(source,"classification")==Json("ordinary-after-disclosure") else {fail("disclosed source has a stale reserved/holdout classification")}
    for key in ["path","provider","url","provenance","license"] {guard !text(field(source,key)).trim().is_empty() else {fail("incomplete disclosed source provenance: "+key)}}
    let bytes : Int64=@json.from_json(field(source,"bytes"))
    let disclosure=field(source,"disclosure")
    let observed : Int64=@json.from_json(field(disclosure,"observed_at_ms"))
    guard bytes>0L && observed>0L && field(disclosure,"kind")==Json("reserved-evaluation") && [Json("failed"),Json("passed"),Json("started-not-adjudicated")].contains(field(disclosure,"outcome")) else {fail("invalid disclosed evaluation provenance")}
    for key in ["candidate_sha256","selection_sha256","manifest_sha256","evidence_sha256"] {guard valid_sha256(text(field(disclosure,key))) else {fail("invalid disclosed evaluation identity: "+key)}}
  }
  for sha in ["a33695f21dff308ba3e900244a083450331d8aa215a641f612eb218e49b272d9","57194e43b001b8f832987b21b82953d997aeeaebeb53a8520140bc12d7d8cfcc","2af5abf98554af1599e516f31f7f1698085e6faa12b816401f569c097b9f7ef6"] {guard sources.any(source=>field(source,"sha256")==Json(sha) && field(field(source,"disclosure"),"outcome")==Json("failed") && field(field(source,"disclosure"),"evidence_sha256")==Json("647ccca2d8014ba7c00dd4ac20f04a0434150814275770ac7f7bcc2a615edfe3")) else {fail("disclosed-source inventory lost or relabeled an original failed evaluation identity")}}
  sources
}
async fn verify_committed_history(sources : Array[Json]) -> Unit {
  let path="tests/fixtures/benchmark/disclosed-sources.json"
  let committed=@process.collect_output("git",["show","HEAD:"+path],extra_env=Map([("LC_ALL","C")]))
  if committed.0==0 {
    let previous=disclosed_sources(@json.parse(committed.1.text()))
    guard sources.length()>=previous.length() && sources[:previous.length()]==previous[:] else {fail("disclosed-source ledger rewrites or removes committed history")}
  }else{
    guard committed.0==128 && committed.2.text().contains("exists on disk, but not in 'HEAD'") else {fail("cannot establish committed disclosed-source history")}
  }
}
fn known_sources(candidate : Json) -> Set[String] raise {
  let known : Set[String]=Set([])
  for value in rows(field(candidate,"seen_sha256")) {
    let sha=text(value)
    guard valid_sha256(sha) && !known.contains(sha) else {fail("invalid or duplicate frozen known-source identity")}
    known.add(sha)
  }
  guard !known.is_empty() else {fail("missing frozen known-source inventory")}
  known
}
fn selected_source_identities(known : Set[String],selection : Json) -> Set[String] raise {
  let selected : Set[String]=Set([])
  for source in rows(field(selection,"sources")) {
    let sha=text(field(source,"sha256"))
    guard valid_sha256(sha) && !known.contains(sha) && !selected.contains(sha) else {fail("reserved source overlaps previously observed data or duplicates selection")}
    selected.add(sha)
  }
  guard !selected.is_empty() else {fail("empty reserved source selection")}
  selected
}
fn novel_sources(known : Set[String],selection : Json) -> Set[String] raise {
  let selected=selected_source_identities(known,selection)
  for source in rows(field(selection,"sources")) {
    guard (field(source,"split")==Json::null() || field(source,"split")==Json("holdout")) && field(source,"classification")==Json::null() else {fail("reserved selection has a stale ordinary classification")}
  }
  selected
}
async fn hash(path : String) -> String {
  guard @fs.kind(path) is Regular else {fail("identity requires a regular file: "+path)}
  let input=@fs.open(path,mode=ReadOnly)
  defer input.close()
  let digest=@crypto.SHA256::new()
  let buffer=FixedArray::make(65536,b'\x00')
  let bytes=buffer.unsafe_reinterpret_as_bytes()
  while input.read(buffer) is count && count>0 {digest.update(bytes[:count])}
  @crypto.bytes_to_hex_string(digest.finalize())
}
async fn verify_disclosure_inventory(candidate : Json,root : String) -> Set[String] {
  let inventory=field(candidate,"disclosure_inventory")
  let path="tests/fixtures/benchmark/disclosed-sources.json"
  guard field(inventory,"path")==Json(path) && field(inventory,"snapshot_path")==Json("disclosed-sources.json") else {fail("candidate does not bind the durable disclosed-source inventory; refreeze before reservation")}
  let expected=text(field(inventory,"sha256"))
  guard valid_sha256(expected) else {fail("invalid frozen disclosure inventory identity")}
  assert_eq(hash(path),expected,msg="disclosed-source inventory changed after freeze; refreeze before reservation")
  assert_eq(hash(root+"/disclosed-sources.json"),expected,msg="frozen disclosure inventory is missing or changed")
  let current=disclosed_sources(@json.parse(@fs.read_file(path).text()))
  verify_committed_history(current)
  let frozen=rows(field(inventory,"sources"))
  assert_eq(current,frozen,msg="frozen disclosure entries do not bind the observed ledger")
  let known=known_sources(candidate)
  for source in frozen {guard known.contains(text(field(source,"sha256"))) else {fail("frozen known-source union omits a disclosed identity")}}
  known
}

///|
async fn verify_bound_sources(known : Set[String]) -> Unit {
  for path in ["tests/fixtures/benchmark/rg-real-inputs.json","tests/fixtures/benchmark/natural-sources.json","tests/benchmark/natural.json","tests/fixtures/benchmark/real-sources.json"] {
    let data=@json.parse(@fs.read_file(path).text())
    let records=match data {Array(items)=>items;{"files":Array(items),..}=>items;{"workloads":Array(items),..}=>items;_=>abort("invalid observed source inventory")}
    for item in records {
      let value=match item {{"sha256":String(sha),..}=>Some(sha);{"source":{"sha256":String(sha),..},..}=>Some(sha);_=>None}
      if value is Some(sha) {guard valid_sha256(sha) && known.contains(sha) else {fail("frozen known-source union omits a bound source identity: "+path)}}
    }
  }
}
async fn write_new(path : String,value : Json) -> Unit {
  @fs.write_file(path,value.stringify(indent=2)+"\n",create_mode=CreateNew,sync=Full)
}
async fn record_disclosure(ledger_path : String,selection_path : String,evidence_path : String,receipt_path : String) -> Unit {
  // The caller chooses when to reconcile an intent or completed receipt. A
  // failed/uncertain evaluation still declassifies its source bytes forever.
  for path in [receipt_path,receipt_path+".before.json",receipt_path+".prepared.json"] {guard !@fs.exists(path) else {fail("preserve existing disclosure update evidence: "+path)}}
  guard @fs.kind(ledger_path,follow_symlink=false) is Regular else {fail("disclosure append requires a regular inventory file, not a symlink")}
  let lock=ledger_path+".lock"
  @fs.mkdir(lock,allow_exist=false)
  let mut mutation_started=false
  let mut complete=false
  defer {if !mutation_started || complete {@fs.rmdir(lock)}}
  let before_sha=hash(ledger_path)
  let ledger=@json.parse(@fs.read_file(ledger_path).text())
  let previous=disclosed_sources(ledger)
  verify_committed_history(previous)
  let selection_sha=hash(selection_path)
  let evidence_sha=hash(evidence_path)
  let selection=@json.parse(@fs.read_file(selection_path).text())
  let evidence=@json.parse(@fs.read_file(evidence_path).text())
  guard field(selection,"schema")==Json(1) && field(selection,"complete_original_files")==Json(true) && field(evidence,"schema")==Json(1) && field(evidence,"candidate_sha256")==field(selection,"candidate_sha256") && field(evidence,"manifest_sha256")==field(selection,"manifest_sha256") && field(evidence,"selection_sha256")==Json(selection_sha) else {fail("disclosure evidence must bind the exact complete-source selection and candidate")}
  let observed : Int64=@json.from_json(field(evidence,"evaluation_started_at_ms"))
  let selected : Int64=@json.from_json(field(selection,"selected_at_ms"))
  guard observed>=selected && observed>0L && observed<=@async.now() else {fail("invalid disclosure observation time")}
  let outcome=if field(evidence,"phase")==Json("evaluation-started") && field(evidence,"passed")==Json::null() {"started-not-adjudicated"} else {
    guard [Json(true),Json(false)].contains(field(evidence,"passed")) else {fail("disclosure evidence requires an explicit result or a write-ahead intent")}
    let completed : Int64=@json.from_json(field(evidence,"completed_at_ms"))
    guard completed>=observed && completed<=@async.now() else {fail("invalid completed disclosure time")}
    if field(evidence,"passed")==Json(true) {guard field(evidence,"exit_status")==Json(0) else {fail("passing disclosure receipt has a nonzero exit")};"passed"}else{"failed"}
  }
  let known : Set[String]=Set([])
  for source in previous {known.add(text(field(source,"sha256")))}
  let selected_sources=rows(field(selection,"sources"))
  let _=selected_source_identities(known,selection)
  let appended=previous.copy()
  for source in selected_sources {
    guard source is Object(fields) else {fail("invalid selected source object")}
    let fields=fields.copy()
    fields["split"]=Json("ordinary")
    fields["classification"]=Json("ordinary-after-disclosure")
    fields["disclosure"]={"kind":"reserved-evaluation","observed_at_ms":observed,"candidate_sha256":field(selection,"candidate_sha256"),"selection_sha256":selection_sha,"manifest_sha256":field(selection,"manifest_sha256"),"evidence_sha256":evidence_sha,"outcome":outcome,"scope":"Disclosed after a reserved evaluation attempt; ordinary for every later candidate, regardless of evaluation outcome"}
    appended.push(Json(fields))
  }
  guard ledger is Object(fields) else {fail("invalid disclosure inventory")}
  let fields=fields.copy();fields["sources"]=Json(appended)
  let next=Json(fields)
  let validated=disclosed_sources(next)
  guard validated.length()==previous.length()+selected_sources.length() && validated[:previous.length()]==previous[:] else {fail("disclosure update must preserve the complete existing prefix")}
  let temporary=ledger_path+".pending-"+selection_sha
  guard !@fs.exists(temporary) else {fail("preserve pending disclosure update; inspect before retrying")}
  assert_eq(hash(ledger_path),before_sha,msg="disclosure inventory changed while preparing append")
  assert_eq(hash(selection_path),selection_sha);assert_eq(hash(evidence_path),evidence_sha)
  @fs.write_file(receipt_path+".before.json",@fs.read_file(ledger_path).binary(),create_mode=CreateNew,sync=Full)
  write_new(temporary,next)
  let after_sha=hash(temporary)
  let receipt : Json={"schema":1,"operation":"append-disclosed-sources","ledger":ledger_path,"before_sha256":before_sha,"after_sha256":after_sha,"selection_sha256":selection_sha,"evidence_sha256":evidence_sha,"outcome":outcome,"added_sources":selected_sources.length(),"total_sources":validated.length(),"historical_prefix_preserved":true,"classification":"ordinary-after-disclosure"}
  write_new(receipt_path+".prepared.json",receipt)
  assert_eq(hash(ledger_path),before_sha,msg="disclosure inventory changed before append replacement")
  mutation_started=true
  @fs.rename(temporary,ledger_path)
  assert_eq(hash(ledger_path),after_sha,msg="disclosure append readback failed; inspect prepared receipt before retrying")
  write_new(receipt_path,receipt)
  complete=true
  println("Appended disclosed identities without changing historical entries: "+receipt_path)
}
async fn verify_candidate(candidate : Json,root : String,benchmark : String,runtime : String) -> Unit {
  let source_rows=rows(field(candidate,"source_files"))
  let artifact_rows=rows(field(candidate,"artifacts"))
  guard field(candidate,"schema")==Json(1) && !source_rows.is_empty() && artifact_rows.length()==80 else {fail("incomplete candidate snapshot schema/source/artifact inventory")}
  let listed=@process.collect_output("git",["ls-files","--cached","--others","--exclude-standard","-z","core","commands"])
  assert_eq(listed.0,0)
  let current=listed.1.text().split("\u0000").filter(path=>!path.is_empty()).map(path=>path.to_owned()).to_array()
  let frozen : Array[String]=[]
  for item in source_rows {frozen.push(text(rows(item)[0]))}
  current.sort();frozen.sort()
  assert_eq(current,frozen,msg="live product inventory changed after candidate freeze")
  let commands : Set[String]=Set([])
  for artifact in artifact_rows {
    let command=text(field(artifact,"command"))
    guard !commands.contains(command) && field(artifact,"path")==Json("cli/"+command+"/"+command+".wasm") else {fail("duplicate or unexpected candidate artifact identity")}
    commands.add(command)
  }
  let _=verify_disclosure_inventory(candidate,root)
  let policy_paths : Set[String]=Set([])
  for item in rows(field(candidate,"policy_files")) {let path=text(rows(item)[0]);guard !policy_paths.contains(path) else {fail("duplicate frozen policy identity")};policy_paths.add(path)}
  assert_eq(policy_paths,Set(["tests/benchmark/reservation-policy.json","tests/benchmark/mode-definitions.json","tests/benchmark/real.json","tests/benchmark/real-coverage.json","tests/benchmark/reserved.mbtx","tests/benchmark/freeze_candidate.mbtx","tests/fixtures/benchmark/disclosed-sources.json","tests/fixtures/benchmark/rg-real-inputs.json","tests/fixtures/benchmark/natural-sources.json","tests/benchmark/natural.json","tests/fixtures/benchmark/real-sources.json"]))
  verify_bound_sources(known_sources(candidate))
  for item in rows(field(candidate,"source_files")) {
    let pair=rows(item)
    assert_eq(hash(text(pair[0])),text(pair[1]),msg="live product changed after reservation freeze")
    assert_eq(hash(root+"/source/"+text(pair[0])),text(pair[1]))
  }
  for item in rows(field(candidate,"artifacts")) {assert_eq(hash(root+"/wasm/"+text(field(item,"path"))),text(field(item,"sha256")))}
  for item in rows(field(candidate,"policy_files")) {
    let pair=rows(item)
    assert_eq(hash(text(pair[0])),text(pair[1]),msg="selection policy changed after freeze")
  }
  assert_eq(hash(benchmark),text(field(candidate,"benchmark_sha256")))
  assert_eq(hash(runtime),text(field(candidate,"moonrun_sha256")))
}
async fn main {
  let args=@env.args()[1:]
  match args {
    ["--check-known-inventories",root] => {let candidate=@json.parse(@fs.read_file(root+"/candidate.json").text());let known=verify_disclosure_inventory(candidate,root);verify_bound_sources(known);println("All declared observed source identities remain in the frozen union");return}
    ["--check-ledger",path] => {let sources=disclosed_sources(@json.parse(@fs.read_file(path).text()));verify_committed_history(sources);println("Valid append-only disclosed-source inventory: "+sources.length().to_string()+" identities");return}
    ["--check-novelty",root,selection] => {let candidate=@json.parse(@fs.read_file(root+"/candidate.json").text());let known=verify_disclosure_inventory(candidate,root);let selected=novel_sources(known,@json.parse(@fs.read_file(selection).text()));println("Novel reserved source identities: "+selected.length().to_string());return}
    ["--record-disclosure",ledger,selection,evidence,receipt] => {record_disclosure(ledger,selection,evidence,receipt);return}
    _ => ()
  }
  let options : Map[String,String]=Map([])
  for i=0;i<args.length();i=i+2 {guard i+1<args.length() && !options.contains(args[i]) else {fail("reserved requires distinct KEY VALUE arguments")};options[args[i]]=args[i+1]}
  for key in ["--snapshot","--selection","--manifest","--corpus-root","--benchmark","--moonrun","--oracle-bin","--report-dir"] {guard options.contains(key) else {fail("missing "+key)}}
  let root=options["--snapshot"]
  let candidate_path=root+"/candidate.json"
  let candidate=@json.parse(@fs.read_file(candidate_path).text())
  let selection=@json.parse(@fs.read_file(options["--selection"]).text())
  let selection_sha=hash(options["--selection"])
  let frozen : Int64=@json.from_json(field(candidate,"frozen_at_ms"))
  let selected : Int64=@json.from_json(field(selection,"selected_at_ms"))
  guard selected>frozen && field(selection,"candidate_sha256")==Json(hash(candidate_path)) && field(selection,"independent_selector")==Json(true) else {fail("source selection must independently follow and bind the actual candidate freeze")}
  assert_eq(hash(options["--manifest"]),text(field(selection,"manifest_sha256")))
  verify_candidate(candidate,root,options["--benchmark"],options["--moonrun"])
  let manifest=@json.parse(@fs.read_file(options["--manifest"]).text())
  let tasks=rows(field(manifest,"workloads"))
  let commands : Set[String]=Set([])
  let sources : Set[String]=Set([])
  let known=known_sources(candidate)
  let selected_sources=rows(field(selection,"sources"))
  let _=novel_sources(known,selection)
  guard tasks.length()>=12 && selected_sources.length()>=3 else {fail("reserved evaluation requires12 tasks and3 complete files")}
  let policy=@json.parse(@fs.read_file("tests/benchmark/reservation-policy.json").text())
  let allowed=rows(field(field(policy,"selection"),"allowed_commands"))
  let allowed_modes : Array[Json]=[]
  for path in ["tests/benchmark/mode-definitions.json","tests/benchmark/real.json"] {allowed_modes.append(rows(field(@json.parse(@fs.read_file(path).text()),"workloads")))}
  let providers : Set[String]=Set([])
  for source in selected_sources {
    let sha=text(field(source,"sha256"))
    guard !known.contains(sha) && !sources.contains(sha) else {fail("reserved source overlaps previously observed data or duplicates selection")}
    sources.add(sha)
    let provider=text(field(source,"provider"))
    guard !provider.trim().is_empty() else {fail("reserved source requires its provider")}
    providers.add(provider)
    guard @fs.file_size(options["--corpus-root"]+"/"+text(field(source,"path")))<=16777216L else {fail("reserved source exceeds policy size")}
    assert_eq(hash(options["--corpus-root"]+"/"+text(field(source,"path"))),sha)
  }
  guard providers.length()>=2 else {fail("reserved sources require two independent providers")}
  let used : Set[String]=Set([])
  for task in tasks {
    let command=text(field(task,"command"))
    guard allowed.contains(Json(command)) else {fail("unregistered reserved command")}
    guard allowed_modes.any(mode=>field(mode,"command")==Json(command) && field(mode,"recipe")==field(task,"recipe")) else {fail("unregistered reserved command mode")}
    commands.add(command)
    let inputs=[field(task,"source")]
    if field(task,"other_source")!=Json::null() {inputs.push(field(task,"other_source"))}
    for source in inputs {
      guard field(source,"split")==Json("holdout") && sources.contains(text(field(source,"sha256"))) && selected_sources.any(item=>field(item,"path")==field(source,"path") && field(item,"sha256")==field(source,"sha256")) else {fail("task input does not bind the reserved complete-source identity")}
      used.add(text(field(source,"sha256")))
    }
  }
  assert_eq(used,sources,msg="every independently selected source must be exercised")
  guard commands.length()>=8 else {fail("reserved selection needs eight commands")}
  let output=options["--report-dir"]
  guard !@fs.exists(output) && !@fs.exists(output+".reservation.json") && !@fs.exists(output+".disclosure-intent.json") else {fail("preserve existing reservation results and disclosure intent")}
  let started=@async.now()
  guard selected<=started else {fail("reservation selection time is in the future")}
  write_new(output+".disclosure-intent.json",{"schema":1,"phase":"evaluation-started","candidate_sha256":field(selection,"candidate_sha256"),"selection_sha256":selection_sha,"manifest_sha256":field(selection,"manifest_sha256"),"evaluation_started_at_ms":started,"after_disclosure":"ordinary evaluation data for every later candidate, including failed or interrupted attempts"})
  let status=@process.run(options["--benchmark"],["baseline","--manifest",options["--manifest"],"--corpus-root",options["--corpus-root"],"--wasm-root",root+"/wasm","--moonrun",options["--moonrun"],"--oracle-bin",options["--oracle-bin"],"--report-dir",output])
  verify_candidate(candidate,root,options["--benchmark"],options["--moonrun"])
  assert_eq(hash(candidate_path),text(field(selection,"candidate_sha256")))
  assert_eq(hash(options["--selection"]),selection_sha)
  assert_eq(hash(options["--manifest"]),text(field(selection,"manifest_sha256")))
  for source in selected_sources {assert_eq(hash(options["--corpus-root"]+"/"+text(field(source,"path"))),text(field(source,"sha256")))}
  let result=@json.parse(@fs.read_file(output+"/report.json").text())
  let passed=status==0 && field(result,"passed")==Json(true) && field(result,"artifact_integrity")==Json(true) && rows(field(result,"rows")).length()==tasks.length()
  write_new(output+".reservation.json",{"schema":1,"passed":passed,"candidate_sha256":field(selection,"candidate_sha256"),"selection_sha256":selection_sha,"manifest_sha256":field(selection,"manifest_sha256"),"selected_at_ms":selected,"frozen_at_ms":frozen,"evaluation_started_at_ms":started,"completed_at_ms":@async.now(),"independent_selection_after_freeze":true,"identities_rechecked":true,"tasks":tasks.length(),"commands":commands.length(),"scope":"fresh reserved correctness for this unchanged candidate only; not general performance, upstream parity or training-data blindness","after_disclosure":"ordinary evaluation data for future candidates","exit_status":status})
  assert_true(passed,msg="reserved evaluation failed; raw results preserved")
}
