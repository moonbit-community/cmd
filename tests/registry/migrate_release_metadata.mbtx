///|
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
}

///|
/// One-time schema migration. Current schema 2 registries never consume the
/// compatibility sidecar; rewriting it cannot alter authoritative policy.
async fn main {
  let result = @shell.Cmd("moon", [
    "run", "tests/registry/cli", "--target", "native", "--", "migrate-release-metadata",
  ]).output()
  if result.exit_code() != 0 {
    println(result.stderr())
    fail(
      "registry migration failed with exit status " +
      result.exit_code().to_string(),
    )
  }
  println(result.stdout())
}
