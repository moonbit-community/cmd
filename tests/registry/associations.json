{
  "schema": 1,
  "rules": [
    {
      "id": "scenario-child-artifacts",
      "kind": "scenario",
      "trigger_commands": [
        "*"
      ],
      "trigger_paths": [
        "tests/network_scenarios/**"
      ],
      "behavior_ids": [
        "scenario:sh-interactive-session",
        "scenario:make-ready-ack",
        "scenario:filesystem-fidelity",
        "scenario:process-lifecycle",
        "scenario:network-auth-cookie",
        "scenario:network-auth-cookie-oracle",
        "scenario:network-transfer-boundaries",
        "scenario:network-transfer-boundaries-oracle",
        "scenario:mv-windows-native-links",
      "scenario:mv-windows-wasm-links-boundary",
      "scenario:diff-directory-devices-boundary"
      ],
      "build_commands": [
        "*"
      ],
      "full": false
    },
    {
      "id": "compatibility-cohorts",
      "kind": "cohort",
      "trigger_commands": [
        "*"
      ],
      "trigger_paths": [
        "tests/runner/cohorts.mbt"
      ],
      "behavior_ids": [
        "cohort:compat-catalog",
        "cohort:compat-environment",
        "cohort:compat-chunks",
        "cohort:compat-process-composition",
        "cohort:compat-sleep-cancellation",
        "cohort:compat-tail-follow",
        "cohort:compat-http",
        "cohort:compat-https",
        "cohort:compat-proxy",
        "cohort:gnu-host",
        "cohort:stress-streams"
      ],
      "build_commands": [
        "*"
      ],
      "full": false
    },
    {
      "id": "capability-policy",
      "kind": "policy",
      "trigger_commands": [
        "*"
      ],
      "trigger_paths": [
        "tests/runner/policy.mbt"
      ],
      "behavior_ids": [
        "policy:policy-host"
      ],
      "build_commands": [
        "*"
      ],
      "full": false
    },
    {
      "id": "catalog-global-invariant",
      "kind": "catalog",
      "trigger_commands": [],
      "trigger_paths": [
        "core/cli/catalog.mbt"
      ],
      "behavior_ids": [
        "cohort:compat-catalog"
      ],
      "build_commands": [
        "*"
      ],
      "full": false
    },
    {
      "id": "shared-fixture-layer",
      "kind": "fixture",
      "trigger_commands": [],
      "trigger_paths": [
        "tests/fixtures/**",
        "tests/fixture/**"
      ],
      "behavior_ids": [],
      "build_commands": [],
      "full": true
    },
    {
      "id": "published-release-association",
      "kind": "release",
      "trigger_commands": [],
      "trigger_paths": [
        "tests/release_runner/current/published.json"
      ],
      "behavior_ids": [
        "cohort:compat-catalog"
      ],
      "build_commands": [
        "*"
      ],
      "full": false
    }
  ]
}
