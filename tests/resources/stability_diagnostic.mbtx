----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
async fn execute(
  program : String,
  args : Array[String],
  log : String,
  env~ : Map[String, String] = Map([]),
) -> Int32 {
  let output = @process.redirect_to_file(log)
  defer output.close()
  @process.run(program, args, extra_env=env, stdout=output, stderr=output)
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 5 else {
    fail(
      "Usage: stability_diagnostic.mbtx REPORT_DIR WASM_CLI_ROOT ORACLE_BIN COMMANDS",
    )
  }
  let root = args[1]
  let phase = @env.get_env_var("CMD_BENCH_DIAGNOSTIC_PHASE").unwrap_or(
    "observer",
  )
  guard phase == "observer" || phase == "cache" || phase == "cpu" else {
    fail("unknown diagnostic phase")
  }
  @fs.mkdir(root, recursive=true, allow_exist=false)
  @fs.mkdir(root + "/results")
  let commands = args[4].split(",").map(value => value.to_owned()).collect()
  let groups = [
    ("cut", ["cut-8m", "cut-tiny-8m", "cut-long-64m", "cut-fields-8m"]),
    ("uniq", ["uniq-8m", "uniq-tiny-8m", "uniq-long-8m", "uniq-repeated-8m"]),
    ("wc", ["wc-l-64m", "wc-w-64m"]),
    (
      "grep",
      [
        "grep-fixed-64m", "grep-many-count-64m", "grep-many-miss-8m", "grep-set-short-64m",
        "grep-set-dense-64m", "grep-set-distributed-64m", "grep-overlap-8k", "grep-overlap-16k",
        "grep-span-long-8m", "grep-span-1m", "grep-span-many-1m", "grep-regex-64m",
        "grep-regex-miss-64m",
      ],
    ),
  ]
  guard args[4].is_empty() ||
    commands.all(command => groups.any(group => group.0 == command)) else {
    fail("unknown diagnostic command")
  }
  let cases : Array[String] = []
  for (command, names) in groups {
    if args[4].is_empty() || commands.contains(command) {
      cases.append(names)
    }
  }
  guard !cases.is_empty() else { fail("empty diagnostic selection") }
  if phase != "observer" {
    cases.append(["true-empty", "grep-regex-empty"])
  }
  let script = "tests/benchmark/explore.mbtx"
  guard execute(
      "moon",
      [
        "run",
        "--target",
        "native",
        "--release",
        script,
        "--",
        root,
        args[2],
        "prepare",
        cases.join(","),
        "9",
      ],
      root + "/prepare.log",
    ) ==
    0 else {
    fail("diagnostic preparation failed")
  }
  // Compile both observers before any timed window. Product Wasm is unchanged.
  for target in ["wasm", "native"] {
    guard execute(
        "moon",
        [
          "run",
          "--build-only",
          "--target",
          target,
          ..if target == "native" {
            ["--release"]
          } else {
            []
          },
          script,
        ],
        root + "/build-" + target + ".log",
      ) ==
      0 else {
      fail("observer build failed")
    }
  }
  let linux = @fs.exists("/proc/self/status")
  let perf = if phase == "cpu" {
    guard linux else { fail("CPU accounting requires Linux perf") }
    let candidates = []
    for name in @fs.readdir("/usr/lib/linux-tools", sort=true) {
      let path = "/usr/lib/linux-tools/" + name + "/perf"
      if @fs.exists(path) {
        candidates.push(path)
      }
    }
    guard !candidates.is_empty() else { fail("missing Linux perf executable") }
    let path = candidates[candidates.length() - 1]
    guard execute(path, ["version"], root + "/perf-version.txt") == 0 else {
      fail("perf version check failed")
    }
    guard execute(
        "/usr/bin/timeout",
        [
          "--kill-after=2s",
          "20s",
          path,
          "stat",
          "--null",
          "-o",
          root + "/perf-preflight.txt",
          "--",
          args[3] + "/true",
        ],
        root + "/perf-preflight.log",
        env=Map([("LC_ALL", "C"), ("LANG", "C")]),
      ) ==
      0 else {
      fail("perf accounting preflight failed")
    }
    let report = @fs.read_file(root + "/perf-preflight.txt").text()
    for field in ["seconds time elapsed", "seconds user", "seconds sys"] {
      guard report.contains(field) else {
        fail("missing perf accounting field")
      }
    }
    path
  } else {
    ""
  }
  if linux {
    ignore(execute("lscpu", [], root + "/lscpu.txt"))
    @fs.write_file(
      root + "/observer-status.txt",
      @fs.read_file("/proc/self/status").binary(),
    )
  }
  let cpu = if linux {
    let status = @fs.read_file("/proc/self/status").text()
    let lists = status
      .split("\n")
      .filter_map(line => {
        if line.has_prefix("Cpus_allowed_list:") {
          Some(line[18:].trim().to_owned())
        } else {
          None
        }
      })
      .collect()
    guard lists.length() == 1 else { fail("missing CPU affinity") }
    lists[0].split(",").next().unwrap().split("-").next().unwrap().to_owned()
  } else {
    ""
  }
  let variants : Array[(String, String, String, Bool, Bool, Bool)] = if phase ==
    "observer" {
    [
      ("wasm-observer", "wasm", "0", false, false, false),
      ("native-observer", "native", "0", false, false, false),
      ("native-settle-100ms", "native", "100", false, false, false),
    ]
  } else if phase == "cache" {
    [
      ("native-control", "native", "0", false, false, false),
      ("native-preload", "native", "0", false, true, false),
    ]
  } else {
    [
      ("native-control", "native", "0", false, false, false),
      ("native-perf", "native", "0", false, false, false),
    ]
  }
  if linux && phase == "observer" {
    variants.push(("native-one-cpu", "native", "0", true, false, false))
  }
  if linux && phase == "cache" {
    variants.push(("native-rusage", "native", "0", false, false, true))
  }
  let plan : Json = {
    "scope": "Controlled diagnostic, never resource or stability acceptance; all raw samples retained without retry or removal",
    "cases": cases,
    "phase": phase,
    "perf": perf,
    "rounds": 2,
    "measured_pairs_per_window": 9,
    "single_cpu": cpu,
    "variants": variants,
  }
  @fs.write_file(root + "/plan.json", plan.stringify(indent=2))
  let runs : Array[Json] = []
  let mut failures = 0
  for round in 0..<2 {
    // Reverse variant order in the second window to expose temporal drift.
    for step in 0..<variants.length() {
      let index = if round == 0 { step } else { variants.length() - step - 1 }
      let (name, target, settle, pinned, preload, rusage) = variants[index]
      let log = root + "/" + name + "-" + round.to_string() + ".log"
      if linux {
        @fs.write_file(
          log + ".stat-before",
          @fs.read_file("/proc/stat").binary(),
        )
        @fs.write_file(
          log + ".pressure-before",
          @fs.read_file("/proc/pressure/cpu").binary(),
        )
      }
      let launch = [
        "run",
        "--target",
        target,
        ..if target == "native" {
          ["--release"]
        } else {
          []
        },
        script,
        "--",
        root,
        args[2],
        "ci",
        cases.join(","),
        "9",
        args[3],
      ]
      let status = execute(
        if pinned {
          "taskset"
        } else {
          "moon"
        },
        if pinned {
          ["-c", cpu, "moon", ..launch]
        } else {
          launch
        },
        log,
        env=Map([
          ("CMD_SYNTHETIC_DIAGNOSTIC", "1"),
          ("CMD_BENCH_SETTLE_MS", settle),
          ("CMD_BENCH_PRELOAD", if preload { "1" } else { "0" }),
          ("CMD_BENCH_RUSAGE", if rusage { "1" } else { "0" }),
          ("CMD_BENCH_PERF", if name == "native-perf" { perf } else { "" }),
        ]),
      )
      if linux {
        @fs.write_file(
          log + ".stat-after",
          @fs.read_file("/proc/stat").binary(),
        )
        @fs.write_file(
          log + ".pressure-after",
          @fs.read_file("/proc/pressure/cpu").binary(),
        )
      }
      let paths = @fs.read_file(log)
        .text()
        .split("\n")
        .filter_map(line => {
          if line.has_prefix("REPORT ") {
            Some(line[7:].to_owned())
          } else {
            None
          }
        })
        .collect()
      let complete = if status == 0 && paths.length() == 1 {
        match @json.parse(@fs.read_file(paths[0]).text()) {
          Array(rows) => rows.length() == cases.length()
          _ => false
        }
      } else {
        false
      }
      if !complete {
        failures += 1
      }
      runs.push({
        "variant": name,
        "round": round,
        "status": status,
        "complete": complete,
        "reports": paths,
      })
      @fs.write_file(root + "/runs.json", Json(runs).stringify(indent=2))
      println("diagnostic \{name} window=\{round} complete=\{complete}")
    }
  }
  guard failures == 0 else {
    fail("incomplete diagnostic windows: \{failures}")
  }
}
