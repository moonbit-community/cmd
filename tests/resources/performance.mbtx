----
import {
  "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process", "moonbitlang/core/env",
  "moonbitlang/core/json", "moonbitlang/x@0.5.5/path",
}
----

///|
fn field(value : Json,name : String) -> Json {match value {Object(fields)=>fields.get(name).unwrap_or(Json::null());_=>Json::null()}}

///|
async fn capture(program : String,args : Array[String],log : String) -> Int32 {
  let output=@process.redirect_to_file(log);defer output.close()
  @process.run(program,args,stdout=output,stderr=output)
}

///|
async fn run_checked(args : Array[String],log : String) -> Unit {
  guard capture("moon",args,log)==0 else {fail("performance preparation failed; retained log: "+log)}
}

///|
async fn main {
  let args=@env.args()
  guard args.length()==5 else {fail("Usage: performance.mbtx REPORT_DIR WASM_CLI_ROOT ORACLE_BIN COMMANDS")}
  guard !(@async.platform is Windows) else {fail("real-corpus timing requires the Linux or macOS Native benchmark and correctness driver")}
  for key in ["CMD_BENCH_SETTLE_MS","CMD_BENCH_PRELOAD","CMD_BENCH_RUSAGE","CMD_BENCH_PERF"] {
    let value=@env.get_env_var(key).unwrap_or("")
    guard value=="" || (key!="CMD_BENCH_PERF" && value=="0") else {fail("real-corpus timing rejects diagnostic observer/preload setting: "+key)}
  }
  let corpus=@env.get_env_var("CMD_BENCH_CORPUS_ROOT").unwrap_or("")
  guard !corpus.is_empty() else {fail("CMD_BENCH_CORPUS_ROOT is required; prepare complete pinned real sources before timing")}
  let corpus=@fs.realpath(corpus);let wasm=@fs.realpath(args[2]);let oracle=@fs.realpath(args[3])
  let root=@path.Path(args[1]).resolve().to_string()
  @fs.mkdir(root,recursive=true,allow_exist=false)
  @fs.write_file(root+"/verdict.json",({"passed":false,"stage":"preparation","general_performance_acceptance":false,"upstream_parity":false} : Json).stringify(indent=2)+"\n")
  run_checked(["run","tests/architecture.mbtx","--",root+"/architecture.json"],root+"/architecture.log")
  for package in ["tests/benchmark","tests/runner"] {
    run_checked(["build","--target","native","--release","--deny-warn",package],root+"/build-"+(if package=="tests/benchmark" {"benchmark"}else{"runner"})+".log")
  }
  let manifest=@fs.realpath("tests/benchmark/real.json")
  guard field(@json.parse(@fs.read_file(manifest).text()),"schema")==Json(3) else {fail("performance requires real.json schema3")}
  let benchmark=@fs.realpath("_build/native/release/build/mooxCLI/cmd-tests/benchmark/benchmark.exe")
  let driver=@fs.realpath("_build/native/release/build/mooxCLI/cmd-tests/runner/runner.exe")
  let located=@process.collect_output("which",["moonrun"]);guard located.0==0 else {fail("moonrun is required")}
  let runtime=@fs.realpath(located.1.text().trim())
  let actual=["panels","--manifest",manifest,"--wasm-root",wasm,"--moonrun",runtime,"--correctness-driver",driver,"--oracle-bin",oracle,"--corpus-root",corpus,"--report-dir",root+"/panels"]
  if !args[4].is_empty() {actual.append(["--commands",args[4]])}
  let status=capture(benchmark,actual,root+"/panels.log") catch {error=>{@fs.write_file(root+"/panels-error.txt",error.to_string());-999}}
  let report=if @fs.exists(root+"/panels/panels.json") {@json.parse(@fs.read_file(root+"/panels/panels.json").text())}else{Json::null()}
  let required : Int=@json.from_json(field(report,"required_workloads")) catch {_=>0}
  let passed=status==0 && field(report,"schema")==Json(3) && field(report,"passed")==Json(true) && field(report,"complete")==Json(true) && field(report,"artifact_integrity")==Json(true) && field(report,"windows")==Json(2) && required>0
  @fs.write_file(root+"/verdict.json",({"passed":passed,"stage":"complete","panels_exit_status":status,"panels_report":root+"/panels/panels.json","required_workloads":required,"selected_commands":args[4],"scope":"one selected real-corpus suite with independent local contracts before two windows of nine measured pairs; no command-specific or generated timing stage","general_performance_acceptance":false,"upstream_parity":false,"blind_holdout":false} : Json).stringify(indent=2)+"\n")
  guard passed else {fail("real-corpus performance windows failed; retained panels and diagnostics: "+root)}
}
