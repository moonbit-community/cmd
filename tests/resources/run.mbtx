----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/bench",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
// Direct-child observations; no benchmark statistics or coverage claims.
struct Observation {
  status : Int32
  elapsed_us : Double
  first_output_us : Double?
  kernel_peak_rss_bytes : Int64?
  sampled_rss_bytes : Int64
  sampled_temp_bytes : Int64
  sampled_temp_allocated_bytes : Int64
  sampled_temp_files : Int32
  residual_temp_files : Int32
  residual_temp_entries : Int32
  residual_temp_bytes : Int64
  output_bytes : Int64
  timed_out : Bool
} derive(ToJson)

///|
struct Samples {
  mut first : Double?
  mut rss : Int64
  mut temp : Int64
  mut allocated : Int64
  mut files : Int32
  mut complete : Bool
}

///|
async fn tree_size(path : String) -> (Int64, Int32) {
  let mut bytes = 0L
  let mut files = 0
  for name in @fs.readdir(path) {
    let child = path + "/" + name
    match @fs.kind(child, follow_symlink=false) {
      Directory => {
        let (size, count) = tree_size(child)
        bytes += size
        files += count
      }
      Regular => {
        bytes += @fs.file_size(child)
        files += 1
      }
      _ => ()
    }
  }
  (bytes, files)
}

///|
fn first_number(text : String) -> Int64? {
  guard text.split("\n").next() is Some(line) else { return None }
  guard line.split("\t").next() is Some(value) else { return None }
  Some(@string.parse_int64(value.trim())) catch {
    _ => None
  }
}

///|
async fn observe(
  program : String,
  args : Array[String],
  input : String,
  directory : String,
  timeout : Int32,
  kernel~ : Bool = false,
) -> Observation {
  if kernel {
    return observe_kernel(program, args, input, directory)
  }
  @fs.mkdir(directory)
  let effects = directory + "/effects"
  let temporary = directory + "/temporary"
  @fs.mkdir(effects)
  @fs.mkdir(temporary)
  let capture = @fs.create(directory + "/stdout")
  defer capture.close()
  let errors = @process.redirect_to_file(directory + "/stderr")
  defer errors.close()
  let stdin = @process.redirect_from_file(input)
  let (reader, output) = @process.read_from_process()
  defer reader.close()
  let samples : Samples = {
    first: None,
    rss: 0L,
    temp: 0L,
    allocated: 0L,
    files: 0,
    complete: false,
  }
  let started = @bench.monotonic_clock_start()
  let elapsed = Ref(0.0)
  let status = @async.with_timeout_opt(timeout, () => {
    @async.with_task_group() <| group => {
      let child = @process.spawn(
        group,
        program,
        args,
        stdin~,
        stdout=output,
        stderr=errors,
        cwd=effects[:],
        extra_env=Map([
          ("LC_ALL", "C"),
          ("LANG", "C"),
          ("TZ", "UTC"),
          ("TMPDIR", temporary + "/"),
          ("TMP", temporary),
          ("TEMP", temporary),
        ]),
        cancel_handler=@process.hard_cancel(),
      )
      let consume = group.spawn(() => {
        while reader.read_some(max_len=65536) is Some(bytes) {
          if samples.first is None {
            samples.first = Some(@bench.monotonic_clock_end(started))
          }
          capture.write(bytes)
        }
      })
      let sample = group.spawn(() => {
        while !samples.complete {
          let rss = @shell.Cmd("/bin/ps", [
            "-o",
            "rss=",
            "-p",
            child.pid.to_string(),
          ]).output()
          if rss.exit_code() == 0 && first_number(rss.stdout()) is Some(value) {
            samples.rss = samples.rss.max(value * 1024)
          }
          let sizes = tree_size(temporary) catch { _ => (0L, 0) }
          samples.temp = samples.temp.max(sizes.0)
          samples.files = samples.files.max(sizes.1)
          let allocated = @shell.Cmd("/usr/bin/du", ["-sk", temporary]).output()
          if allocated.exit_code() == 0 &&
            first_number(allocated.stdout()) is Some(value) {
            samples.allocated = samples.allocated.max(value * 1024)
          }
          if samples.first is None && tree_size(effects).0 > 0L {
            samples.first = Some(@bench.monotonic_clock_end(started))
          }
          @async.sleep(100)
        }
      })
      let status = child.wait()
      consume.wait()
      elapsed.val = @bench.monotonic_clock_end(started)
      samples.complete = true
      sample.wait()
      status
    }
  })
  let elapsed_us = if status is None {
    @bench.monotonic_clock_end(started)
  } else {
    elapsed.val
  }
  let residual = tree_size(temporary)
  {
    status: status.unwrap_or(-999),
    elapsed_us,
    first_output_us: samples.first,
    kernel_peak_rss_bytes: None,
    sampled_rss_bytes: samples.rss,
    sampled_temp_bytes: samples.temp,
    sampled_temp_allocated_bytes: samples.allocated,
    sampled_temp_files: samples.files,
    residual_temp_files: residual.1,
    residual_temp_entries: @fs.readdir(temporary).length(),
    residual_temp_bytes: residual.0,
    output_bytes: @fs.file_size(directory + "/stdout"),
    timed_out: status is None,
  }
}

///|
async fn observe_kernel(
  program : String,
  args : Array[String],
  input : String,
  directory : String,
) -> Observation {
  @fs.mkdir(directory)
  let effects = directory + "/effects"
  let temporary = directory + "/temporary"
  @fs.mkdir(effects)
  @fs.mkdir(temporary)
  let started = @bench.monotonic_clock_start()
  // Known completed profiles only: the CI step owns the overall deadline.
  let status = @shell.Cmd(
    "/usr/bin/time",
    ["-q", "-f", "%M", "-o", directory + "/rusage.txt", "--", program, ..args],
    cwd=effects,
    env=Map([
      ("LC_ALL", "C"),
      ("LANG", "C"),
      ("TZ", "UTC"),
      ("TMPDIR", temporary + "/"),
      ("TMP", temporary),
      ("TEMP", temporary),
    ]),
    stdin=FromFile(input),
    stdout=ToFile(directory + "/stdout"),
    stderr=ToFile(directory + "/stderr"),
  ).status()
  let elapsed_us = @bench.monotonic_clock_end(started)
  let rss = @string.parse_int64(
    @fs.read_file(directory + "/rusage.txt").text().trim(),
  )
  let residual = tree_size(temporary)
  {
    status,
    elapsed_us,
    first_output_us: None,
    kernel_peak_rss_bytes: Some(rss * 1024L),
    sampled_rss_bytes: 0L,
    sampled_temp_bytes: 0L,
    sampled_temp_allocated_bytes: 0L,
    sampled_temp_files: 0,
    residual_temp_files: residual.1,
    residual_temp_entries: @fs.readdir(temporary).length(),
    residual_temp_bytes: residual.0,
    output_bytes: @fs.file_size(directory + "/stdout"),
    timed_out: false,
  }
}

///|
async fn write_input(
  path : String,
  size : Int64,
  record : Int64,
  mixed : Bool,
  binary : Bool,
  literal~ : String = "",
) -> Unit {
  let file = @fs.create(path)
  defer file.close()
  let seed = if record == size && !mixed {
    b"needle-alpha-beta-0123456789-"
  } else {
    b"needle alpha beta 0123456789 "
  }
  let widths = [7L, 89L, 4097L, 65537L, 128L]
  let places = [
    1000000000L, 100000000L, 10000000L, 1000000L, 100000L, 10000L, 1000L, 100L, 10L,
    1L,
  ]
  let mut position = 0L
  let mut row = 0L
  let mut rank = 12345L
  let mut column = 0L
  let mut width = if mixed { widths[0] } else { record }
  while position < size {
    let count = (size - position).min(65536).to_int()
    let bytes = Bytes::makei(count, index => {
      let at = position + index.to_int64()
      let end = column == width - 1 || at == size - 1
      let byte = if end {
        b'\n'
      } else if !literal.is_empty() {
        if literal == "literal-sparse" {
          b'Z'
        } else {
          b'a'
        }
      } else if binary && row % 3 == 1 && column == 13 {
        b'\x00'
      } else if binary && row % 3 == 1 && column == 31 {
        b'\xff'
      } else if column < 10 {
        ((rank / places[column.to_int()] % 10).to_int() + 48).to_byte()
      } else {
        seed[((column - 10) % seed.length().to_int64()).to_int()]
      }
      if end {
        row += 1
        rank = (row * 1103515245L + 12345L) % 1000000007L
        column = 0
        if mixed {
          width = widths[(row % widths.length().to_int64()).to_int()]
        }
      } else {
        column += 1
      }
      byte
    })
    file.write(bytes)
    position += count.to_int64()
  }
}

///|
struct ContentInput {
  bytes : Int64
  rows : Int64
  short_record_bytes : Int64
  mixed : Bool
  section_offsets : Array[Int64]
} derive(ToJson)

///|
fn content_width(row : Int64, mixed : Bool) -> Int64 {
  if !mixed { return 80L }
  let at = row % 259L
  if at < 256L { [32L,64L,96L,128L][((at+row/259L)%4L).to_int()] }
  else if at < 258L { 512L } else { 4096L }
}

///|
fn content_row_offset(row : Int64, mixed : Bool) -> Int64 {
  if !mixed { return row*80L }
  let first = row/259L*259L
  let mut offset = row/259L*25600L
  for index=first; index<row; index=index+1L { offset+=content_width(index,true) }
  offset
}

///|
// The content modes keep the requested byte budget while exercising many
// ordinary records. The mixed cycle assigns 80% of complete-cycle bytes to
// records of at most 128 bytes; it is a public ordered synthetic control.
async fn write_content_input(
  path : String,
  size : Int64,
  mixed : Bool,
  sections : Bool,
) -> ContentInput {
  let output=@fs.create(path)
  defer output.close()
  let places=[1000000000L,100000000L,10000000L,1000000L,100000L,10000L,1000L,100L,10L,1L]
  let alphabet=b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 _-./:=\t"
  let boundaries : Array[Int64]=[]
  let mut offset=0L
  let mut row=0L
  let mut column=0L
  let mut width=content_width(0L,mixed)
  let mut short_bytes=0L
  let mut marked=false
  while offset<size {
    let length=(size-offset).min(65536L).to_int()
    let bytes=Bytes::makei(length,index=>{
      let at=offset+index.to_int64()
      if column==0L {
        marked=sections && row%4096L==4095L && size-at>=9L
        if marked {boundaries.push(at)}
      }
      let rank=(row*1103515245L+12345L)%1000000007L
      let last=column==width-1L || at==size-1L
      let byte=if last {b'\n'}
      else if marked && column<8L {b"SECTION "[column.to_int()]}
      else if column<10L {((rank/places[column.to_int()]%10L).to_int()+48).to_byte()}
      else {alphabet[(((rank*31L+column*2654435761L+104729L)%1000000007L)%alphabet.length().to_int64()).to_int()]}
      if width<=128L {short_bytes+=1L}
      if last {row+=1L;column=0L;width=content_width(row,mixed)}
      else {column+=1L}
      byte
    })
    output.write(bytes)
    offset+=length.to_int64()
  }
  {bytes:size,rows:row,short_record_bytes:short_bytes,mixed,section_offsets:boundaries}
}

///|
async fn resource_sha256(path : String) -> String {
  let input=@fs.open(path,mode=ReadOnly)
  defer input.close()
  let hash=@crypto.SHA256::new()
  let buffer=FixedArray::make(65536,b'\x00')
  let bytes=buffer.unsafe_reinterpret_as_bytes()
  while input.read(buffer) is length && length>0 {hash.update(bytes[:length])}
  @crypto.bytes_to_hex_string(hash.finalize())
}

///|
async fn copy_content_range(source : @fs.File, output : @fs.File, start : Int64, end : Int64) -> Unit {
  guard start>=0L && end>=start && end<=source.size() else {fail("invalid resource content range")}
  let mut offset=start
  while offset<end {
    let length=(end-offset).min(65536L).to_int()
    output.write(source.read_exactly_at(length,position=offset))
    offset+=length.to_int64()
  }
}

///|
struct ContentEdit {
  at : Int64
  remove_bytes : Int64
  insert : Bytes
}

///|
async fn write_content_diff(source_path : String, changed : String, features : ContentInput, regime : String) -> Json {
  guard features.rows>=12L else {fail("resource diff content modes need at least twelve records")}
  let source=@fs.open(source_path,mode=ReadOnly)
  defer source.close()
  let output=@fs.create(changed)
  defer output.close()
  let edits : Array[ContentEdit]=[]
  if regime=="sparse-interior-insert-delete" {
    let insert_at=content_row_offset(features.rows/3L,features.mixed)
    let delete_row=features.rows*2L/3L
    let delete_at=content_row_offset(delete_row,features.mixed)
    let delete_end=content_row_offset(delete_row+2L,features.mixed).min(features.bytes)
    edits.push({at:insert_at,remove_bytes:0L,insert:b"inserted sparse resource record\n"})
    edits.push({at:delete_at,remove_bytes:delete_end-delete_at,insert:b""})
  } else if regime=="distributed-interior-edits" {
    guard features.rows>2050L else {fail("distributed resource diff needs more than 2050 records")}
    let mut event=0L
    for row=2048L; row+2L<features.rows; row=row+4096L {
      let at=content_row_offset(row,features.mixed)
      let remove_bytes=if event%5L==0L {content_row_offset(row+2L,features.mixed)-at} else {1L}
      let insert=if event%5L==0L {b"replacement distributed resource record\n"}
        else if event%3L==0L {b"inserted distributed resource record\nX"} else {b"X"}
      edits.push({at,remove_bytes,insert})
      event+=1L
    }
  } else {
    guard regime=="distinct-equal-content" else {fail("unknown resource diff content regime")}
  }
  let events : Array[Json]=[]
  let mut offset=0L
  for edit in edits {
    guard edit.at>=offset && edit.at>0L && edit.at+edit.remove_bytes<features.bytes else {fail("resource diff edits must be nonoverlapping and interior")}
    copy_content_range(source,output,offset,edit.at)
    output.write(edit.insert)
    offset=edit.at+edit.remove_bytes
    events.push({"source_offset":edit.at.to_string(),"removed_bytes":edit.remove_bytes.to_string(),"inserted_bytes":edit.insert.length()})
  }
  copy_content_range(source,output,offset,features.bytes)
  {
    "regime":regime,"same_file_identity":false,"source_bytes":features.bytes.to_string(),
    "source_rows":features.rows.to_string(),"events":events,
    "input_transport":"distinct-named-regular-files",
    "record_layout":if features.mixed {"mixed-short32/64/96/128/512/4096"} else {"ordinary80"},
  }
}

///|
// Verify every fragment independently against its declared source interval,
// including the nonempty final tail after the last repeated interior marker.
async fn content_fragments_match(source_path : String, effects : String, features : ContentInput) -> Bool {
  let names=@fs.readdir(effects,sort=true)
  if names.length()!=features.section_offsets.length()+1 {return false}
  let source=@fs.open(source_path,mode=ReadOnly)
  defer source.close()
  let mut offset=0L
  for index,name in names {
    let suffix=index.to_string()
    if name!="part-"+"0".repeat((6-suffix.length()).max(0))+suffix {return false}
    let end=if index<features.section_offsets.length() {features.section_offsets[index]} else {features.bytes}
    let fragment=@fs.open(effects+"/"+name,mode=ReadOnly)
    defer fragment.close()
    if fragment.size()!=end-offset || end<=offset {return false}
    let mut position=0L
    while position<end-offset {
      let length=(end-offset-position).min(65536L).to_int()
      if fragment.read_exactly_at(length,position~)!=source.read_exactly_at(length,position=offset+position) {return false}
      position+=length.to_int64()
    }
    offset=end
  }
  offset==features.bytes
}

///|
async fn equal_files(left : String, right : String) -> Bool {
  let a = @fs.open(left, mode=ReadOnly)
  defer a.close()
  let b = @fs.open(right, mode=ReadOnly)
  defer b.close()
  let size = a.size()
  if size != b.size() {
    return false
  }
  let mut position = 0L
  while position < size {
    let length = (size - position).min(65536).to_int()
    if a.read_exactly_at(length, position~) !=
      b.read_exactly_at(length, position~) {
      return false
    }
    position += length.to_int64()
  }
  true
}

///|
async fn legacy_long_fragments_match(source : String, effects : String) -> Bool {
  @fs.readdir(effects, sort=true) == ["part-00", "part-01"] &&
  @fs.file_size(effects + "/part-00") == 0L &&
  equal_files(source, effects + "/part-01")
}

///|
async fn equal_effects(left : String, right : String) -> Bool {
  let a = @fs.readdir(left, sort=true)
  let b = @fs.readdir(right, sort=true)
  if a != b {
    return false
  }
  for name in a {
    if !equal_files(left + "/" + name, right + "/" + name) {
      return false
    }
  }
  true
}

///|
fn arguments(
  command : String,
  input : String,
  changed : String,
  binary : Bool,
) -> Array[String] {
  match command {
    "split" => ["-b", "8M", "-", "part-"]
    "csplit" => ["-s", "-n", "6", "-f", "part-", "-", "/^SECTION /", "{*}"]
    "sort" => ["-S", "4M"]
    "column" => ["-t"]
    "grep" => if binary { ["-a", "-F", "needle"] } else { ["-F", "needle"] }
    "cut" => ["-b", "1-8"]
    "wc" => ["-l"]
    "gzip" => ["-n", "-c"]
    "diff" => ["--label", "left", "--label", "right", "-u", input, changed]
    "strings" => ["-a"]
    _ => []
  }
}

///|
async fn decode(program : String, input : String, output : String) -> Bool {
  let result = @shell.Cmd(
    program,
    ["-d", "-c"],
    stdin=FromFile(input),
    stdout=ToFile(output),
  ).status(timeout_ms=900000)
  result == 0
}

///|
async fn main {
  let options : Map[String, String] = Map([])
  let args = @env.args()[1:]
  for index = 0; index < args.length(); index = index + 2 {
    guard index + 1 < args.length() else { fail("option requires a value") }
    guard [
        "--report-dir", "--wasm-root", "--moonrun", "--oracle-bin", "--commands",
        "--sizes", "--long-record", "--distribution", "--timeout-ms", "--kernel-rss",
      ].contains(args[index]) &&
      !options.contains(args[index]) else {
      fail("unknown or duplicate resource option: " + args[index])
    }
    options[args[index]] = args[index + 1]
  }
  let directory = options.get("--report-dir").unwrap()
  let wasm = @fs.realpath(options.get("--wasm-root").unwrap())
  let moonrun = @fs.realpath(options.get("--moonrun").unwrap())
  let oracle = @fs.realpath(options.get("--oracle-bin").unwrap())
  let commands = options
    .get("--commands")
    .unwrap_or(
      "rev,strings,split,csplit,tac,column,sort,grep,gzip,diff,cut,uniq,wc",
    )
    .split(",")
    .map(value => value.to_owned())
    .collect()
  let seen : Set[String] = Set([])
  for command in commands {
    guard [
        "rev", "strings", "split", "csplit", "tac", "column", "sort", "grep", "gzip",
        "diff", "cut", "uniq", "wc",
      ].contains(command) &&
      !seen.contains(command) else {
      fail("unknown, empty or duplicate resource command: " + command)
    }
    seen.add(command)
  }
  let sizes : Array[Int64] = []
  for
    value in options
    .get("--sizes")
    .unwrap_or("8388608,67108864,536870912")
    .split(",") {
    let size = @string.parse_int64(value)
    guard size > 0 else { fail("resource sizes must be positive") }
    sizes.push(size)
  }
  let long_option = options.get("--long-record").unwrap_or("false")
  guard ["true", "false"].contains(long_option) else {
    fail("--long-record must be true or false")
  }
  let long = long_option == "true"
  let requested_distribution = options.get("--distribution").unwrap_or("ascii")
  let distribution = if requested_distribution == "heldout" { "mixed-synthetic" } else { requested_distribution }
  let literal = distribution.has_prefix("literal-")
  guard [
    "ascii", "mixed-synthetic", "literal-shared", "literal-diverse", "literal-sparse", "literal-budget",
  ].contains(distribution) else {
    fail("unknown resource distribution")
  }
  guard !literal || commands == ["grep"] else {
    fail("literal distributions require grep only")
  }
  let timeout = @string.parse_int(
    options.get("--timeout-ms").unwrap_or("900000"),
  )
  guard timeout > 0 else { fail("resource timeout must be positive") }
  let rss_mode = options.get("--kernel-rss").unwrap_or("sampled")
  guard rss_mode == "sampled" || rss_mode == "linux" else {
    fail("--kernel-rss must be linux")
  }
  let kernel = rss_mode == "linux"
  @fs.mkdir(directory, recursive=true, allow_exist=false)
  let root = @fs.realpath(directory)
  let metadata : Json = {
    "kind": "direct-wasm-resource-observation",
    "sample_interval_ms": if kernel {
      0
    } else {
      100
    },
    "measurement": if kernel {
      "Linux GNU time %M reports kernel ru_maxrss in KiB, converted to bytes; file redirects retain byte/effect comparison; first output and sampled fields are unavailable; observer and time supervisor are outside candidate RSS"
    } else {
      "monotonic stdout first-read/elapsed; named first-output uses polling; RSS and temporary logical/allocated disk are sampled lower bounds; sampling interval includes host observer execution; observer process and native oracle are outside candidate RSS"
    },
    "timeout": if kernel {
      "known completed profiles have no per-row deadline; the CI step overall deadline stops the run and may leave partial reports or temporary files"
    } else {
      "direct child is hard-canceled and reaped; abrupt termination does not promise guest temporary cleanup"
    },
    "kernel_rss": kernel,
    "wasm_root": wasm,
    "moonrun": moonrun,
    "oracle_bin": oracle,
    "distribution": distribution,
    "requested_distribution": requested_distribution,
    "blind_holdout": false,
    "general_performance_acceptance": false,
    "evidence_role": "synthetic-resource-regression",
    "record_keys": if literal {
      "all a collision misses or all Z sparse misses; sixteen fixed patterns with common suffix; one-MiB records unless long-record is selected"
    } else {
      "deterministic varying decimal keys; legacy mixed-synthetic widths7/89/4097/65537/128 with NUL/0xff on byte profiles; diff and csplit select ordinary80 or short-byte-dominant mixed32/64/96/128/512/4096 ASCII content modes"
    },
    "command_specific_overrides": "diff selects distinct-equal, sparse interior insert/delete and distributed interior edit modes; csplit selects repeated interior SECTION boundaries; these content modes use many short records; long-record additionally retains a separately named legacy-long-record control for each command",
  }
  @fs.write_file(root + "/metadata.json", metadata.stringify(indent=2))
  let summary = @fs.create(root + "/summary.jsonl")
  defer summary.close()
  let mut failures = 0
  for size in sizes {
    let input = root + "/input-" + size.to_string()
    let changed = input + ".changed"
    let mut last_record = -1L
    let mut last_binary = false
    let mut last_shape = ""
    let mut content_features : ContentInput? = None
    for command in commands {
      let regimes = if command == "diff" {
        ["distinct-equal-content", "sparse-interior-insert-delete", "distributed-interior-edits"]
      } else if command == "csplit" { ["repeated-interior-sections"] } else { ["legacy-command-profile"] }
      if long && (command == "diff" || command == "csplit") {
        regimes.push("legacy-long-record")
      }
      for regime in regimes {
      let legacy_long = regime == "legacy-long-record"
      let content = (command == "diff" || command == "csplit") && !legacy_long
      let record = if content { 80L } else if long {
        size
      } else if literal {
        1048576L
      } else {
        80L
      }
      let mixed = !legacy_long && distribution == "mixed-synthetic" && (content || !long)
      let binary = !legacy_long && distribution == "mixed-synthetic" &&
        command != "rev" &&
        !content
      let shape = if legacy_long { "legacy-long-record" }
        else if command == "csplit" { "interior-sections" }
        else if command == "diff" { "short-content" }
        else { "legacy-profile" }
      if record != last_record || binary != last_binary || shape != last_shape {
        if content {
          content_features = Some(write_content_input(input,size,mixed,command=="csplit"))
        } else {
          content_features = None
          write_input(
          input,
          size,
          record,
          mixed,
          binary,
          literal=if literal { distribution } else { "" },
        )
        }
        last_record = record
        last_binary = binary
        last_shape = shape
      }
      let content_recipe : Json = if legacy_long {
        if command == "diff" {
          let source = @fs.open(input, mode=ReadOnly)
          defer source.close()
          let right = @fs.create(changed)
          defer right.close()
          copy_content_range(source, right, 0L, size)
          right.write_at(b"x", position=0L)
        }
        {
          "regime": regime,
          "evidence_role": "legacy-single-record-stress",
          "record_layout": "one unbroken ASCII payload with a final LF",
          "source_bytes": size.to_string(),
          "same_file_identity": if command == "diff" { Json(false) } else { Json::null() },
          "input_transport": if command == "diff" {
            "distinct-named-regular-files"
          } else { "redirected-regular-file" },
          "comparison_regime": if command == "diff" {
            "byte-zero replacement in distinct regular files"
          } else {
            "first-record /^/ boundary; empty part-00 plus full-source part-01"
          },
          "independent_effect_check": if command == "csplit" {
            "part-00 is empty and part-01 equals the complete source"
          } else { "source/right hashes checked before and after both processes" },
        }
      } else if command == "diff" {
        write_content_diff(input,changed,content_features.unwrap(),regime)
      } else if command == "csplit" {
        let features=content_features.unwrap()
        guard features.section_offsets.length()>=2 else {fail("resource csplit needs at least two interior SECTION markers")}
        {
          "regime":regime,"observed_source":features,
          "expected_fragments":features.section_offsets.length()+1,
          "final_tail_bytes":(size-features.section_offsets[features.section_offsets.length()-1]).to_string(),
          "independent_effect_check":"each named fragment equals its complete declared source interval",
        }
      } else { Json::null() }
      let input_hash=resource_sha256(input)
      let changed_hash=if command=="diff" {Some(resource_sha256(changed))} else {None}
      if command=="diff" && regime=="distinct-equal-content" {
        guard changed_hash==Some(input_hash) && @fs.realpath(input)!=@fs.realpath(changed) else {fail("equal diff inputs must have equal bytes and distinct file paths")}
      } else if command=="diff" {
        guard changed_hash!=Some(input_hash) else {fail("edited resource diff inputs must differ")}
      }
      let directory = root + "/" + command + "-" + size.to_string() + (if content || legacy_long {"-"+regime} else {""})
      @fs.mkdir(directory)
      let input_identity : Json = {
        "source_path":input,"source_bytes":@fs.file_size(input).to_string(),"source_sha256":input_hash,
        "right_path":if command=="diff" {Json(changed)} else {Json::null()},
        "right_bytes":if command=="diff" {Json(@fs.file_size(changed).to_string())} else {Json::null()},
        "right_sha256":changed_hash,"requested_long_record":long,
        "actual_many_short_records":content,"legacy_long_record_control":legacy_long,
        "actual_single_record":legacy_long || (!content && long),"recipe":content_recipe,
      }
      @fs.write_file(directory+"/input-identities.json",input_identity.stringify(indent=2))
      println(
        "resource start \{command} regime=\{regime} bytes=\{size} record=\{record} distribution=\{distribution}",
      )
      let argv = if legacy_long && command == "csplit" {
        ["-s", "-f", "part-", "-", "/^/"]
      } else if literal {
        let result = ["-F", "-c"]
        let length = if distribution == "literal-budget" { 256 } else { 32 }
        let marker = if distribution == "literal-shared" { 28 } else { 0 }
        for number in 0..<16 {
          let pattern = Bytes::makei(length, index => {
            if index == marker {
              (98 + number).to_byte()
            } else {
              b'a'
            }
          })
          result.append(["-e", @utf8.decode(pattern)])
        }
        result
      } else {
        arguments(command, input, changed, binary)
      }
      let candidate = observe(
        moonrun,
        [wasm + "/cli/" + command + "/" + command + ".wasm", "--", ..argv],
        input,
        directory + "/candidate",
        timeout,
        kernel~,
      )
      guard resource_sha256(input)==input_hash && (changed_hash is None || Some(resource_sha256(changed))==changed_hash) else {
        fail("resource candidate changed a shared input; refusing to run the oracle on different bytes")
      }
      let reference = observe(
        oracle + "/" + command,
        argv,
        input,
        directory + "/oracle",
        timeout,
        kernel~,
      )
      guard resource_sha256(input)==input_hash && (changed_hash is None || Some(resource_sha256(changed))==changed_hash) else {fail("resource oracle changed a shared input")}
      let expected = if (command == "diff" && regime!="distinct-equal-content") || literal { 1 } else { 0 }
      let mut same = !candidate.timed_out &&
        !reference.timed_out &&
        candidate.status == expected &&
        reference.status == expected &&
        @fs.file_size(directory + "/candidate/stderr") == 0L &&
        @fs.file_size(directory + "/oracle/stderr") == 0L
      if command == "gzip" && same {
        same = decode(
            oracle + "/gzip",
            directory + "/candidate/stdout",
            directory + "/decoded-candidate",
          ) &&
          decode(
            oracle + "/gzip",
            directory + "/oracle/stdout",
            directory + "/decoded-oracle",
          ) &&
          equal_files(input, directory + "/decoded-candidate") &&
          equal_files(input, directory + "/decoded-oracle")
      } else if same {
        same = equal_files(
          directory + "/candidate/stdout",
          directory + "/oracle/stdout",
        )
      }
      same = same &&
        equal_effects(
          directory + "/candidate/effects",
          directory + "/oracle/effects",
        ) &&
        candidate.residual_temp_files == 0 &&
        candidate.residual_temp_entries == 0
      if command=="csplit" && same {
        same = candidate.output_bytes==0L && reference.output_bytes==0L
        if legacy_long {
          same = same &&
            legacy_long_fragments_match(input,directory+"/candidate/effects") &&
            legacy_long_fragments_match(input,directory+"/oracle/effects")
        } else {
          let features=content_features.unwrap()
          same = same &&
            content_fragments_match(input,directory+"/candidate/effects",features) &&
            content_fragments_match(input,directory+"/oracle/effects",features)
        }
      }
      if command=="diff" && regime=="distinct-equal-content" && same {
        same = candidate.output_bytes==0L && reference.output_bytes==0L
      } else if command=="diff" && same {
        same = candidate.output_bytes>0L && reference.output_bytes>0L
      }
      if command=="diff" && same {
        same = @fs.readdir(directory+"/candidate/effects").is_empty() && @fs.readdir(directory+"/oracle/effects").is_empty()
      }
      let result : Json = {
        "command": command,
        "regime":regime,
        "bytes": size.to_string(),
        "record_bytes": if mixed {
          if content {"mixed-short32/64/96/128/512/4096"} else {"legacy-mixed7/89/4097/65537/128"}
        } else {
          record.to_string()
        },
        "distribution": distribution,
        "actual_distribution": if legacy_long { "ascii-single-record" } else { distribution },
        "legacy_long_record_control":legacy_long,
        "binary_markers": binary,
        "expected_status":expected,
        "input_identities":input_identity,
        "input_hashes_unchanged":true,
        "args": argv,
        "candidate": candidate,
        "oracle": reference,
        "bytes_status_effects_equal": same,
      }
      @fs.write_file(directory + "/result.json", result.stringify(indent=2))
      summary.write(result.stringify() + "\n")
      println(
        "resource done \{command} bytes=\{size} equal=\{same} rss=\{candidate.sampled_rss_bytes} temp=\{candidate.sampled_temp_bytes}",
      )
      if same {
        for side in ["candidate", "oracle"] {
          @fs.remove(directory + "/" + side + "/stdout")
          @fs.rmdir(directory + "/" + side + "/effects", recursive=true)
        }
        if command == "gzip" {
          @fs.remove(directory + "/decoded-candidate")
          @fs.remove(directory + "/decoded-oracle")
        }
      } else {
        failures += 1
      }
      }
    }
    @fs.remove(input)
    if @fs.exists(changed) {
      @fs.remove(changed)
    }
  }
  println("resource completed failures=\{failures}")
  @sys.exit(if failures == 0 { 0 } else { 1 })
}
