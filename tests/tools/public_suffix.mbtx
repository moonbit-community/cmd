----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
  "moonbit-community/punycode@0.5.2",
}
----

///|
fn ascii_rule(rule : String) -> String raise {
  let labels : Array[String] = []
  for label in rule.split(".") {
    let label = label.to_owned()
    labels.push(
      if label.iter().all(c => c.to_int() < 128) {
        label
      } else {
        "xn--" + @punycode.encode(label)
      },
    )
  }
  labels.join(".")
}

///|
fn emit_rules(out : StringBuilder, name : String, rules : Set[String]) -> Unit {
  let sorted = rules.iter().to_array()
  sorted.sort_by((left, right) => left.lexical_compare(right))
  out.write_string("\n///|\nlet " + name + " : FixedArray[String] = [\n")
  for rule in sorted {
    out.write_string("  " + Json(rule).stringify() + ",\n")
  }
  out.write_string("]\n")
}

///|
async fn main {
  let args = @env.args()[1:]
  guard args == ["check"] ||
    args == ["update"] ||
    (args.length() == 3 && args[0] == "oracle" && args[1].has_prefix("sha256:")) else {
    fail(
      "Usage: moon run tests/tools/public_suffix.mbtx -- check|update|oracle IMAGE FRESH_DIRECTORY (from repository root)",
    )
  }
  let source = @fs.read_file("tests/fixtures/psl/public_suffix_list.dat").binary()
  let digest = @crypto.bytes_to_hex_string(@crypto.sha256(source))
  guard digest ==
    "762b6cbdd2dacc597b398fcd7860e2184b684125a58aa177dbdf54916a1f3430" else {
    fail("complete public suffix source checksum mismatch")
  }
  let exact : Set[String] = Set([])
  let wildcard : Set[String] = Set([])
  let exception : Set[String] = Set([])
  let records : Set[String] = Set([])
  let queries : Array[String] = []
  let answers : Array[String] = []
  let mut sections = 0
  let mut section_open = false
  for line in @utf8.decode(source).split("\n") {
    let line = line.trim().to_owned()
    if line.has_prefix("// ===BEGIN ") {
      assert_true(!section_open)
      section_open = true
      sections += 1
    } else if line.has_prefix("// ===END ") {
      assert_true(section_open)
      section_open = false
    } else if line != "" && !line.has_prefix("//") {
      guard section_open && !records.contains(line) else {
        fail("duplicate or unsectioned public suffix rule: " + line)
      }
      records.add(line)
      let (kind, rule) = if line.has_prefix("!") {
        (2, line[1:].to_owned())
      } else if line.has_prefix("*.") {
        (1, line[2:].to_owned())
      } else {
        (0, line)
      }
      guard !rule.is_empty() &&
        !rule.contains("*") &&
        !rule.contains("!") &&
        rule.split(".").all(label => !label.is_empty()) else {
        fail("unsupported public suffix syntax: " + line)
      }
      for spelling in [rule, ascii_rule(rule)] {
        queries.push(spelling)
        answers.push(if kind == 2 { "0" } else { "1" })
        if kind == 1 {
          queries.push("pinned-probe." + spelling)
          answers.push("1")
        }
        match kind {
          0 => exact.add(spelling)
          1 => {
            wildcard.add(spelling)
            exact.add(spelling)
          }
          _ => exception.add(spelling)
        }
      }
    }
  }
  assert_eq(sections, 2)
  assert_true(!section_open)
  assert_true(records.length() > 10000)
  let out = StringBuilder()
  out.write_string(
    "// This Source Code Form is subject to the terms of the Mozilla Public\n" +
    "// License, v. 2.0. If a copy of the MPL was not distributed with this\n" +
    "// file, You can obtain one at https://mozilla.org/MPL/2.0/.\n" +
    "// Generated by tests/tools/public_suffix.mbtx; do not edit.\n" +
    "// Public Suffix List snapshot: 94ec5df7273926560d91e77c002000ba1a53fec4.\n" +
    "// Source SHA-256: " +
    digest +
    ".\n" +
    "// Full ICANN and PRIVATE sections; Unicode rules and Punycode aliases.\n",
  )
  emit_rules(out, "cookie_suffix_exact", exact)
  emit_rules(out, "cookie_suffix_wildcard", wildcard)
  emit_rules(out, "cookie_suffix_exception", exception)
  let target = "core/netops/cookie_suffix_data.mbt"
  let formatted = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output(
    timeout_ms=30000,
  )
  formatted.check()
  // The formatter uses the host's line endings; generated source is always LF.
  let generated = formatted.stdout().replace_all(old="\r\n", new="\n")
  if generated != formatted.stdout() {
    println("Canonicalized formatter CRLF output to LF")
  }
  if args == ["update"] {
    @fs.write_file(target, generated)
  } else {
    let stored = @fs.read_file(target).binary()
    let expected = @utf8.encode(generated)
    guard stored == expected else {
      fail(
        target +
        " differs from the generated source: stored SHA-256 " +
        @crypto.bytes_to_hex_string(@crypto.sha256(stored)) +
        ", generated SHA-256 " +
        @crypto.bytes_to_hex_string(@crypto.sha256(expected)),
      )
    }
  }
  if args[0] == "oracle" {
    let image = args[1]
    let directory = args[2]
    guard !@fs.exists(directory) else {
      fail("fresh oracle PSL directory required")
    }
    @fs.mkdir(directory, recursive=true)
    let input = queries.join("\n") + "\n"
    let expected = answers.join("\n") + "\n"
    @fs.write_file(directory + "/queries.txt", input)
    @fs.write_file(directory + "/expected.txt", expected)
    let path = "/usr/share/publicsuffix/public_suffix_list.dat"
    let inspected = @shell.Cmd("docker", [
      "image", "inspect", "--format={{.Id}}", image,
    ]).output(timeout_ms=30000)
    inspected.check()
    assert_eq(inspected.stdout().trim().to_owned(), image)
    let hashes = @shell.Cmd("docker", [
      "run", "--rm", image, "/usr/bin/sha256sum", path,
    ]).output(timeout_ms=30000)
    hashes.check()
    @fs.write_file(directory + "/data.sha256", hashes.stdout())
    assert_eq(hashes.stdout(), digest + "  " + path + "\n")
    let info = @shell.Cmd("docker", [
      "run", "--rm", image, "/usr/bin/psl", "--print-info",
    ]).output(timeout_ms=30000)
    info.check()
    @fs.write_file(directory + "/latest-info.txt", info.stdout())
    for line in ["suffixes: 10398", "exceptions: 8", "wildcards: 314"] {
      assert_true(
        info.stdout().split("\n").any(part => part == line[:]),
        msg=line,
      )
    }
    let metadata = @shell.Cmd("docker", [
      "run", "--rm", image, "/usr/bin/stat", "--format=%n %s %Y", path,
    ]).output(timeout_ms=30000)
    metadata.check()
    @fs.write_file(directory + "/data-stat.txt", metadata.stdout())
    assert_eq(metadata.stdout(), path + " 338457 1793955696\n")
    let absent = @shell.Cmd("docker", [
      "run", "--rm", image, "/usr/bin/test", "!", "-e", "/usr/share/publicsuffix/public_suffix_list.dafsa",
    ]).output(timeout_ms=30000)
    absent.check()
    let retained = @shell.Cmd("docker", [
      "run", "--rm", image, "/usr/bin/sha256sum", "--check", "--strict", "/oracle/observations/retained-network-binaries.sha256",
    ]).output(timeout_ms=30000)
    @fs.write_file(directory + "/retained-binaries.txt", retained.stdout())
    retained.check()
    let version = @shell.Cmd("docker", [
      "run", "--rm", image, "/usr/bin/psl", "--version",
    ]).output(timeout_ms=30000)
    @fs.write_file(directory + "/psl-version.txt", version.stdout())
    version.check()
    assert_true(version.stdout().has_prefix("psl 0.21.2 "))
    for mode in ["latest", "explicit"] {
      let options = if mode == "latest" {
        ["--use-latest-data"]
      } else {
        ["--load-psl-file", path]
      }
      let observed = @shell.Cmd(
        "docker",
        [
          "run", "--rm", "-i", "-e", "LC_ALL=C.UTF-8", image, "/usr/bin/psl", ..options,
          "--is-public-suffix", "--batch",
        ],
        stdin=Text(input),
      ).output(timeout_ms=60000, max_output_bytes=2097152)
      @fs.write_file(directory + "/" + mode + ".stdout.txt", observed.stdout())
      @fs.write_file(directory + "/" + mode + ".stderr.txt", observed.stderr())
      @fs.write_file(
        directory + "/" + mode + ".status.txt",
        observed.exit_code().to_string(),
      )
      observed.check()
      assert_eq(
        observed.stdout(),
        expected,
        msg="complete Unicode and A-label PSL rules: " + mode,
      )
    }
    @fs.write_file(
      directory + "/receipt.json",
      Json::object({
        "image_digest": Json(image),
        "source_sha256": Json(digest),
        "source_records": Json(records.length()),
        "queries": Json(queries.length()),
        "queries_sha256": Json(
          @crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(input))),
        ),
        "expected_sha256": Json(
          @crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(expected))),
        ),
        "generator_sha256": Json(
          @crypto.bytes_to_hex_string(
            @crypto.sha256(
              @fs.read_file("tests/tools/public_suffix.mbtx").binary(),
            ),
          ),
        ),
        "generated_sha256": Json(
          @crypto.bytes_to_hex_string(
            @crypto.sha256(@utf8.encode(generated)),
          ),
        ),
        "passed": Json(true),
      }).stringify(indent=2),
    )
  }
  println(
    "public suffix source and generated rules verified: \{records.length()} source records",
  )
}
