----
import {
  "moonbitlang/async@0.22.9",
  "moonbitlang/async@0.22.9/fs",
  "moonbitlang/async@0.22.9/io",
  "moonbitlang/async@0.22.9/process",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.7/crypto",
}
----

///|
async fn cleanup_container(prefix : String, name : String) -> String? {
  let (record, failure) = try {
    let removed = @async.with_timeout(15000, () => {
      @process.collect_output("docker", ["rm", "--force", name])
    })
    let failed = removed.0 != 0 &&
      !removed.2.text().contains("No such container")
    (
      (
        {
          "status": removed.0,
          "stdout_text": removed.1.text(),
          "stderr_text": removed.2.text(),
        } : Json),
      if failed {
        Some("container cleanup failed")
      } else {
        None
      },
    )
  } catch {
    error => (({ "error": error.to_string() } : Json), Some(error.to_string()))
  }
  @fs.write_file(prefix + ".cleanup.json", record.stringify(indent=2)) catch {
    error => {
      let message = "cleanup report failed: " + error.to_string()
      println(message)
      return Some(message)
    }
  }
  failure
}

///|
async fn observed_docker(
  root : String,
  label : String,
  args : Array[String],
  stdin? : &@process.ProcessInput,
) -> (Int32, &@io.Data, &@io.Data) {
  if args.get(0) != Some("run") {
    return @async.with_timeout(15000, () => {
      @process.collect_output("docker", args, stdin?)
    })
  }
  assert_eq(args.get(1), Some("--rm"))
  let prefix = root + "/" + label
  let name = "cmd-jq-" +
    @crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(prefix)))
  @fs.write_file(
    prefix + ".intent.json",
    ({ "container_name": name, "args": args } : Json).stringify(indent=2),
  )
  let completed = Ref(false)
  defer @async.protect_from_cancel(() => {
    if cleanup_container(prefix, name) is Some(message) && completed.val {
      fail(message)
    }
  })
  let created = @async.with_timeout(15000, () => {
    @process.collect_output("docker", ["create", "--name", name, ..args[2:]])
  })
  assert_eq(created.0, 0, msg=created.2.text())
  @fs.write_file(prefix + ".container.txt", created.1.text())
  let result = @async.with_timeout(15000, () => {
    @process.collect_output(
      "docker",
      [
        "start",
        "--attach",
        ..if stdin is Some(_) {
          ["--interactive"]
        } else {
          []
        },
        name,
      ],
      stdin?,
    )
  })
  @fs.write_file(prefix + ".stdout.bin", result.1.binary())
  @fs.write_file(prefix + ".stderr.bin", result.2.binary())
  @fs.write_file(prefix + ".status.txt", result.0.to_string())
  completed.val = true
  result
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 &&
    args[1].has_prefix("/") &&
    args[2].has_prefix("sha256:") else {
    fail("Usage: jq_stream.mbtx FRESH_ABSOLUTE_ROOT IMMUTABLE_IMAGE")
  }
  let root = args[1]
  let image = args[2]
  @fs.mkdir(root, recursive=true, allow_exist=false)
  let inspected = observed_docker(root, "image", [
    "image", "inspect", "--format={{.Id}}", image,
  ])
  assert_eq(inspected.0, 0)
  assert_eq(inspected.1.text().trim().to_owned(), image)
  let history = observed_docker(root, "history", [
    "history", "--no-trunc", "--format={{.CreatedBy}}", image,
  ])
  assert_eq(history.0, 0)
  assert_true(
    history.1
    .text()
    .contains(
      "JQ_SHA256=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f",
    ),
  )
  let versions = observed_docker(root, "versions", [
    "run", "--rm", "--platform", "linux/amd64", image, "/usr/local/bin/versions.sh",
  ])
  assert_eq(versions.0, 0)
  let records : Array[Json] = []
  let inputs = [
    ("empty-input", ""),
    ("scalar", "1"),
    ("adjacent", "1{}[]\"x\" false null"),
    ("empty-array", "[]"),
    ("empty-object", "{}"),
    ("array", "[1,2]"),
    ("nested", "{\"a\":[1,{\"b\":2}],\"c\":[],\"d\":{}}"),
    ("duplicate-key", "{\"a\":1,\"a\":2}"),
    ("escaped-key", "{\"界\\n\\\"\\\\\":[\"尾\",true,false,null,-1.5e2]}"),
    ("consecutive", "[1]\n{\"x\":2}\n3"),
    ("late-eof", "[1,2"),
    ("trailing-array-comma", "[1,]"),
    ("trailing-object-comma", "{\"a\":1,}"),
    ("missing-colon", "{\"a\" 1}"),
    ("invalid-number", "[1,01]"),
    ("invalid-literal", "[true,falsee]"),
    ("invalid-string", "[1,\"bad\\q\"]"),
    ("missing-comma", "[1 2]"),
    (
      "numbers", "[9007199254740993,1.2300,1e400,1e9999999999,-01,NaN,Infinity,-Infinity]",
    ),
    (
      "decimal-exponents", "[1.2300e2,1e0,1.0e0,0e0,0.00e2,1e-7,1e-6,1e+0002,1e2147483648,1e-2147483649]",
    ),
    (
      "decimal-underflow", "[5e-1147483647,9e-1147483647,15e-1147483647,25e-1147483647,1e-1147483646]",
    ),
    ("number-grammar", "[1.,.5,-.5,+1,-0,-0.0]"),
    ("bom", "\uFEFF[1]"),
    ("root-number-bad-end", "1]"),
    ("root-literal-bad-end", "true,"),
    ("root-string-bad-end", "\"x\"]"),
    ("object-number-key-end", "{2}"),
    ("object-number-key-colon", "{2:"),
    ("object-string-key-end", "{\"a\"}"),
    ("object-number-key-eof", "{2"),
    ("stream-errors-lines", "[1,\"bad\\q\",2]\n[3,]\n{\"a\":4,\"b\":oops}\n5\n"),
    ("stream-errors-same-line", "[1,\"bad\\q\",2] 7 [8]\n9\n"),
    ("stream-errors-eof", "[1,2"),
    ("stream-errors-key", "{2}\n{2:\n{\"a\"}\n{2"),
    (
      "decimal-int64-edges", "[1.0e-9223372036854775808,99e9223372036854775807,1e-9223372036854775808,inf,-inf,nan,-nan]",
    ),
    ("stream-errors-buffer-before", String::make(4092, ' ') + "1]1\n2\n"),
    ("stream-errors-buffer-at", String::make(4093, ' ') + "1]1\n2\n"),
    ("stream-errors-buffer-after", String::make(4094, ' ') + "1]1\n2\n"),
    ("stream-errors-fgets-before", String::make(4088, ' ') + "1]1\n2\n"),
    ("stream-errors-fgets-at", String::make(4089, ' ') + "1]1\n2\n"),
    ("stream-errors-fgets-after", String::make(4090, ' ') + "1]1\n2\n"),
    ("stream-errors-utf8-tail", String::make(4089, ' ') + "\"界\"]1\n2\n"),
    (
      "stream-errors-utf8-recovery",
      "1]" + String::make(4088, ' ') + "界1\n2\n",
    ),
  ]
  inputs.append([
    ("raw-token", ""),
    ("stream-errors-raw-token", ""),
    ("stream-errors-raw-array", ""),
  ])
  for (label, input) in inputs {
    let path = root + "/" + label + ".stdin"
    let raw = match label {
      "raw-token" | "stream-errors-raw-token" => Some(b"\xff\n1\n")
      "stream-errors-raw-array" => Some(b"[1,\xff,2]\n3\n")
      _ => None
    }
    @fs.write_file(path, raw.unwrap_or_else(() => @utf8.encode(input)))
    let options = [
      if label.has_prefix("stream-errors-") {
        "--stream-errors"
      } else {
        "--stream"
      },
      "-c",
      ".",
    ]
    let process = observed_docker(
      root,
      label,
      [
        "run", "--rm", "--platform", "linux/amd64", "-i", "-e", "LC_ALL=C", image,
        "jq", ..options,
      ],
      stdin=@process.redirect_from_file(path),
    )
    let record : Json = {
      "label": label,
      "args": options,
      "status": process.0,
      "stdout_text": process.1.text(),
      "stderr_text": process.2.text(),
    }
    match record {
      Object(fields) =>
        match raw {
          Some(bytes) =>
            fields["stdin_hex"] = Json(@crypto.bytes_to_hex_string(bytes))
          None => fields["stdin_text"] = Json(input)
        }
      _ => fail("invalid capture record")
    }
    @fs.write_file(
      root + "/" + label + ".json",
      record.stringify(indent=2) + "\n",
    )
    records.push(record)
  }
  for
    (label, first, second) in [
      ("files-array", "[1,", "2]"),
      ("files-number", "1", "2"),
      ("files-string", "\"first", "second\""),
      ("files-error-recovery", "1]", "1"),
    ] {
    let work = root + "/" + label
    @fs.mkdir(work)
    @fs.write_file(work + "/first.json", first)
    @fs.write_file(work + "/second.json", second)
    let options = [
      if label == "files-error-recovery" {
        "--stream-errors"
      } else {
        "--stream"
      },
      "-c",
      ".",
      "first.json",
      "second.json",
    ]
    let process = observed_docker(
      root,
      label,
      [
        "run",
        "--rm",
        "--platform",
        "linux/amd64",
        "-v",
        work + ":" + work + ":ro",
        "-w",
        work,
        "-e",
        "LC_ALL=C",
        image,
        "jq",
        ..options,
      ],
    )
    let record : Json = {
      "label": label,
      "args": options,
      "stdin_text": "",
      "files": [
        { "path": "first.json", "text": first },
        { "path": "second.json", "text": second },
      ],
      "status": process.0,
      "stdout_text": process.1.text(),
      "stderr_text": process.2.text(),
    }
    @fs.write_file(
      root + "/" + label + ".json",
      record.stringify(indent=2) + "\n",
    )
    records.push(record)
  }
  let distribution = history.1
    .text()
    .split("\n")
    .filter(line => line.contains("--output /oracle/bin/jq"))
    .map(StringView::to_owned)
    .to_array()
  assert_eq(distribution.length(), 1)
  let binary = observed_docker(root, "binary", [
    "run", "--rm", "--platform", "linux/amd64", image, "sha256sum", "/oracle/bin/jq",
  ])
  assert_eq(binary.0, 0)
  assert_true(
    binary.1
    .text()
    .has_prefix(
      "b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f ",
    ),
  )
  @fs.write_file(
    root + "/stream.json",
    (
      {
        "image": image,
        "history_sha256": @crypto.bytes_to_hex_string(
          @crypto.sha256(history.1.binary()),
        ),
        "distribution": distribution,
        "binary_sha256": binary.1.text(),
        "versions": versions.1.text(),
        "cases": records,
      } : Json).stringify(indent=2) +
    "\n",
  )
  println("Captured " + records.length().to_string() + " jq stream cases")
}
