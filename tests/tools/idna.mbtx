----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.5/crypto",
}
----

///|
fn range(text : StringView) -> (Int32, Int32) raise {
  let parts = text.trim().split("..").to_array()
  let first = @string.parse_int(parts[0], base=16)
  let last = if parts.length() == 1 {
    first
  } else {
    assert_eq(parts.length(), 2)
    @string.parse_int(parts[1], base=16)
  }
  assert_true(first >= 0 && first <= last && last <= 0x10ffff)
  (first, last)
}

///|
fn fields(line : StringView) -> Array[String] {
  line
  .split("#")
  .next()
  .unwrap()
  .split(";")
  .map(field => field.trim().to_owned())
  .to_array()
}

///|
fn mapped(text : String) -> String raise {
  let output = StringBuilder()
  for part in text.split(" ") {
    if part.is_empty() {
      continue
    }
    let code = @string.parse_int(part, base=16)
    guard code.to_char() is Some(character) else {
      fail("invalid mapped scalar")
    }
    output.write_char(character)
  }
  Json(output.to_string()).stringify()
}

///|
fn table(
  output : StringBuilder,
  name : String,
  item_type : String,
  rows : Array[(Int32, Int32, String)],
) -> Unit raise {
  rows.sort_by((left, right) => left.0.compare(right.0))
  let mut previous = -1
  output.write_string(
    "\n///|\nlet " + name + " : FixedArray[(Int, Int, " + item_type + ")] = [\n",
  )
  for (first, last, value) in rows {
    assert_true(first > previous && first <= last, msg=name)
    previous = last
    output.write_string("  (\{first}, \{last}, " + value + "),\n")
  }
  output.write_string("]\n")
}

///|
async fn main {
  let arguments = @env.args()[1:]
  guard arguments == ["update"] || arguments == ["check"] else {
    fail(
      "Usage: moon run tests/tools/idna.mbtx -- update|check (from repository root)",
    )
  }
  let license = @fs.read_file("tests/fixtures/idna/LICENSE.txt").binary()
  assert_eq(
    @crypto.bytes_to_hex_string(@crypto.sha256(license)),
    "e7a93b009565cfce55919a381437ac4db883e9da2126fa28b91d12732bc53d96",
  )
  if arguments == ["update"] {
    @fs.write_file("core/netops/UNICODE-LICENSE.txt", license)
  } else {
    assert_eq(
      @fs.read_file("core/netops/UNICODE-LICENSE.txt").binary(),
      license,
    )
  }
  let inputs : Map[String, String] = Map([])
  for
    (name, expected) in [
      (
        "IdnaMappingTable.txt", "cc8522199541d60326a42a8f91f8748fd15630a42502dd2cf4878e81e2066ead",
      ),
      (
        "Idna2008.txt", "210e9ca4941bc8632f326e61f95175387960685546c1db975c67ffb6788db2e0",
      ),
      (
        "UnicodeData.txt", "806e9aed65037197f1ec85e12be6e8cd870fc5608b4de0fffd990f689f376a73",
      ),
      (
        "DerivedJoiningType.txt", "c4870b11e2b8b7d0eb70b99ce85608e5c28a399efa316cca97238a58ae160e5e",
      ),
    ] {
    let bytes = @fs.read_file("tests/fixtures/idna/" + name).binary()
    assert_eq(
      @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
      expected,
      msg=name,
    )
    inputs[name] = @utf8.decode(bytes)
  }
  let output = StringBuilder()
  output.write_string(
    "// Generated by tests/tools/idna.mbtx from the complete Unicode 15.0.0 inputs.\n// Copyright Unicode, Inc. See UNICODE-LICENSE.txt in this package.\n// Do not edit this file; input checksums are verified before regeneration.\n",
  )
  let mapping : Array[(Int32, Int32, String)] = []
  let mut next = 0
  for line in inputs["IdnaMappingTable.txt"].split("\n") {
    let parts = fields(line)
    if parts[0] == "" {
      continue
    }
    let (first, last) = range(parts[0])
    assert_eq(first, next)
    next = last + 1
    let value = match parts[1] {
      "valid" => "IdnaMapping::Valid"
      "ignored" => "IdnaMapping::Ignored"
      "disallowed" => "IdnaMapping::Disallowed"
      "disallowed_STD3_valid" => "IdnaMapping::Std3Valid"
      "mapped" => "IdnaMapping::Mapped(" + mapped(parts[2]) + ")"
      "deviation" => "IdnaMapping::Deviation(" + mapped(parts[2]) + ")"
      "disallowed_STD3_mapped" =>
        "IdnaMapping::Std3Mapped(" + mapped(parts[2]) + ")"
      status => fail("unknown IDNA mapping status: " + status)
    }
    mapping.push((first, last, value))
  }
  assert_eq(next, 0x110000)
  table(output, "idna_mappings", "IdnaMapping", mapping)
  let categories : Array[(Int32, Int32, String)] = []
  for line in inputs["Idna2008.txt"].split("\n") {
    let parts = fields(line)
    if parts[0] == "" {
      continue
    }
    let (first, last) = range(parts[0])
    let value = match parts[1] {
      "PVALID" => "Valid"
      "CONTEXTJ" => "ContextJ"
      "CONTEXTO" => "ContextO"
      "DISALLOWED" => "Disallowed"
      "UNASSIGNED" => "Unassigned"
      status => fail("unknown IDNA2008 category: " + status)
    }
    categories.push((first, last, "IdnaCategory::" + value))
  }
  table(output, "idna_categories", "IdnaCategory", categories)
  let properties : Array[(Int32, Int32, String)] = []
  let mut pending : (Int32, String)? = None
  for line in inputs["UnicodeData.txt"].split("\n") {
    let parts = fields(line)
    if parts[0] == "" {
      continue
    }
    assert_eq(parts.length(), 15)
    let code = @string.parse_int(parts[0], base=16)
    let bidi = match parts[4] {
      "L" => "Left"
      "R" => "Right"
      "AL" => "ArabicRight"
      "AN" => "ArabicNumber"
      "EN" => "EuropeanNumber"
      "ES" => "EuropeanSeparator"
      "CS" => "CommonSeparator"
      "ET" => "EuropeanTerminator"
      "ON" => "OtherNeutral"
      "BN" => "BoundaryNeutral"
      "NSM" => "NonspacingMark"
      _ => "Other"
    }
    let value = "(" +
      parts[3] +
      ", " +
      parts[2].has_prefix("M").to_string() +
      ", IdnaBidi::" +
      bidi +
      ")"
    if parts[1].has_suffix(", First>") {
      assert_true(pending is None)
      pending = Some((code, value))
    } else {
      let first = if parts[1].has_suffix(", Last>") {
        guard pending is Some((first, previous)) else {
          fail("missing Unicode range start")
        }
        assert_eq(previous, value)
        pending = None
        first
      } else {
        assert_true(pending is None)
        code
      }
      if properties.last() is Some((previous, last, before)) &&
        last + 1 == first &&
        before == value {
        properties[properties.length() - 1] = (previous, code, value)
      } else {
        properties.push((first, code, value))
      }
    }
  }
  assert_true(pending is None)
  table(output, "idna_unicode_properties", "(Int, Bool, IdnaBidi)", properties)
  let joining : Array[(Int32, Int32, String)] = []
  for line in inputs["DerivedJoiningType.txt"].split("\n") {
    let parts = fields(line)
    if parts[0] == "" {
      continue
    }
    let (first, last) = range(parts[0])
    let value = match parts[1] {
      "L" => "Left"
      "R" => "Right"
      "D" => "Dual"
      "T" => "Transparent"
      "C" | "U" => "NonJoining"
      status => fail("unknown joining type: " + status)
    }
    joining.push((first, last, "IdnaJoining::" + value))
  }
  table(output, "idna_joining_types", "IdnaJoining", joining)
  let result = @shell.Cmd("moonfmt", ["-"], stdin=Text(output.to_string())).output(
    timeout_ms=30000,
  )
  result.check()
  let generated = result.stdout().replace_all(old="\r\n", new="\n")
  let target = "core/netops/idna_data.mbt"
  if arguments == ["update"] {
    @fs.write_file(target, generated)
  } else {
    assert_eq(
      @fs.read_file(target).binary(),
      @utf8.encode(generated),
      msg=target,
    )
  }
  println(
    "Verified Unicode 15.0.0 IDNA mapping, categories, character and joining data",
  )
}
