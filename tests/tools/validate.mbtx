----
import {
  "moonbitlang/async@0.22.7", "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/shell", "moonbitlang/core/env",
  "moonbitlang/core/json", "moonbitlang/x@0.5.5/path",
}
----

///|
async fn main {
  let args = @env.args()
  guard args.length() == 2 && ["functional", "published"].contains(args[1]) else {
    fail("Usage: validate.mbtx functional|published")
  }
  let published = args[1] == "published"
  let root = @fs.realpath(".")
  let report_root = @env.get_env_var("CMD_TEST_REPORT_ROOT").unwrap_or(
    root + "/test-reports",
  )
  guard @path.Path(report_root).is_absolute() else {
    fail("CMD_TEST_REPORT_ROOT must be absolute")
  }
  @fs.mkdir(report_root, recursive=true, allow_exist=true)
  let profile = @env.get_env_var("CMD_TEST_PROFILE").unwrap_or("debug")
  guard ["debug", "release"].contains(profile) else {
    fail("unknown test-tool profile")
  }
  let program = root +
    "/_build/native/" +
    profile +
    "/build/mooxCLI/cmd-tests/" +
    (if published {
      "release/release.exe"
    } else {
      "harness/driver/driver.exe"
    })
  guard @fs.exists(program) else {
    fail("missing prepared test executable: " + program)
  }
  let arguments = [
    "--suite",
    if @async.platform is Linux {
      "all"
    } else {
      "functional"
    },
    "--jobs",
    if published {
      "1"
    } else {
      "4"
    },
    "--report-dir",
    report_root + "/" + args[1],
  ]
  if published {
    arguments.append([
      "--manifest",
      @env.get_env_var("CMD_RELEASE_MANIFEST").unwrap_or(
        "tests/release/latest.json",
      ),
    ])
  }
  if @async.platform is Linux {
    let image = @fs.read_file(report_root + "/oracle-image.txt")
      .text()
      .trim()
      .to_owned()
    arguments.append([
      "--oracle-image",
      image,
      "--oracle-profile",
      report_root + "/oracle-profile/profile.json",
    ])
  }
  let started = @async.now()
  let status = @shell.Cmd(program, arguments, stdout=Inherit, stderr=Inherit).status()
  let timing : Json = {
    "mode": args[1],
    "tool_profile": profile,
    "duration_ms": @async.now() - started,
    "status": status,
  }
  @fs.write_file(
    report_root + "/execution.json",
    timing.stringify(indent=2) + "\n",
  )
  if @env.get_env_var("GITHUB_STEP_SUMMARY") is Some(path) {
    @fs.write_file(
      path,
      "Command validation: " + timing.stringify() + "\n",
      append=true,
    )
  }
  guard status == 0 else {
    fail("command validation failed with status \{status}")
  }
}
