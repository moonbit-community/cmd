----
import {
  "moonbitlang/async@0.22.9", "moonbitlang/async@0.22.9/fs",
  "moonbitlang/async@0.22.9/shell", "moonbitlang/core/env",
}
----

///|
async fn main {
  guard @env.args()[1:] is [mode] && ["check", "update"].contains(mode) else {
    fail("index requires check or update")
  }
  let profile = @env.get_env_var("CMD_TEST_PROFILE").unwrap_or("debug")
  guard ["debug", "release"].contains(profile) else {
    fail("unknown test-tool profile")
  }
  let prefix = "_build/native/" + profile + "/build/mooxCLI/cmd-tests/"
  @shell.Cmd(
    prefix + "harness/driver/driver.exe",
    ["--suite", "all", "--validate-only"],
    stdout=Inherit,
    stderr=Inherit,
  ).run()
  let temporary = @fs.tmpdir(prefix="cmd-test-index-")
  defer @fs.rmdir(temporary, recursive=true)
  @shell.Cmd(
    prefix + "release/release.exe",
    ["--generate-candidate", "--output", temporary + "/candidate.json"],
    stdout=Inherit,
    stderr=Inherit,
  ).run()
  let destination = "tests/release/candidate.json"
  let current = @fs.read_file(destination).binary()
  let generated = @fs.read_file(temporary + "/candidate.json").binary()
  if current != generated {
    if mode == "check" {
      fail("candidate manifest is stale; run index update")
    }
    @fs.write_file(destination, generated)
  }
  println(
    "Test index " +
    mode +
    ": registry validated; published expectations preserved",
  )
}
