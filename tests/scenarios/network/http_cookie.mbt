///|
async fn cookie_request_bytes(connection : @socket.Tcp) -> Bytes {
  let bytes : Array[Byte] = []
  for ;; {
    let byte = connection.read_exactly(1)[0]
    bytes.push(byte)
    let n = bytes.length()
    if n >= 4 &&
      bytes[n - 4] == b'\r' &&
      bytes[n - 3] == b'\n' &&
      bytes[n - 2] == b'\r' &&
      byte == b'\n' {
      return Bytes::from_array(bytes)
    }
    assert_true(n <= 65536)
  }
}

///|
fn cookie_request_lines(bytes : Bytes) -> Array[Bytes] {
  let lines : Array[Bytes] = []
  let mut start = 0
  for position in 0..<bytes.length() {
    if bytes[position] == b'\n' {
      let end = if position > start && bytes[position - 1] == b'\r' {
        position - 1
      } else {
        position
      }
      lines.push(bytes[start:end].to_owned())
      start = position + 1
    }
  }
  lines
}

///|
fn cookie_request_effects(bytes : Bytes, candidate : Bool) -> Json raise {
  let lines = cookie_request_lines(bytes)
  guard lines.get(0) is Some(first) else { fail("missing request line") }
  let line = @utf8.decode(first)
  let parts = line.split(" ").to_array()
  assert_eq(parts.length(), 3)
  assert_true(parts[0] == "GET" || parts[0] == "HEAD" || parts[0] == "POST")
  assert_eq(parts[2], "HTTP/1.1")
  let path = if candidate {
    parts[1].to_owned()
  } else {
    guard parts[1].strip_prefix("http://octets.example") is Some(path) else {
      fail("unexpected oracle request target")
    }
    path.to_owned()
  }
  let fields : Array[Json] = []
  for field in lines[1:] {
    if field.to_array().search(b':') is Some(colon) {
      let name = @utf8.decode(field[:colon].to_owned()).to_lower()
      if [
          "host", "cookie", "authorization", "content-length", "transfer-encoding",
        ].contains(name) ||
        name.has_prefix("x-") {
        fields.push(Json(@crypto.bytes_to_hex_string(field)))
      }
    }
  }
  let body = if parts[0] == "POST" {
    bytes[bytes.length() - 3:].to_owned()
  } else {
    b""
  }
  {
    "method": Json(parts[0].to_owned()),
    "target": Json(path),
    "fields_hex": Json(fields),
    "body_hex": Json(@crypto.bytes_to_hex_string(body)),
  }
}

///|
fn cookie_files_without_preamble(files : Json, command : String) -> Json raise {
  let entries = transfer_array(files).map(file => {
    let fields = transfer_object(file)
    let name = transfer_string(fields["name"])
    if fields.get("kind") == Some(Json("directory")) {
      return (
        name,
        (
          {
            "name": Json(name),
            "kind": "directory",
            "entries": cookie_files_without_preamble(fields["entries"], command),
          } : Json),
      )
    }
    let bytes = @harness.decode_hex(transfer_string(fields["hex"]), name)
    let content = if command == "wget" &&
      ["saved.cookies", "reloaded.cookies"].contains(name) {
      let lines = cookie_request_lines(bytes)
      let upstream = lines.length() >= 4 && lines[0] == b"# HTTP Cookie File"
      let count = if upstream {
        let generated = @utf8.decode(lines[1])
        assert_true(generated.has_prefix("# Generated by Wget on "))
        assert_true(generated.has_suffix("."))
        assert_eq(lines[2], b"# Edit at your own risk.")
        assert_eq(lines[3], b"")
        4
      } else {
        assert_true(lines.length() >= 3)
        assert_eq(lines[0], b"# Netscape HTTP Cookie File")
        assert_eq(lines[1], b"# Generated by cli/core")
        assert_eq(lines[2], b"")
        3
      }
      let mut offset = 0
      let mut seen = 0
      while seen < count {
        if bytes[offset] == b'\n' {
          seen += 1
        }
        offset += 1
      }
      bytes[offset:].to_owned()
    } else {
      bytes
    }
    (
      name,
      (
        {
          "name": Json(name),
          "hex": Json(@crypto.bytes_to_hex_string(content)),
        } : Json),
    )
  })
  entries.sort_by((left, right) => left.0.lexical_compare(right.0))
  Json(entries.map(entry => entry.1))
}

///|
async fn network_http_cookie_scenario(
  executor : Executor,
  work : String,
  command~ : String,
  oracle_image? : String,
) -> Unit {
  let fixture = transfer_object(
    @json.parse(
      @fs.read_file(
        @harness.repository_root() + "/tests/fixtures/network/http-cookie.json",
      ).text(),
    ),
  )
  assert_eq(fixture["schema"], Json(1))
  let cases = transfer_array(fixture["cases"])
  assert_eq(cases.length(), 94)
  for
    (name, count) in [
      ("http-cookie-supplement", 65),
      ("http-cookie-headers", 11),
      ("http-config", 10),
      ("http-cookie-terminal", 3),
      ("http-config-edges", 6),
      ("http-config-validation", 4),
      ("http-config-failures", 7),
      ("http-header-config", 7),
    ] {
    let extra = transfer_object(
      @json.parse(
        @fs.read_file(
          @harness.repository_root() +
          "/tests/fixtures/network/" +
          name +
          ".json",
        ).text(),
      ),
    )
    for key in ["schema", "image", "history_sha256", "binaries", "versions"] {
      assert_eq(extra[key], fixture[key])
    }
    let additional = transfer_array(extra["cases"])
    assert_eq(additional.length(), count)
    assert_eq(extra["case_count"], Json(count))
    cases.append(additional)
  }
  let labels : Map[String, Bool] = Map([])
  for definition in cases {
    let label = transfer_string(transfer_object(definition)["label"])
    assert_false(
      labels.contains(label),
      msg="duplicate cookie fixture: " + label,
    )
    labels[label] = true
  }
  let selected = cases.filter(value => {
    transfer_object(value)["command"] == Json(command)
  })
  assert_eq(selected.length(), if command == "curl" { 113 } else { 94 })
  let failures : Array[String] = []
  for definition in selected {
    let spec = transfer_object(definition)
    let label = transfer_filename(spec["label"])
    let directory = work + "/" + label
    let evidence = directory + ".evidence"
    @fs.mkdir(directory)
    @fs.mkdir(evidence)
    transfer_create_files(directory, transfer_array(spec["initial_files"]))
    if oracle_image is Some(_) {
      @fs.mkdir(directory + "/oracle")
      transfer_create_files(
        directory + "/oracle",
        transfer_array(spec["initial_files"]),
      )
    }
    let phases = transfer_array(spec["phases"])
    assert_eq(phases.length(), 2)
    for phase_index, phase in phases {
      let expected = transfer_object(phase)
      let exchanges = transfer_array(expected["exchanges"])
      let current = Ref(directory)
      let pending = Ref(0)
      let returned = Ref(false)
      let candidate_requests : Array[Bytes] = []
      let oracle_requests : Array[Bytes] = []
      let tunnels : Array[Bytes] = []
      let candidate_before : Array[Json] = []
      let oracle_before : Array[Json] = []
      let candidate_writes : Array[Json] = []
      let oracle_writes : Array[Json] = []
      let errors : Array[String] = []
      let candidate_files = Ref(Json::null())
      defer @async.protect_from_cancel(() => {
        @fs.write_file(
          evidence + "/phase-\{phase_index}.wire.json",
          (
            {
              "candidate_returned": Json(returned.val),
              "observer_quiesced": Json(pending.val == 0),
              "candidate_requests": Json(
                candidate_requests.map(bytes => {
                  Json(@crypto.bytes_to_hex_string(bytes))
                }),
              ),
              "oracle_requests": Json(
                oracle_requests.map(bytes => {
                  Json(@crypto.bytes_to_hex_string(bytes))
                }),
              ),
              "candidate_tunnels": Json(
                tunnels.map(bytes => Json(@crypto.bytes_to_hex_string(bytes))),
              ),
              "candidate_before": Json(candidate_before),
              "oracle_before": Json(oracle_before),
              "candidate_writes": Json(candidate_writes),
              "oracle_writes": Json(oracle_writes),
              "errors": Json(errors),
              "candidate_files": candidate_files.val,
            } : Json).stringify(indent=2) +
          "\n",
        )
      })
      let failure = try {
        @async.with_task_group(group => {
          let server = @socket.TcpServer(@socket.Addr::parse("127.0.0.1:0"))
          group.add_defer(() => server.close())
          group.spawn_bg(no_wait=true, () => {
            server.run_forever((connection, _) => {
              let candidate = current.val == directory
              let destination = current.val
              let requests = if candidate {
                candidate_requests
              } else {
                oracle_requests
              }
              let before = if candidate {
                candidate_before
              } else {
                oracle_before
              }
              let writes = if candidate {
                candidate_writes
              } else {
                oracle_writes
              }
              pending.val += 1
              defer {
                pending.val -= 1
              }
              let outcome = try {
                let mut request = cookie_request_bytes(connection)
                if candidate {
                  tunnels.push(request)
                  assert_eq(
                    cookie_request_lines(request)[0],
                    b"CONNECT octets.example:80 HTTP/1.1",
                  )
                  connection.write(
                    "HTTP/1.1 200 Connection Established\r\n\r\n",
                  )
                  request = cookie_request_bytes(connection)
                }
                if label == "curl-post-header-remove-length" {
                  request = request + connection.read_exactly(3)
                }
                let index = requests.length()
                requests.push(request)
                before.push(
                  transfer_file_state(
                    destination,
                    oracle_child=candidate && oracle_image is Some(_),
                  ),
                )
                guard exchanges.get(index) is Some(exchange) else {
                  fail("unexpected extra request: " + label)
                }
                let exchange = transfer_object(exchange)
                let wire = @harness.decode_hex(
                  transfer_string(exchange["response_hex"]),
                  label,
                )
                connection.write(wire)
                writes.push({
                  "index": Json(index),
                  "response_hex": Json(@crypto.bytes_to_hex_string(wire)),
                })
                Ok(())
              } catch {
                error => Err(error)
              }
              match outcome {
                Ok(_) => ()
                Err(error) => {
                  errors.push(error.to_string())
                  raise error
                }
              }
            })
          })
          let observing : Executor = {
            invoke: invocation => {
              let execution = (executor.invoke)(invocation)
              returned.val = true
              execution
            },
          }
          let original : Array[String] = @json.from_json(expected["args"])
          let args = original
          let proxy = "http://127.0.0.1:" + server.addr.port().to_string()
          let result = network_request(
            observing,
            directory,
            command,
            args,
            evidence_work=evidence,
            environment={
              "LC_ALL": "C",
              "TZ": "UTC",
              "CURL_HOME": ".",
              "WGETRC": "./wgetrc",
              "HOME": "",
              "XDG_CONFIG_HOME": if label == "curl-config-xdg" {
                "missing"
              } else {
                ""
              },
              "NO_PROXY": "",
              "no_proxy": "",
              "http_proxy": proxy,
              "HTTP_PROXY": if @async.platform is Windows {
                proxy
              } else {
                ""
              },
              "https_proxy": "",
              "HTTPS_PROXY": "",
              "ALL_PROXY": "",
              "all_proxy": "",
            },
            oracle_image?,
            oracle_args=original,
            oracle_failures=failures,
            after_candidate=() => {
              @async.with_timeout(5000, () => {
                while pending.val > 0 {
                  @async.sleep(5)
                }
              })
              candidate_files.val = transfer_file_state(
                directory,
                oracle_child=oracle_image is Some(_),
              )
              current.val = directory + "/oracle"
            },
          )
          @async.with_timeout(5000, () => {
            while pending.val > 0 {
              @async.sleep(5)
            }
          })
          assert_true(errors.is_empty(), msg=errors.join("\n"))
          for
            candidate in (if oracle_image is Some(_) {
              [true, false]
            } else {
              [true]
            }) {
            let requests = if candidate {
              candidate_requests
            } else {
              oracle_requests
            }
            let before = if candidate {
              candidate_before
            } else {
              oracle_before
            }
            let writes = if candidate {
              candidate_writes
            } else {
              oracle_writes
            }
            assert_eq(requests.length(), exchanges.length(), msg=label)
            assert_eq(writes.length(), exchanges.length(), msg=label)
            if candidate {
              assert_eq(tunnels.length(), requests.length())
            }
            for index, exchange in exchanges {
              let fields = transfer_object(exchange)
              assert_eq(
                writes[index],
                (
                  {
                    "index": Json(index),
                    "response_hex": fields["response_hex"],
                  } : Json),
                msg=label,
              )
              assert_eq(
                cookie_request_effects(requests[index], candidate),
                cookie_request_effects(
                  @harness.decode_hex(
                    transfer_string(fields["request_hex"]),
                    label,
                  ),
                  false,
                ),
                msg=label,
              )
              assert_eq(
                cookie_files_without_preamble(before[index], command),
                cookie_files_without_preamble(fields["files_before"], command),
                msg=label,
              )
            }
            let actual_files = if candidate {
              candidate_files.val
            } else {
              transfer_file_state(directory + "/oracle")
            }
            assert_eq(
              cookie_files_without_preamble(actual_files, command),
              cookie_files_without_preamble(expected["files_after"], command),
              msg=label,
            )
          }
          assert_eq(Json(result.status), expected["status"], msg=label)
          assert_eq(
            Json(@crypto.bytes_to_hex_string(result.stdout)),
            expected["stdout_hex"],
            msg=label,
          )
          assert_eq(
            Json(@crypto.bytes_to_hex_string(result.stderr)),
            expected["stderr_hex"],
            msg=label,
          )
        })
        None
      } catch {
        error => Some(error.to_string())
      }
      @fs.write_file(
        evidence + "/phase-\{phase_index}.result.json",
        (
          { "passed": Json(failure is None), "error": @json.to_json(failure) } :
          Json).stringify(indent=2),
      )
      if failure is Some(error) {
        failures.push(label + " phase \{phase_index}: " + error)
      }
    }
  }
  guard failures.is_empty() else { fail(failures.join("\n")) }
}
