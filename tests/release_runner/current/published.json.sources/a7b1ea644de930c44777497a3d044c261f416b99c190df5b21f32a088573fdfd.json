        {
          "path": "x002.bin",
          "content_hex": "03"
        }
      ],
      "oracle": true,
      "source_version": "GNU coreutils 9.11"
    },
    {
      "id": "p1-split-existing-boundary",
      "command": "split",
      "args": [
        "-b1"
      ],
      "stdin_text": "abc",
      "files": [
        {
          "path": "xaa",
          "content_text": "keep"
        }
      ],
      "environment": {},
      "expected_status": 1,
      "expected_stdout_text": "",
      "expected_stderr_contains": "existing output is unsupported",
      "diagnostic_reason": "The path-specific boundary diagnostic varies with the output prefix.",
      "expected_rejection": "existing output is unsupported",
      "comparison": "contract",
      "normalizations": [],
      "expected_files": [
        {
          "path": "xaa",
          "content_text": "keep"
        },
        {
          "path": "xab",
          "exists": false
        }
      ]
    },
