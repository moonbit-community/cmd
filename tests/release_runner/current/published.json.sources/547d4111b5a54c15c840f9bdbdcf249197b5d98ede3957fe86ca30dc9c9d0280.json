    {
      "id": "release-metadata-csplit-help",
      "command": "csplit",
      "args": [
        "--help"
      ],
      "stdin_text": "",
      "files": [],
      "environment": {},
      "expected_status": 0,
      "normalizations": [],
      "comparison": "contract",
      "coverage": [
        "help"
      ],
      "source_version": "workspace cli/csplit@0.1.2 metadata contract",
      "expected_stdout_text": "Usage: csplit [OPTION]... FILE PATTERN...\nSplit FILE (- for stdin) at line numbers or basic regular expressions.\nPatterns: NUMBER, /REGEXP/[OFFSET], %REGEXP%[OFFSET], {N}, {*}\n\n  -f, --prefix=PREFIX      Use PREFIX instead of xx.\n  -n, --digits=NUMBER      Use at least NUMBER suffix digits (default 2).\n  -s, --silent             Suppress output byte counts.\n  -q, --quiet              Same as --silent.\n  -k, --keep-files         Keep created fragments after a split error.\n  -z, --elide-empty-files  Omit empty output fragments.\n      --help               display this help and exit\n      --version            display version and exit\n\nExisting output paths, custom suffix formats, backreferences, non-ASCII\nregex patterns, and locale-specific matching are unsupported.\n",
      "expected_stderr_text": ""
