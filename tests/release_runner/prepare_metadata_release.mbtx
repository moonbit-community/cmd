///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/crypto",
}

///|
struct Edit {
  path : String
  before : String
  after : String
}

///|
fn field(value : Json, key : String) -> String raise {
  guard value is Object(fields) && fields.get(key) is Some(String(text)) else {
    fail("missing string field: " + key)
  }
  text
}

///|
async fn command(program : String, args : Array[String]) -> String {
  let output = @shell.Cmd(program, args).output(timeout_ms=30000)
  guard output.exit_code() == 0 else {
    fail(program + " failed: " + output.stderr())
  }
  output.stdout()
}

///|
fn replace_version(
  source : String,
  name : String,
  before : String,
  after : String,
) -> String {
  source
  .replace_all(
    old="\"" + name + " " + before + "\\n\"",
    new="\"" + name + " " + after + "\\n\"",
  )
  .replace_all(
    old="let command_version = \"" + before + "\"",
    new="let command_version = \"" + after + "\"",
  )
  .replace_all(
    old="@gzipops.run(\"" + name + "\", @env.args()[1:], \"" + before + "\")",
    new="@gzipops.run(\"" + name + "\", @env.args()[1:], \"" + after + "\")",
  )
}

///|
fn update_readme(
  source : String,
  name : String,
  before : String,
  after : String,
) -> String raise {
  let versioned = source
    .replace_all(old="**" + before + "**", new="**" + after + "**")
    .replace_all(old="version " + before + ".", new="version " + after + ".")
  guard versioned != source else {
    fail("README has no current package version: " + name)
  }
  let old_metadata = "The unreleased workspace adds standalone `--version`, which prints the command\nname and package version and exits successfully without reading input.\n"
  let clean = versioned
    .replace_all(old=old_metadata, new="")
    .replace_all(old="Use `--help` to display usage.\n", new="")
    .replace_all(
      old="Standalone `--help` also prints the supported invocation forms.\n",
      new="",
    )
  clean.trim_end().to_owned() +
  "\n\n## Standalone metadata\n\nStandalone `--version` prints exactly `" +
  name +
  " " +
  after +
  "` followed by one\nnewline. Standalone `--help` starts with `Usage: " +
  name +
  "`, lists both\nmetadata options, and ends with a newline. Both write to stdout, leave stdin\nunread, and exit with status 0. Exact-version publication and verification\nremain recorded separately in the [support record](../../docs/compatibility.md).\n"
}

///|
async fn main {
  let args = @env.args()[1:]
  guard args.length() == 2 && (args[0] == "--check" || args[0] == "--apply") else {
    fail(
      "Usage: prepare_metadata_release.mbtx --check|--apply INVENTORY_DIRECTORY",
    )
  }
  let evidence = args[1]
  let plan_path = "docs/reports/2026-10-15-metadata-release/registry-inventory.json"
  guard @json.parse(@fs.read_file(plan_path).text()) is Array(plan) &&
    plan.length() == 79 else {
    fail("expected the reviewed core plus 78-command release inventory")
  }
  let edits : Array[Edit] = []
  let rows : Array[Json] = []
  let seen : Map[String, Bool] = Map([])
  let mut dependencies = 0
  for item in plan {
    let module_name = field(item, "module")
    guard module_name.has_prefix("cli/") else {
      fail("unexpected module namespace")
    }
    let name = module_name[4:].to_owned()
    guard name != "timeout" &&
      name.iter().all(c => c is ('a'..<='z' | '0'..<='9')) &&
      !seen.contains(name) else {
      fail("invalid or duplicate release command: " + name)
    }
    seen[name] = true
    let before = field(item, "expected_published")
    let after = field(item, "proposed_version")
    let checksum = field(item, "published_checksum")
    let manifest = @json.parse(
      @fs.read_file(evidence + "/" + name + ".json").text(),
    )
    guard manifest
      is {
        "module": String(actual_name),
        "version": String(actual_version),
        "latest_version": String(latest),
        "yanked": False,
        "metadata": { "checksum": String(actual_checksum), .. },
        "versions": Array(versions),
        ..
      } &&
      actual_name == module_name &&
      actual_version == before &&
      latest == before &&
      actual_checksum == checksum else {
      fail(
        "registry observation no longer matches the release inventory: " +
        module_name,
      )
    }
    guard !versions.any(v => {
      v is { "version": String(version), .. } && version == after
    }) else {
      fail("proposed coordinate already exists: " + module_name + "@" + after)
    }
    let archive = evidence + "/" + name + ".zip"
    guard @crypto.bytes_to_hex_string(
        @crypto.sha256(@fs.read_file(archive).binary()),
      ) ==
      checksum else {
      fail("published archive checksum mismatch: " + module_name)
    }
    let base = if name == "core" { "core" } else { "commands/" + name }
    let files = command("git", ["ls-files", "--", base])
      .split("\n")
      .filter(s => !s.is_empty())
      .map(s => s.to_owned())
      .collect()
    let archive_paths = command("unzip", ["-Z1", archive])
      .split("\n")
      .map(s => s.to_owned())
      .collect()
    let source_changes : Array[String] = []
    let api_changes : Array[String] = []
    let mut version_files = 0
    for path in files {
      if !(path.has_suffix(".mbt") || path.has_suffix(".mbti")) ||
        path.has_suffix("_test.mbt") ||
        path.has_suffix("_wbtest.mbt") {
        continue
      }
      let relative = path[base.length() + 1:].to_owned()
      let source = @fs.read_file(path).text()
      let differs = if archive_paths.contains(relative) {
        command("unzip", ["-p", archive, relative]) != source
      } else {
        true
      }
      if differs {
        if path.has_suffix(".mbti") {
          api_changes.push(relative)
        } else {
          source_changes.push(relative)
        }
      }
      if name != "core" && path.has_suffix(".mbt") {
        let next = replace_version(source, name, before, after)
        if next != source {
          version_files += 1
          edits.push({ path, before: source, after: next, })
        }
      }
    }
    let module_path = base + "/moon.mod"
    let source = @fs.read_file(module_path).text()
    let old_version = "version = \"" + before + "\""
    guard source.contains(old_version) else {
      fail("unexpected workspace version: " + module_name)
    }
    let mut next = source.replace_all(
      old=old_version,
      new="version = \"" + after + "\"",
    )
    let mut dependency_changed = false
    guard item is Object(fields) else { fail("invalid inventory entry") }
    match fields.get("core_dependency") {
      Some(String(dependency)) => {
        let old_dependency = "\"cli/core@" + dependency + "\""
        guard name != "core" && source.contains(old_dependency) else {
          fail("unexpected core dependency: " + module_name)
        }
        next = next.replace_all(old=old_dependency, new="\"cli/core@0.6.0\"")
        dependencies += 1
        dependency_changed = true
      }
      Some(Null) => {
        guard !source.contains("cli/core@") else {
          fail("unrecorded core dependency: " + module_name)
        }
      }
      _ => fail("missing core dependency inventory: " + module_name)
    }
    guard !source_changes.is_empty() || dependency_changed else {
      fail("no product change justifies the proposed version: " + module_name)
    }
    guard name == "core" || version_files > 0 else {
      fail("no command metadata version declaration found: " + name)
    }
    edits.push({ path: module_path, before: source, after: next, })
    let readme_path = base + "/README.md"
    let readme = @fs.read_file(readme_path).text()
    let updated_readme = if name == "core" {
      guard after == "0.6.0" else { fail("unexpected core release decision") }
      readme.replace(
        old="Version **0.5.0** adds",
        new="Version **0.6.0** adds a package-version argument to the public gzip runner,\nstandardizes checksum help/version output, and exposes standalone metadata\noptions in the shared command catalog. Version **0.5.0** added",
      )
    } else {
      update_readme(readme, name, before, after)
    }
    guard updated_readme != readme else {
      fail("README version update made no change: " + name)
    }
    edits.push({ path: readme_path, before: readme, after: updated_readme, })
    rows.push({
      "module": module_name,
      "published_version": before,
      "proposed_version": after,
      "published_archive_sha256": checksum,
      "proposed_absent": true,
      "changed_source_files": Json(source_changes),
      "changed_public_interfaces": Json(api_changes),
      "core_dependency_changed": dependency_changed,
      "version_declaration_files": version_files,
    })
  }
  guard seen.contains("core") && seen.length() == 79 else {
    fail("incomplete release inventory")
  }
  // Validate every original file before the first write. Preflight failures
  // and source drift observed during preparation reject the whole edit set.
  for edit in edits {
    guard @fs.read_file(edit.path).text() == edit.before else {
      fail("source changed during preparation: " + edit.path)
    }
  }
  @fs.write_file(
    evidence + "/source-differences.json",
    Json(rows).stringify(indent=2) + "\n",
  )
  if args[0] == "--apply" {
    for edit in edits {
      @fs.write_file(edit.path, edit.after)
    }
  }
  let summary : Json = {
    "mode": args[0],
    "modules": 79,
    "commands": 78,
    "core_dependencies_updated": dependencies,
    "edited_files": Json(edits.map(e => e.path)),
    "source_comparison": evidence + "/source-differences.json",
  }
  println(summary.stringify(indent=2))
}
