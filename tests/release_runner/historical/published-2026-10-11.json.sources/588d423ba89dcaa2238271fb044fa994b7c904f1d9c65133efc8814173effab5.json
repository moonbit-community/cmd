{
  "schema": 2,
  "cases": [
    {
      "id": "checksum-md5sum-stdin", "command": "md5sum", "args": [], "oracle": true, "source_version": "GNU coreutils 9.11",
      "files": [], "environment": {}, "normalizations": [],
      "stdin_text": "abc", "expected_status": 0,
      "expected_stdout_text": "900150983cd24fb0d6963f7d28e17f72  -\n",
      "expected_stderr_text": "", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-empty", "command": "md5sum", "args": [], "oracle": true, "source_version": "GNU coreutils 9.11",
      "files": [], "environment": {}, "normalizations": [],
      "stdin_text": "", "expected_status": 0,
      "expected_stdout_text": "d41d8cd98f00b204e9800998ecf8427e  -\n",
      "expected_stderr_text": "", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-zero-binary", "command": "md5sum", "args": ["-tbz", "payload"], "oracle": true, "source_version": "GNU coreutils 9.11",
      "environment": {}, "normalizations": [],
      "files": [{"path": "payload", "content_text": "abc"}], "expected_status": 0,
      "expected_stdout_text": "900150983cd24fb0d6963f7d28e17f72 *payload\u0000",
      "expected_stderr_text": "", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-check", "command": "md5sum", "args": ["-c", "checks"], "oracle": true, "source_version": "GNU coreutils 9.11",
      "environment": {}, "normalizations": [],
      "files": [
        {"path": "payload", "content_text": "abc"},
        {"path": "checks", "content_text": "# comment\n900150983CD24FB0D6963F7D28E17F72 *payload\r\n"}
      ],
      "expected_status": 0, "expected_stdout_text": "payload: OK\n",
      "expected_stderr_text": "", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-mismatch", "command": "md5sum", "args": ["-c", "checks"],
      "environment": {}, "normalizations": [],
      "files": [
        {"path": "payload", "content_text": "different"},
        {"path": "checks", "content_text": "900150983cd24fb0d6963f7d28e17f72  payload\n"}
      ],
      "expected_status": 1, "expected_stdout_text": "payload: FAILED\n",
      "expected_stderr_text": "md5sum: WARNING: 1 computed checksum did NOT match\n", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-strict-status", "command": "md5sum", "args": ["-c", "--strict", "--status", "checks"], "oracle": true, "source_version": "GNU coreutils 9.11",
      "environment": {}, "normalizations": [],
      "files": [
        {"path": "payload", "content_text": "abc"},
        {"path": "checks", "content_text": "900150983cd24fb0d6963f7d28e17f72  payload\nbad line\n"}
      ],
      "expected_status": 1, "expected_stdout_text": "", "expected_stderr_text": "", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-ignore-missing", "command": "md5sum", "args": ["-c", "--quiet", "--ignore-missing", "checks"], "oracle": true, "source_version": "GNU coreutils 9.11",
      "environment": {}, "normalizations": [],
      "files": [
        {"path": "payload", "content_text": "abc"},
        {"path": "checks", "content_text": "900150983cd24fb0d6963f7d28e17f72  absent\n900150983cd24fb0d6963f7d28e17f72  payload\n"}
      ],
      "expected_status": 0, "expected_stdout_text": "", "expected_stderr_text": "", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-missing-all", "command": "md5sum", "args": ["-c", "--ignore-missing", "checks"],
      "environment": {}, "normalizations": [],
      "files": [{"path": "checks", "content_text": "900150983cd24fb0d6963f7d28e17f72  absent\n"}],
      "expected_status": 1, "expected_stdout_text": "",
      "expected_stderr_text": "md5sum: checks: no file was verified\n", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-warn", "command": "md5sum", "args": ["-cw", "checks"],
      "environment": {}, "normalizations": [],
      "files": [
        {"path": "payload", "content_text": "abc"},
        {"path": "checks", "content_text": "900150983cd24fb0d6963f7d28e17f72  payload\nbad\n"}
      ],
      "expected_status": 0, "expected_stdout_text": "payload: OK\n",
      "expected_stderr_text": "md5sum: checks: 2: improperly formatted MD5 checksum line\nmd5sum: WARNING: 1 line is improperly formatted\n", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-requires-check", "command": "md5sum", "args": ["--strict"],
      "files": [], "environment": {}, "normalizations": [],
      "expected_status": 1, "expected_stdout_text": "",
      "expected_stderr_text": "md5sum: verification options require --check\n", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-version", "command": "md5sum", "args": ["--version"],
      "files": [], "environment": {}, "normalizations": [],
      "expected_status": 0, "expected_stdout_text": "md5sum (moonbit cmd) 0.1.0\n",
      "expected_stderr_text": "", "comparison": "contract"
    },
    {
      "id": "checksum-md5sum-tag-boundary", "command": "md5sum", "args": ["--tag"],
      "files": [], "environment": {}, "normalizations": [],
      "expected_status": 1, "expected_stdout_text": "",
      "expected_stderr_text": "md5sum: unknown option: 'tag'\n", "comparison": "boundary",
      "expected_rejection": "unknown option"
    }
  ]
}
