      "args": [
        "-X"
      ],
      "stdin_text": "abc",
      "files": [],
      "environment": {
        "LC_ALL": "C"
      },
      "expected_status": 0,
      "expected_stdout_text": "0000000  61  62  63                                                    \n0000003\n",
      "expected_stderr_text": "",
      "comparison": "contract",
      "normalizations": [],
      "coverage": [
        "-X",
        "--one-byte-hex"
      ],
      "oracle": true,
      "source_version": "util-linux 2.40"
    },
    {
      "id": "hexdump-skip-stdin-boundary",
      "command": "hexdump",
      "args": [
        "-C",
        "-s2"
      ],
      "stdin_text": "abc",
      "files": [],
      "environment": {
        "LC_ALL": "C"
      },
      "expected_status": 1,
      "expected_stdout_text": "",
      "expected_stderr_contains": "skipping stdin requires a public seekable-stream API",
      "diagnostic_reason": "The public stdin API cannot distinguish seekable redirected files from pipes; nonzero skip is rejected without reading stdin.",
      "expected_rejection": "skipping stdin requires a public seekable-stream API",
      "comparison": "boundary",
      "normalizations": []
    },
