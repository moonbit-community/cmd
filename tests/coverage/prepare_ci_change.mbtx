///|
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  let args = @env.args()[1:]
  guard args is ["--base-ref", _] else {
    fail(
      "Usage: prepare_ci_change.mbtx --base-ref TARGET_REF (after staging all managed edits)",
    )
  }
  let result = @shell.Cmd(
    "moon",
    [
      "run",
      "tests/coverage/cli",
      "--target",
      "native",
      "--",
      "--scope",
      "prepare",
      ..args.to_owned(),
    ],
  ).output()
  println(result.stdout())
  if result.exit_code() != 0 {
    println(result.stderr())
    fail("scope preparation failed with status \{result.exit_code()}")
  }
}
