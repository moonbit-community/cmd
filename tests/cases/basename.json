    {
      "id": "f17-basename-unknown-option",
      "command": "basename",
      "args": [
        "--issue22-unknown",
        "sentinel"
      ],
      "stdin_text": "unconsumed input\n",
      "files": [
        {
          "path": "sentinel",
          "content_text": "retained\n"
        }
      ],
      "environment": {},
      "expected_status": 1,
      "normalizations": [],
      "comparison": "contract",
      "expected_stdout_text": "",
      "expected_stderr_text": "basename: unknown option: 'issue22-unknown'\n",
      "oracle": true,
      "source_version": "Issue #22 independently specified fixed-upstream contract; a fresh pinned Linux oracle run is required.",
      "expected_files": [
        {
          "path": "sentinel",
          "content_text": "retained\n",
          "unchanged": true
        }
      ],
      "expected_stderr_contains": "option",
      "diagnostic_reason": "Local diagnostic bytes are exact. The pinned upstream comparison asserts the error category, status, empty stdout and unchanged sentinel; getopt punctuation/help trailers are not claimed identical."
    },
