{
  "schema": 2,
  "cases": [
    {
      "id": "fs-readlink-existing",
      "command": "readlink",
      "args": [
        "-e",
        "sample"
      ],
      "files": [
        {
          "path": "sample",
          "content_hex": "610062ff"
        }
      ],
      "environment": {
        "LC_ALL": "C",
        "TZ": "UTC"
      },
      "normalizations": [
        {
          "field": "stdout",
          "rule": "working-directory",
          "comment": "Compare the fixture directory with the oracle mount."
        },
        {
          "field": "stdout",
          "rule": "path-separator",
          "comment": "Use a common path separator for comparison."
        }
      ],
      "expected_status": 0,
      "expected_stdout_text": "<WORK>/sample\n",
      "expected_stderr_text": "",
      "comparison": "contract",
      "coverage": [
        "canonicalize-existing"
      ],
      "oracle": true
    },
