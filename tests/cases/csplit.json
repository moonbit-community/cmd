{
  "schema": 2,
  "cases": [
    {
      "id": "p1-csplit-lines",
      "command": "csplit",
      "args": [
        "-",
        "2",
        "4"
      ],
      "stdin_text": "a\nb\nc\nd\n",
      "files": [],
      "environment": {},
      "expected_status": 0,
      "expected_stdout_text": "2\n4\n2\n",
      "expected_stderr_text": "",
      "comparison": "contract",
      "normalizations": [],
      "expected_files": [
        {
          "path": "xx00",
          "content_text": "a\n"
        },
        {
          "path": "xx01",
          "content_text": "b\nc\n"
        },
        {
          "path": "xx02",
          "content_text": "d\n"
        }
      ],
      "oracle": true,
      "source_version": "GNU coreutils 9.11"
    },
    {
      "id": "p1-csplit-regex-repeat",
      "command": "csplit",
      "args": [
        "-s",
        "-z",
        "-fpart-",
        "-n3",
        "-",
        "/^a/",
        "{*}"
      ],
      "stdin_text": "a\nb\na\nc\n",
      "files": [],
      "environment": {},
      "expected_status": 0,
      "expected_stdout_text": "",
      "expected_stderr_text": "",
      "comparison": "contract",
      "normalizations": [],
      "coverage": [
        "-s",
        "-z",
        "-f",
        "-n"
      ],
      "expected_files": [
        {
          "path": "part-000",
          "content_text": "a\nb\n"
        },
        {
          "path": "part-001",
          "content_text": "a\nc\n"
        }
      ],
      "oracle": true,
      "source_version": "GNU coreutils 9.11"
    },
    {
      "id": "p1-csplit-keep-failure",
      "command": "csplit",
      "args": [
        "-k",
        "-",
        "2",
        "/missing/"
      ],
      "stdin_text": "a\nb\n",
      "files": [],
      "environment": {},
      "expected_status": 1,
      "expected_stdout_text": "2\n2\n",
      "expected_stderr_contains": "match not found",
      "diagnostic_reason": "The diagnostic includes the failing pattern or command branding.",
      "comparison": "contract",
      "normalizations": [],
      "coverage": [
        "-k"
      ],
      "expected_files": [
        {
          "path": "xx00",
          "content_text": "a\n"
        },
        {
          "path": "xx01",
          "content_text": "b\n"
        }
      ]
    },
    {
      "id": "p1-csplit-cleanup-failure",
      "command": "csplit",
      "args": [
        "-",
        "2",
        "/missing/"
      ],
      "stdin_text": "a\nb\n",
      "files": [],
      "environment": {},
      "expected_status": 1,
      "expected_stdout_text": "2\n2\n",
      "expected_stderr_contains": "match not found",
      "diagnostic_reason": "The diagnostic includes the failing pattern or command branding.",
      "comparison": "contract",
      "normalizations": [],
      "expected_files": [
        {
          "path": "xx00",
          "exists": false
        },
        {
          "path": "xx01",
          "exists": false
        }
      ]
    },
    {
      "id": "p1-csplit-existing-boundary",
      "command": "csplit",
      "args": [
        "-",
        "2"
      ],
      "stdin_text": "a\nb\n",
      "files": [
        {
          "path": "xx00",
          "content_text": "keep"
        }
      ],
      "environment": {},
      "expected_status": 1,
      "expected_stdout_text": "",
      "expected_stderr_contains": "existing output is unsupported",
      "diagnostic_reason": "Output filename is included in the explicit boundary diagnostic.",
      "expected_rejection": "existing output is unsupported",
      "comparison": "contract",
      "normalizations": [],
      "expected_files": [
        {
          "path": "xx00",
          "content_text": "keep"
        }
      ]
    },
    {
      "id": "repair-alias-csplit-silent",
      "command": "csplit",
      "args": [
        "--silent",
        "-z",
        "-fpart-",
        "-n3",
        "-",
        "/^a/",
        "{*}"
      ],
      "stdin_text": "a\nb\na\nc\n",
      "files": [],
      "environment": {},
      "expected_status": 0,
      "expected_stdout_text": "",
      "expected_stderr_text": "",
      "comparison": "contract",
      "normalizations": [],
      "coverage": [
        "-s",
        "-z",
        "-f",
        "-n"
      ],
      "expected_files": [
        {
          "path": "part-000",
          "content_text": "a\nb\n"
        },
        {
          "path": "part-001",
          "content_text": "a\nc\n"
        }
      ],
      "oracle": true,
      "source_version": "Same byte/status/side-effect contract as the retained short-option case; validates the public long alias."
    }
  ]
}
