        {
          "path": "change.diff",
          "content_text": "--- input\n+++ output\n@@ -1,3 +1,3 @@\n one\n-two\n+TWO\n three\n"
        }
      ],
      "environment": {},
      "expected_status": 0,
      "expected_stdout_text": "checking file input\n",
      "expected_stderr_text": "",
      "comparison": "contract",
      "normalizations": [],
      "coverage": [
