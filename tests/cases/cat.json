    {
      "id": "cat-fixed-mtime-hardlink",
      "command": "cat",
      "args": [
        "source",
        "alias"
      ],
      "files": [
        {
          "path": "source",
          "content_text": "data\n",
          "mtime": "202001010000.00",
          "mode": 384
        },
        {
          "path": "alias",
          "kind": "hardlink",
          "target": "source",
          "mtime": "202001010000.00"
        }
      ],
      "environment": {},
      "normalizations": [],
      "expected_status": 0,
      "observe": [
        "mode",
        "identity",
        "mtime"
      ],
      "host_platforms": [
        "posix"
      ],
      "source_version": "GNU coreutils 9.11",
      "comparison": "contract",
      "oracle": true,
      "expected_stderr_text": "",
      "expected_stdout_text": "data\ndata\n",
      "expected_files": [
        {
          "path": "source",
          "kind": "file",
          "content_text": "data\n",
          "mtime": "1577836800:0",
          "unchanged": true
        },
        {
          "path": "alias",
          "kind": "file",
          "content_text": "data\n",
          "same_identity_as": "source",
          "mtime": "1577836800:0",
          "unchanged": true
        }
      ]
    },
