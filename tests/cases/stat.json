      "args": [
        "-c",
        "%n %s %F %%",
        "sample",
        "empty"
      ],
      "files": [
        {
          "path": "sample",
          "content_hex": "610062ff"
        },
        {
          "path": "empty",
          "content_text": ""
        }
      ],
      "environment": {
        "LC_ALL": "C",
        "TZ": "UTC"
      },
      "normalizations": [],
      "expected_status": 0,
      "expected_stdout_text": "sample 4 regular file %\nempty 0 regular empty file %\n",
      "expected_stderr_text": "",
      "comparison": "contract",
      "coverage": [
        "format"
