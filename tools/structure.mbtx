----
import {
  "moonbitlang/async@0.22.9",
  "moonbitlang/async@0.22.9/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
fn snake_case(name : String) -> Bool {
  !name.is_empty() && name.iter().all(c => c is ('a'..<='z' | '0'..<='9' | '_'))
}

///|
fn pascal_case(name : String) -> Bool {
  guard !name.is_empty() && name[0] is ('A'..<='Z') else { return false }
  let mut capitals = 0
  for char in name.iter() {
    guard char is ('A'..<='Z' | 'a'..<='z' | '0'..<='9') else { return false }
    if char is ('A'..<='Z') {
      capitals += 1
    } else {
      capitals = 0
    }
    if capitals > 2 {
      return false
    }
  }
  capitals < 2
}

///|
fn check_identifiers(
  source : String,
  file : String,
  errors : Array[String],
) -> Unit {
  for block in source.split("///|") {
    if block
      .split("\n")
      .any(line => {
        let line = line.trim()
        [
          "enum ", "priv enum ", "pub enum ", "pub(all) enum ", "suberror ", "priv suberror ",
          "pub suberror ", "pub(all) suberror ",
        ].any(prefix => line.has_prefix(prefix))
      }) {
      for line in block.split("\n") {
        if line.has_prefix("  ") && !line.has_prefix("    ") {
          let text = line.trim()
          if !text.is_empty() && text[0] is ('A'..<='Z') {
            let name = text
              .split("(")
              .next()
              .unwrap()
              .split(" ")
              .next()
              .unwrap()
              .to_owned()
            if !pascal_case(name) {
              errors.push("variant is not PascalCase: " + file + ": " + name)
            }
          }
        }
      }
    }
  }
  for line in source.split("\n") {
    let text = line.trim()
    let text = text.strip_prefix("pub(all) ").unwrap_or(text)
    let text = text.strip_prefix("pub ").unwrap_or(text)
    let text = text.strip_prefix("priv ").unwrap_or(text)
    let text = text.strip_prefix("async ").unwrap_or(text)
    if text.strip_prefix("const ") is Some(binding) {
      let name = binding.split(" ").next().unwrap()
      if !name.iter().all(char => char is ('A'..<='Z' | '0'..<='9' | '_')) {
        errors.push(
          "constant is not SCREAMING_SNAKE_CASE: " +
          file +
          ": " +
          name.to_owned(),
        )
      }
    }
    for kind in ["struct ", "enum ", "suberror ", "trait ", "type "] {
      if text.strip_prefix(kind) is Some(binding) {
        let name = binding
          .split(" ")
          .next()
          .unwrap()
          .split("[")
          .next()
          .unwrap()
          .split("(")
          .next()
          .unwrap()
          .split(",")
          .next()
          .unwrap()
          .to_owned()
        if !pascal_case(name) {
          errors.push("type is not PascalCase: " + file + ": " + name)
        }
      }
    }
    if text.has_prefix("fn ") || text.has_prefix("fn[") {
      let mut offset = 2
      if text.has_prefix("fn[") {
        let mut depth = 0
        while offset < text.length() {
          if text[offset] == '[' {
            depth += 1
          }
          if text[offset] == ']' {
            depth -= 1
          }
          offset += 1
          if depth == 0 {
            break
          }
        }
      }
      let name = text[offset:]
        .trim()
        .split("(")
        .next()
        .unwrap()
        .split("[")
        .next()
        .unwrap()
        .split("::")
        .last()
        .unwrap()
        .trim()
        .split(" ")
        .next()
        .unwrap()
        .to_owned()
      if !snake_case(name) {
        errors.push("function is not snake_case: " + file + ": " + name)
      }
    }
  }
}

///|
async fn check_package(path : String, errors : Array[String]) -> Unit {
  let names = @fs.readdir(path)
  for name in names {
    if name.has_prefix(".") || ["_build", "target", "fixtures"].contains(name) {
      continue
    }
    let file = path + "/" + name
    match @fs.kind(file, follow_symlink=false) {
      Directory => {
        if @fs.exists(file + "/moon.pkg") && !snake_case(name) {
          errors.push("package name is not snake_case: " + file)
        }
        check_package(file, errors)
      }
      Regular if name.has_suffix(".mbt") => {
        let stem = name.strip_suffix(".mbt").unwrap().to_owned()
        if !snake_case(stem) ||
          ["misc", "utils"].contains(stem) ||
          stem.contains("coverage") ||
          stem.contains("comprehensive") {
          errors.push(
            "source name does not describe its responsibility: " + file,
          )
        }
        let source = @fs.read_file(file).text()
        check_identifiers(source, file, errors)
        if (path.has_prefix("commands/") || path.has_prefix("core/")) &&
          (source.contains("tests/fixtures") || source.contains("/moon.work")) {
          errors.push(
            "product package depends on workspace test inputs: " + file,
          )
        }
        for line in source.split("\n") {
          if (line.has_prefix("test \"") || line.has_prefix("async test \"")) &&
            (
              line.contains("coverage:") ||
              line.contains("coverage_98") ||
              line.contains("comprehensive")
            ) {
            errors.push(
              "test name does not describe its obligation: " +
              file +
              ": " +
              line.to_owned(),
            )
          }
        }
      }
      _ => ()
    }
  }
}

///|
async fn check_root(command : String, errors : Array[String]) -> Unit {
  let root = "commands/" + command
  if !@fs.exists(root + "/internal/driver/moon.pkg") {
    errors.push("missing command driver: " + command)
    return
  }
  let main = @fs.read_file(root + "/main.mbt").text()
  if !main.contains("@driver.") || main.split("\n").count() > 20 {
    errors.push("root is not a thin driver entry: " + command)
  }
  for name in @fs.readdir(root) {
    if name.has_suffix(".mbt") && name != "main.mbt" {
      errors.push("flat command implementation or test: " + root + "/" + name)
    }
  }
  let config = @fs.read_file(root + "/internal/driver/moon.pkg").text()
  if !config.contains("input: \"../../moon.mod\"") ||
    !config.contains("output: \"version.mbt\"") {
    errors.push("version generation must use the owning moon.mod: " + command)
  }
}

///|
async fn main {
  let selection = @env.args()[1:].to_owned()
  let commands : Array[String] = []
  for name in @fs.readdir("commands") {
    if !name.has_prefix(".") &&
      @fs.kind("commands/" + name, follow_symlink=false) is Directory &&
      @fs.exists("commands/" + name + "/moon.mod") {
      commands.push(name)
    }
  }
  commands.sort()
  assert_eq(commands.length(), 82)
  let errors : Array[String] = []
  for command in commands {
    if !selection.is_empty() && !selection.contains(command) {
      continue
    }
    check_root(command, errors)
    check_package("commands/" + command, errors)
  }
  if selection.is_empty() {
    for path in ["core", "tests", "tools"] {
      check_package(path, errors)
    }
  }
  for error in errors {
    println(error)
  }
  guard errors.is_empty() else {
    fail("structure checks failed: \{errors.length()}")
  }
  println(
    "Structure, responsibility names and package fixture boundaries passed",
  )
}
