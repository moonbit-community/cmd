///|
fn parser_table(table : Table, options : Array[OptionMetadata]) -> String {
  let out = StringBuilder()
  let argparse = table.kind is Some("flags" | "options")
  let type_ = if table.kind == Some("flags") {
    "FlagArg"
  } else if table.kind == Some("options") {
    "OptionArg"
  } else {
    "OptionSpec"
  }
  out.write_string(
    "///|\nfn " +
    table.function_name +
    "() -> Array[@" +
    table.import_alias +
    "." +
    type_ +
    "] {\n  [\n",
  )
  for name in table.options {
    let option = options
      .iter()
      .find_first(option => option.name == name)
      .unwrap()
    let kind = if argparse {
      type_
    } else if option.value == "none" {
      "flag"
    } else {
      "option"
    }
    out.write_string(
      "    @" +
      table.import_alias +
      "." +
      kind +
      "(" +
      quoted(option.parser_name.unwrap_or(option.name)),
    )
    if option.short is Some(short) {
      out.write_string(", short='" + short + "'")
    }
    if argparse {
      if option.parser_long is Some(long) {
        out.write_string(", long=" + quoted(long))
      }
      if option.parser_action is Some(action) {
        out.write_string(", action=" + action)
      }
      if option.allow_hyphen_values is Some(true) {
        out.write_string(", allow_hyphen_values=true")
      }
    } else if !option.repeatable {
      out.write_string(", repeatable=false")
    }
    if kind == "option" && !option.allow_attached {
      out.write_string(", allow_attached=false")
    }
    out.write_string("),\n")
  }
  out.write_string("  ]\n}\n")
  out.to_string()
}

///|
fn option_table(options : Array[OptionMetadata]) -> String {
  let out = StringBuilder()
  out.write_string(
    "<!-- Generated by tools/metadata from options.json. -->\n\n| Option | Value | Description |\n| --- | --- | --- |\n",
  )
  for option in options {
    let negated = match option.rg {
      Some(rg) => rg.negated
      None => None
    }
    let aliases = option.aliases
      .filter(spelling => Some(spelling) != negated.map(name => "--" + name))
      .map(spelling => "`" + spelling.replace_all(old="|", new="&#124;") + "`")
      .join(" / ")
    let description = (option.support_note.unwrap_or("") + option.description)
      .replace_all(old="|", new="&#124;")
      .replace_all(old="\n", new=" ")
    let default_value = match option.default_value {
      Some(value) => {
        let display = if value.is_empty() ||
          value.iter().any(char => char is (' ' | '\t' | '\n' | '\r')) {
          quoted(value)
        } else {
          value
        }
        " Default: `" + display + "`."
      }
      None => ""
    }
    out.write_string(
      "| " +
      aliases +
      " | " +
      option.value +
      " | " +
      description +
      default_value +
      " |\n",
    )
    if negated is Some(name) {
      out.write_string(
        "| `--" + name + "` | none | Disable `--" + option.name + "`. |\n",
      )
    }
  }
  out.to_string()
}

///|
async fn generate(metadata : Metadata, check : Bool) -> Unit {
  let root = "commands/" + metadata.command
  let version = module_field(root + "/moon.mod", "version")
  assert_eq(module_field(root + "/moon.mod", "name"), "cli/" + metadata.command)
  let name = root + "/internal/driver/options_generated.mbt"
  let out = StringBuilder()
  out.write_string(
    "// Generated by tools/metadata from options.json. Do not edit.\n\n",
  )
  if ![
      "cksum", "md5sum", "sha1sum", "sha256sum", "sha512sum", "gzip", "gunzip", "zcat",
      "rg", "serve",
    ].contains(metadata.command) {
    out.write_string(
      "///|\nfn metadata_help() -> String {\n  " + quoted(render_help(metadata)),
    )
    if metadata.help.contains("{{version}}") {
      out.write_string(".replace_all(old=\"{{version}}\", new=MODULE_VERSION)")
    }
    out.write_string("\n}\n")
  }
  for table in metadata.tables {
    out.write_string("\n" + parser_table(table, metadata.options))
  }
  if metadata.adapter_match == Some(true) {
    out.write_string(
      "\n///|\nfn metadata_option_matches(name : String, spelling : String) -> Bool {\n  match name {\n",
    )
    for option in metadata.options {
      out.write_string(
        "    " +
        quoted(option.name) +
        " => [" +
        option.aliases.map(quoted).join(", ") +
        "].contains(spelling)\n",
      )
    }
    out.write_string("    _ => false\n  }\n}\n")
  }
  for option in metadata.options {
    if option.default_binding is Some(binding) {
      let value = option.default_value.unwrap()
      if binding.variant is Some(variant) {
        out.write_string(
          "\n///|\nfn " +
          binding.name.to_lower() +
          "() -> " +
          binding.type_ +
          " { " +
          variant +
          " }\n",
        )
        continue
      }
      let literal = if binding.type_ == "String" {
        quoted(value)
      } else if binding.type_ == "Bytes" {
        "b" + quoted(value)
      } else {
        value
      }
      let scaled = match binding.scale {
        Some(scale) => literal + " * " + scale.to_string()
        None => literal
      }
      out.write_string(
        "\n///|\nconst " +
        binding.name +
        " : " +
        binding.type_ +
        " = " +
        scaled +
        "\n",
      )
    }
  }
  if metadata.command == "typst" {
    out.write_string(typst_arguments(metadata.options))
    let help = StringBuilder()
    help.write_string(
      "// Generated by tools/metadata from options.json.\n// Help text retains the pinned upstream Typst provenance; see NOTICE.\n\n///|\nlet help_texts : ReadOnlyArray[(String, Bool, String)] = [\n",
    )
    guard metadata.help_variants is Some(variants) && variants.length() == 20 else {
      fail("missing Typst help variants")
    }
    for variant in variants {
      help.write_string(
        "  (" +
        quoted(variant.command) +
        ", " +
        variant.long.to_string() +
        ", " +
        quoted(render_help_text(metadata, variant.text)) +
        "),\n",
      )
    }
    help.write_string("]\n")
    output(root + "/internal/driver/help_gen.mbt", help.to_string(), check)
  }
  if metadata.command == "serve" {
    out.write_string(
      "\n///|\nfn command_options() -> Array[@argparse.OptionArg] {\n  [\n",
    )
    for option in metadata.options {
      if ["help", "version"].contains(option.name) {
        continue
      }
      out.write_string(
        "    @argparse.OptionArg(" +
        quoted(option.name) +
        ", long=" +
        quoted(option.name) +
        ", about=" +
        quoted(option.description),
      )
      if option.short is Some(short) {
        out.write_string(", short='" + short + "'")
      }
      if option.default_value is Some(value) {
        out.write_string(", default_values=[" + quoted(value) + "]")
      }
      if option.allow_hyphen_values is Some(true) {
        out.write_string(", allow_hyphen_values=true")
      }
      out.write_string("),\n")
    }
    out.write_string("  ]\n}\n")
  }
  output(name, out.to_string(), check)
  if metadata.command == "rg" {
    generate_rg(metadata.options, check)
  }
  let readme_path = root + "/README.md"
  let readme = @fs.read_file(readme_path).text()
  output(readme_path, readme_with_options(readme, metadata.options), check)
  // The build rule remains authoritative for compilation; this check catches
  // stale shipped constants without reading source metadata at runtime.
  let version_source = @fs.read_file(root + "/internal/driver/version.mbt").text()
  guard version_source.contains(quoted(version)) else {
    fail("generated version drift: " + metadata.command)
  }
}

///|
fn readme_with_options(
  readme : String,
  options : Array[OptionMetadata],
) -> String raise {
  let marker = "<!-- BEGIN GENERATED OPTIONS -->"
  guard readme.find(marker) is Some(start) else {
    fail("missing generated options start marker")
  }
  let after_marker = start + marker.length()
  let newline = if readme[after_marker:].has_prefix("\r\n") {
    "\r\n"
  } else if readme[after_marker:].has_prefix("\n") {
    "\n"
  } else {
    fail("generated options start marker must end its line")
  }
  let content_start = after_marker + newline.length()
  guard readme[content_start:].find("<!-- END GENERATED OPTIONS -->")
    is Some(offset) else {
    fail("missing generated options end marker")
  }
  let end = content_start + offset
  readme[:content_start].to_owned() +
  option_table(options).replace_all(old="\n", new=newline) +
  readme[end:].to_owned()
}

///|
async fn generate_rg(options : Array[OptionMetadata], check : Bool) -> Unit {
  let out = StringBuilder()
  out.write_string(
    "// Generated by tools/metadata from options.json.\n// Flag descriptions retain their ripgrep provenance; see NOTICE.\n\n///|\nlet flag_defs : Array[FlagDef] = [\n",
  )
  for option in options {
    guard option.rg is Some(rg) else {
      fail("missing rg flag metadata: " + option.name)
    }
    let optional = fn(value : String?) -> String {
      match value {
        Some(value) => "Some(" + quoted(value) + ")"
        None => "None"
      }
    }
    let aliases = option.aliases
      .filter_map(spelling => {
        spelling.strip_prefix("--").map(StringView::to_owned)
      })
      .filter(spelling => {
        spelling != option.name && Some(spelling) != rg.negated
      })
    let short = match option.short {
      Some(value) => "Some('" + value + "')"
      None => "None"
    }
    out.write_string(
      "  {\n    is_switch: " +
      (option.value == "none").to_string() +
      ",\n    name_short: " +
      short +
      ",\n    name_long: " +
      quoted(option.name) +
      ",\n    aliases: [" +
      aliases.map(quoted).join(", ") +
      "],\n    name_negated: " +
      optional(rg.negated) +
      ",\n    doc_variable: " +
      optional(rg.variable) +
      ",\n    doc_category: " +
      rg.category +
      ",\n    doc_short: " +
      quoted(option.description) +
      ",\n    doc_long: " +
      quoted(rg.long_help) +
      ",\n    doc_choices: [" +
      rg.choices.map(quoted).join(", ") +
      "],\n    completion_type: " +
      rg.completion +
      ",\n  },\n",
    )
  }
  out.write_string("]\n")
  output(
    "commands/rg/internal/driver/flag_defs_data.mbt",
    out.to_string(),
    check,
  )
}

///|
async fn generate_catalog(metadata : Array[Metadata], check : Bool) -> Unit {
  let out = StringBuilder()
  out.write_string(
    "// Generated by tools/metadata from command options.json declarations.\n\n///|\nfn command_options(name : String) -> Array[String] {\n  match name {\n",
  )
  for row in metadata {
    out.write_string(
      "    " +
      quoted(row.command) +
      " => [" +
      row.catalog_options.map(quoted).join(", ") +
      "]\n",
    )
  }
  out.write_string(
    "    _ => abort(\"unregistered command option declaration\")\n  }\n}\n",
  )
  output("tests/harness/catalog/options_generated.mbt", out.to_string(), check)
}
