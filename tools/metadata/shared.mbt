///|
async fn generate_shared(declarations : Array[Metadata], check : Bool) -> Unit {
  let get = fn(name : String) -> Metadata {
    declarations.iter().find_first(row => row.command == name).unwrap()
  }
  let checksum = get("cksum")
  let fixed = get("sha256sum")
  let common = [
    "check", "zero", "binary", "text", "tag", "quiet", "status", "strict", "warn",
    "ignore-missing", "help", "version",
  ]
  let extra = ["algorithm", "length", "untagged", "base64", "raw"]
  let table = fn(
    names : Array[String],
    options : Array[OptionMetadata],
    function_name : String,
  ) -> String {
    parser_table(
      {
        kind: None,
        function_name,
        source: "shared",
        import_alias: "args",
        options: names,
      },
      options,
    )
  }
  for name in ["md5sum", "sha1sum", "sha256sum", "sha512sum"] {
    let current = get(name)
    assert_eq(
      render_help(current).replace(old=name, new="sha256sum"),
      render_help(fixed),
    )
    assert_eq(
      table(common, current.options, "common_options"),
      table(common, fixed.options, "common_options"),
    )
  }
  let checksum_source = "// Generated by tools/metadata from checksum command declarations.\n\n" +
    table(common, fixed.options, "common_options") +
    "\n" +
    table(extra, checksum.options, "modern_options") +
    "\n///|\nfn checksum_options(modern : Bool) -> Array[@args.OptionSpec] {\n  let options = common_options()\n  if modern { options.append(modern_options()) }\n  options\n}\n" +
    "\n///|\nfn help_message(command : String, modern : Bool) -> String {\n  let text = if modern {\n    " +
    quoted(render_help(checksum).replace(old="cksum", new="{{command}}")) +
    "\n  } else {\n    " +
    quoted(render_help(fixed).replace(old="sha256sum", new="{{command}}")) +
    "\n  }\n  text.replace(old=\"{{command}}\", new=command)\n}\n"
  output("core/checksum/cli/options_generated.mbt", checksum_source, check)
  let gzip = get("gzip")
  let compression = [
    "stdout", "decompress", "test", "no-name", "quiet", "fast", "2", "3", "4", "5",
    "6", "7", "8", "best", "help", "version",
  ]
  for name in ["gunzip", "zcat"] {
    let current = get(name)
    assert_eq(
      render_help(current).replace(old="Usage: " + name, new="Usage: gzip"),
      render_help(gzip),
    )
    assert_eq(
      table(compression, current.options, "compression_options"),
      table(compression, gzip.options, "compression_options"),
    )
  }
  output(
    "core/gzipops/cli/options_generated.mbt",
    "// Generated by tools/metadata from compression command declarations.\n\n" +
    table(compression, gzip.options, "compression_options") +
    "\n///|\nfn help(command : String) -> String {\n  " +
    quoted(
      render_help(gzip).replace(old="Usage: gzip", new="Usage: {{command}}"),
    ) +
    ".replace(old=\"{{command}}\", new=command)\n}\n",
    check,
  )
}
