----
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}
----

///|
struct Case { id : String; args : Array[String]; input : String; status : Int; stdout : String; stderr_contains : String } derive(ToJson)

///|
async fn main {
  let root = @fs.tmpdir(prefix="rg-cli-contract-")
  defer @fs.rmdir(root, recursive=true)
  let path = root + "/haystack"
  @fs.write_file(path, b"alpha\nbeta alpha\nomega\n")
  let cases : Array[Case] = [
    { id: "version", args: ["--version"], input: "unread\n", status: 0, stdout: "rg 0.1.0\n", stderr_contains: "" },
    { id: "file-lines", args: ["-n", "alpha", path], input: "", status: 0, stdout: "1:alpha\n2:beta alpha\n", stderr_contains: "" },
    { id: "explicit-stdin", args: ["-n", "alpha", "-"], input: "alpha\nother\n", status: 0, stdout: "1:alpha\n", stderr_contains: "" },
    { id: "stdin-detection-boundary", args: ["alpha"], input: "alpha\n", status: 2, stdout: "", stderr_contains: "specify a path or -" },
    { id: "missing-match", args: ["missing", path], input: "", status: 1, stdout: "", stderr_contains: "" },
    { id: "maximum-count", args: ["-m", "1", "alpha", path], input: "", status: 0, stdout: "alpha\n", stderr_contains: "" },
    { id: "only-matching", args: ["-o", "alpha", path], input: "", status: 0, stdout: "alpha\nalpha\n", stderr_contains: "" },
    { id: "count", args: ["-c", "alpha", path], input: "", status: 0, stdout: "2\n", stderr_contains: "" },
    { id: "context", args: ["-A", "1", "^alpha", path], input: "", status: 0, stdout: "alpha\nbeta alpha\n", stderr_contains: "" },
    { id: "device-identity-boundary", args: ["--one-file-system", "alpha", path], input: "", status: 2, stdout: "", stderr_contains: "device/inode" },
  ]
  for flag in ["-z", "--search-zip", "-zz"] {
    cases.push({ id: "compression-boundary-" + flag, args: [flag, "alpha", path], input: "", status: 2, stdout: "", stderr_contains: "compressed search (-z/--search-zip) is deferred" })
  }
  if @env.get_env_var("RG_LOCAL_PREPROCESSOR_PROBES") == Some("1") {
    cases.push({ id: "preprocessor", args: ["--pre", "/bin/cat", "alpha", path], input: "", status: 0, stdout: "alpha\nbeta alpha\n", stderr_contains: "" })
    cases.push({ id: "preprocessor-early-stop", args: ["-q", "--pre", "/usr/bin/yes", "haystack", path], input: "", status: 0, stdout: "", stderr_contains: "" })
  }
  let report = StringBuilder()
  let mut failures = 0
  for backend in ["native", "wasm"] {
   for case in cases {
    let args = if backend == "wasm" { ["_build/wasm/release/build/cli/rg/rg.wasm", "--"] } else { [] }
    args.append(case.args)
    let program = if backend == "wasm" { "moonrun" } else { "_build/native/debug/build/cli/rg/rg.exe" }
    let result = @shell.Cmd(program, args, stdin=Text(case.input)).output(timeout_ms=15000)
    let passed = result.exit_code() == case.status && result.stdout() == case.stdout &&
      (if case.stderr_contains == "" { result.stderr() == "" } else { result.stderr().contains(case.stderr_contains) })
    if !passed { failures += 1 }
    let label = if passed { "pass" } else { "FAIL" }
    println("\{backend} \{case.id}: \{label}")
    let row : Json = { "id": case.id, "backend": backend, "comparison": "contract", "passed": passed,
      "status": result.exit_code(), "stdout": result.stdout(), "stderr": result.stderr() }
    report.write_string(row.stringify() + "\n")
  }
  }
  @fs.mkdir("test-reports/rg-smoke", recursive=true, allow_exist=true)
  @fs.write_file("test-reports/rg-smoke/cases.jsonl", @utf8.encode(report.to_string()))
  assert_eq(failures, 0, msg="Every selected Native/Wasm contract is mandatory")
}
