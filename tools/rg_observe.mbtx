----
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
async fn main {
  let args = @env.args()
  guard args.length() == 4 else { fail("Usage: rg_observe.mbtx RG_SOURCE ORACLE_SOURCE LOG_PREFIX") }
  let source = args[1]
  let oracle = args[2]
  let prefix = args[3]
  let report = StringBuilder()
  let outcomes : Map[String, Map[String, String]] = Map([])
  for backend in ["native", "wasm"] {
    let log = @fs.read_file(prefix + backend + "-isolated.log").text()
    let result : Map[String, String] = Map([])
    let blocks : Map[String, String] = Map([])
    for block in log.split("---- ") {
      if block.find(" stdout ----") is Some(end) {
        blocks[block[:end].to_owned()] = block.to_owned()
      }
    }
    let counts : Map[String, Int] = Map([])
    for line in log.split("\n") {
      if line.strip_prefix("test ") is Some(row) && row.find(" ... ") is Some(end) {
        let name = row[:end].to_owned()
        let status = row[end + 5:].to_owned()
        let detail = blocks.get(name).unwrap_or("")
        let category = if name.split("::").last().unwrap_or("").has_prefix("z") &&
          (name.contains("::zflag") || name.contains("::z_")) {
          "deferred-compression"
        } else if status == "ok" { "observer-pass" }
        else if detail.contains("stdin type detection requires") ||
          ["feature::f948_exit_code_match", "feature::f948_exit_code_no_match", "misc::include_zero", "regression::r1159_exit_status"].contains(name) { "boundary-stdin-detection" }
        else if detail.contains("compressed search (-z/--search-zip) is deferred") { "deferred-compression" }
        else { "unresolved" }
        result[name] = category
        counts[category] = counts.get(category).unwrap_or(0) + 1
        let row : Json = { "id": name, "backend": backend, "harness_status": status,
          "disposition": category, "comparison": "fixed-upstream-integration-observer",
          "oracle_revision": "3fce3b5bb0236da2df6d99672afb8a719642eca7" }
        report.write_string(row.stringify() + "\n")
        if category == "unresolved" { println(backend + " " + name + "\n" + detail) }
      }
    }
    outcomes[backend] = result
    println(backend + " " + Json(counts).stringify())
  }
  @fs.write_file("docs/rg/upstream-observation.jsonl", report.to_string())
  let mapping = StringBuilder()
  mapping.write_string("upstream_id\tsource\tnative\twasm\tregistry\n")
  for file in ["binary", "feature", "json", "misc", "multiline", "regression", "index/basic", "index/disallowed"] {
    let text = @fs.read_file(oracle + "/tests/" + file + ".rs").text()
    for part in text.split("rgtest!(").drop(1) {
      if part.find(",") is Some(end) {
        let name = part[:end].trim().to_owned()
        let id = file.replace_all(old="/", new="::") + "::" + name
        mapping.write_string(id + "\ttests/" + file + ".rs\t" +
          outcomes["native"].get(id).unwrap_or("not-selected-by-host-or-feature-cfg") + "\t" +
          outcomes["wasm"].get(id).unwrap_or("not-selected-by-host-or-feature-cfg") +
          "\ttests/cases/rg.json; metadata:rg; retained package tests\n")
      }
    }
  }
  @fs.write_file("docs/rg/upstream-tests.tsv", mapping.to_string())
  let listing = @shell.Cmd("git", ["ls-files"], cwd=source).output()
  listing.check()
  let packages = StringBuilder()
  packages.write_string("source_test_file\tdestination\tstatus\n")
  for line in listing.stdout().split("\n") {
    let path = line.to_owned()
    if !path.has_suffix("_test.mbt") && !path.has_suffix("_wbtest.mbt") && !path.has_suffix(".mbt.md") { continue }
    let mapped = path.replace_all(old="core/", new="driver/")
    let dest = if path.has_prefix("sys/") { "commands/rg/internal/sys/" + path.strip_prefix("sys/").unwrap().to_owned() }
      else if path == "cli/decompress_test.mbt" { "experiments/rg-compression/integration/decompress_test.mbt.source" }
      else { "commands/rg/internal/" + mapped }
    packages.write_string(path + "\t" + dest + "\t" +
      (if @fs.exists(dest) { "retained-and-adapted" } else { "needs-disposition" }) + "\n")
  }
  @fs.write_file("docs/rg/package-tests.tsv", packages.to_string())
  let flags = @fs.read_file("commands/rg/internal/driver/flag_defs_data.mbt").text()
  let options = StringBuilder()
  options.write_string("option\timplementation\tpackage_test_family\tcli_contract_index\tdisposition\n")
  for line in flags.split("\n") {
    if line.trim().strip_prefix("name_long: \"") is Some(value) && value.find("\"") is Some(end) {
      let name = value[:end].to_owned()
      let disposition = match name {
        "search-zip" => "deferred-explicit-status-2"
        "one-file-system" => "boundary-public-device-identity"
        "pcre2" | "pcre2-version" | "no-pcre2-unicode" => "inherited-no-pcre2"
        "mmap" => "inherited-no-real-mmap"
        "threads" => "inherited-single-thread"
        "sort" | "sortr" => "creation-time-boundary-other-orders-retained"
        _ => "retained-parser-and-algorithm"
      }
      options.write_string("--" + name + "\tinternal/driver; internal/searcher; internal/printer; internal/ignore\tflags/*; retained package tests\ttests/cases/rg.json\t" + disposition + "\n")
    }
  }
  @fs.write_file("docs/rg/options.tsv", options.to_string())
}
