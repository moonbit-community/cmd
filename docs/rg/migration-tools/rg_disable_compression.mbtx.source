----
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
}
----

///|
async fn main {
  let archive = "experiments/rg-compression"
  guard @fs.exists(archive + "/SHA256SUMS") else { fail("Create the verified compression snapshot first") }
  let path = "commands/rg/internal/driver/search.mbt"
  let source = @fs.read_file(path).text()
  let blocks = source.split("///|").filter(block =>
    !["priv struct DecompressReader", "impl @searcher.Reader for DecompressReader",
      "fn SearchWorker::should_decompress(", "fn SearchWorker::search_decompress("].any(marker => block.contains(marker)))
    .map(block => block.to_owned()).collect()
  let mut next = blocks.join("///|")
  let start = next.find("  let decomp = if self.search_zip {")
  if start is Some(start) {
    let after = start + next[start:].find("\n  {\n    preprocessor:").unwrap()
    next = next[:start].to_owned() + next[after:].to_owned()
  }
  next = next.replace_all(old="  decomp : @cli.DecompressionMatcher?\n", new="")
    .replace_all(old="    decomp,\n", new="")
    .replace_all(old="self.pre.map(@cli.resolve_binary)", new="self.pre")
    .replace_all(old="  } else if self.should_decompress(path) {\n    self.search_decompress(path)", new="")
    .replace_all(old="    @codec.DecodeError(message) => message\n", new="")
    .replace_all(old=") -> SearchWorker raise RgError {", new=") -> SearchWorker {")
    .replace_all(old="including preprocessors and decompression.", new="including user-specified preprocessors.")
  @fs.write_file(path, @utf8.encode(next))
  let input = @fs.read_file("commands/rg/internal/cli/decompress.mbt").text()
  let utility = input.split("///|").filter(block =>
    ["fn is_readable_stdin(", "fn hostname(", "fn patterns_from_path(", "fn patterns_from_stdin("].any(marker => block.contains(marker)))
    .map(block => "///|" + block.to_owned()).collect().join("")
  @fs.write_file("commands/rg/internal/cli/input.mbt", @utf8.encode(utility))
  @fs.remove("commands/rg/internal/cli/decompress.mbt")
  // Compression source remains byte-for-byte in the separately scoped snapshot.
  @fs.rmdir("commands/rg/internal/codec", recursive=true)
  for pkg in ["commands/rg/internal/driver/moon.pkg", "commands/rg/internal/cli/moon.pkg"] {
    let config = @fs.read_file(pkg).text().replace_all(old="  \"cli/rg/internal/codec/stream\" @codec,\n", new="")
    @fs.write_file(pkg, @utf8.encode(config))
  }
  let mod_path = "commands/rg/moon.mod"
  let config = @fs.read_file(mod_path).text().replace_all(old="  \"moonbit-community/flate@0.9.0\",\n", new="")
  @fs.write_file(mod_path, @utf8.encode(config))
}
