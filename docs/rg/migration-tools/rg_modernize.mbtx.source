----
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
}
----

///|
fn rewrite_try(source : String) -> String {
  let output = StringBuilder()
  let mut pos = 0
  while source[pos:].find("try?") is Some(relative) {
    let start = pos + relative
    output.write_string(source[pos:start].to_owned())
    let mut cursor = start + 4
    while cursor < source.length() && source[cursor] == ' ' { cursor += 1 }
    let expression = cursor
    let mut depth = 0
    let mut quoted = false
    let mut escaped = false
    let mut opened = false
    while cursor < source.length() {
      let char = source[cursor]
      if quoted {
        if escaped { escaped = false } else if char == '\\' {
          escaped = true
        } else if char == '"' { quoted = false }
      } else if char == '"' { quoted = true } else {
        if char == '(' || char == '{' || char == '[' {
          opened = true
          depth += 1
        } else if char == ')' || char == '}' || char == ']' {
          depth -= 1
          if opened && depth == 0 { cursor += 1; break }
        } else if char == '\n' && depth == 0 { break }
      }
      cursor += 1
    }
    output.write_string("(try Ok(")
    output.write_string(source[expression:cursor].to_owned())
    output.write_string(") catch { e => Err(e) })")
    pos = cursor
  }
  output.write_string(source[pos:].to_owned())
  output.to_string()
}

///|
async fn visit(root : String) -> Unit {
  for name in @fs.readdir(root, include_hidden=true) {
    let path = root + "/" + name
    if @fs.kind(path, follow_symlink=false) is Directory {
      visit(path)
    } else if path.has_suffix(".mbt") {
      let source = @fs.read_file(path).text()
      let mut next = rewrite_try(source)
        .replace_all(old="Bytes::default()", new="b\"\"")
        .replace_all(old="Ref::new(", new="Ref(")
        .replace_all(old="derive(Show)", new="derive(Debug)")
        .replace_all(old="derive(Eq, Show)", new="derive(Eq, Debug)")
        .replace_all(old="derive(Show, Eq)", new="derive(Debug, Eq)")
        .replace_all(old="(try Ok(", new="(try Result::Ok(")
        .replace_all(old="catch { e => Err(e) })", new="catch { e => Result::Err(e) })")
        .replace_all(old="data.to_bytes()", new="data.to_owned()")
        .replace_all(old="\\{err}", new="\\{Repr(err)}")
        .replace_all(old="\\{other}", new="\\{Repr(other)}")
        .replace_all(old="\\{e}", new="\\{Repr(e)}")
      if name.has_suffix("_test.mbt") {
        for (kind, pkg_alias) in [("BrotliError", "brotli"), ("Lz4Error", "lz4"), ("ZstdError", "zstd"), ("Bzip2Error", "bzip2")] {
          next = next.replace_all(old=kind + "::", new="@" + pkg_alias + "." + kind + "::")
            .replace_all(old="@" + pkg_alias + ".@" + pkg_alias + ".", new="@" + pkg_alias + ".")
        }
        for expr in ["compressed.length() < data.length()", "c1.length() < data.length()", "c0.length() > 0", "compressed.length() > 0", "default_compressed.length() < data.length()"] {
          next = next.replace_all(old="guard " + expr + "\n", new="assert_true(" + expr + ")\n")
        }
      }
      if next != source { @fs.write_file(path, @utf8.encode(next)) }
    } else if name == "moon.pkg" && !root.has_suffix("/blit") {
      let source = @fs.read_file(path).text()
      if !source.contains("warnings =") {
        @fs.write_file(path, @utf8.encode(source + "\nwarnings = \"-implicit_impl_as_method-deprecated_syntax\"\n"))
      }
    }
  }
}

///|
async fn main { visit("commands/rg/internal/codec") }
