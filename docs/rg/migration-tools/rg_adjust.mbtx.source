----
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
}
----

///|
async fn main {
  for name in ["input.mbt", "process.mbt"] {
    let path = "commands/rg/internal/cli/" + name
    let source = @fs.read_file(path).text()
    let next = source.replace_all(old="raise CommandIo(e)", new="raise CommandIo(@sys.from_error(e))")
    if next != source { @fs.write_file(path, @utf8.encode(next)) }
  }
  let printer_test = "commands/rg/internal/printer/rg_compat_test.mbt"
  let printer_source = @fs.read_file(printer_test).text()
  @fs.write_file(printer_test, @utf8.encode(printer_source.replace_all(old="Some(fake_canonicalize)", new="Some(path => fake_canonicalize(path))")))
  let root = "commands/rg/internal/ignore"
  for name in @fs.readdir(root) {
    if !name.has_suffix(".mbt") { continue }
    let path = root + "/" + name
    let source = @fs.read_file(path).text()
    let mut next = source
      .replace_all(old="\"ignore/testdata/", new="\"internal/ignore/testdata/")
      .replace_all(old="IgnoreError::Io(err)", new="IgnoreError::Io(@sys.from_error(err))")
      .replace_all(old="IgnoreError::Io(e)", new="IgnoreError::Io(@sys.from_error(e))")
      .replace_all(old="if err.kind() is IsADirectory", new="if @sys.from_error(err).kind() is IsADirectory")
      .replace_all(old="Ok(md) => Some(md.dev)", new="Ok(md) => md.dev")
      .replace_all(old="  root_device == md.dev", new="  Some(root_device) == md.dev")
      .replace_all(old="err => return Some(Err(err))", new="err => return Some(Err(from_async_error(err)))")
      .replace_all(old="self.visitor.visit(Err(err))", new="self.visitor.visit(Err(from_async_error(err)))")
    if name == "path.mbt" {
      let blocks = next.split("///|").map(block => {
        if block.contains("async fn canonicalize(path : String)") {
          "\n/// Resolve paths through the released public filesystem API.\nasync fn canonicalize(path : String) -> String { @sys.canonicalize(path) }\n\n"
        } else { block.to_owned() }
      }).collect()
      next = blocks.join("///|")
    }
    if next != source { @fs.write_file(path, @utf8.encode(next)) }
  }
}
