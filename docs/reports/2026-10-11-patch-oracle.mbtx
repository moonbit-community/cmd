///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
struct Outcome {
  status : Int
  stdout : String
  stderr : String
  input_exists : Bool
  input : Bytes
  output_exists : Bool
  output : Bytes
}

///|
async fn run_one(
  executable : String,
  directory : String,
  args : Array[String],
) -> Outcome {
  let result = @shell.Cmd(executable, args, cwd=directory, env={ "LC_ALL": "C" }).output()
  let input_exists = @fs.exists(directory + "/input")
  let output_exists = @fs.exists(directory + "/new")
  {
    status: result.exit_code(),
    stdout: result.stdout(),
    stderr: result.stderr(),
    input_exists,
    input: if input_exists {
      @fs.read_file(directory + "/input").binary()
    } else {
      b""
    },
    output_exists,
    output: if output_exists {
      @fs.read_file(directory + "/new").binary()
    } else {
      b""
    },
  }
}

///|
async fn prepare(directory : String, input : Bytes, patch : Bytes) -> Unit {
  if !@fs.exists(directory) {
    @fs.mkdir(directory, recursive=true)
  }
  @fs.write_file(directory + "/input", input)
  @fs.write_file(directory + "/change.diff", patch)
}

///|
fn outcome_json(value : Outcome) -> Json raise {
  {
    "status": value.status,
    "stdout": value.stdout,
    "stderr": value.stderr,
    "input_exists": value.input_exists,
    "input": @utf8.decode(value.input),
    "output_exists": value.output_exists,
    "output": @utf8.decode(value.output),
  }
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 4 else {
    fail(
      "Usage: moon run docs/reports/2026-10-11-patch-oracle.mbtx -- ORACLE_PATCH CANDIDATE_PATCH REPORT_DIRECTORY",
    )
  }
  let oracle = @fs.realpath(args[1])
  let candidate = @fs.realpath(args[2])
  let report = args[3]
  if !@fs.exists(report) {
    @fs.mkdir(report, recursive=true)
  }
  let oracle_version = @shell.Cmd(oracle, ["--version"], env={ "LC_ALL": "C" }).output()
  guard oracle_version.exit_code() == 0 &&
    oracle_version.stdout().has_prefix("GNU patch 2.8\n") else {
    fail("oracle must be GNU patch 2.8")
  }
  let input = b"one\ntwo\nthree\n"
  let unified = b"--- input\n+++ output\n@@ -1,3 +1,3 @@\n one\n-two\n+TWO\n three\n"
  let context = b"*** input\n--- output\n***************\n*** 1,3 ****\n  one\n! two\n  three\n--- 1,3 ----\n  one\n! TWO\n  three\n"
  let reverse_input = b"one\nTWO\nthree\n"
  let create = b"--- /dev/null\n+++ b/new\n@@ -0,0 +1,2 @@\n+one\n+two\n"
  let delete = b"--- input\n+++ /dev/null\n@@ -1,3 +0,0 @@\n-one\n-two\n-three\n"
  let mut total = 0
  let failures : Array[Json] = []
  let boundaries : Array[Json] = []
  // Supported output and dry-run subset: compare bytes, diagnostics, status, and effects.
  let supported : Array[(String, Array[String], Bytes, Bytes, Bytes)] = [
    (
      "unified-output",
      ["-s", "-o", "-", "-i", "change.diff", "input"],
      input,
      unified,
      b"one\nTWO\nthree\n",
    ),
    (
      "context-output",
      ["-c", "-s", "-o", "-", "-i", "change.diff", "input"],
      input,
      context,
      b"one\nTWO\nthree\n",
    ),
    (
      "reverse-output",
      ["-R", "-s", "-o", "-", "-i", "change.diff", "input"],
      reverse_input,
      unified,
      b"one\ntwo\nthree\n",
    ),
    ("exact-dry-run", ["--dry-run", "-i", "change.diff"], input, unified, input),
    (
      "create-null",
      ["-s", "-p1", "-i", "change.diff"],
      b"",
      create,
      b"one\ntwo\n",
    ),
    ("delete-null", ["-s", "-i", "change.diff"], input, delete, b""),
  ]
  for item in supported {
    let (name, argv, fixture, patch, expected) = item
    let oracle_dir = report + "/supported-" + name + "-oracle"
    let candidate_dir = report + "/supported-" + name + "-candidate"
    prepare(oracle_dir, fixture, patch)
    prepare(candidate_dir, fixture, patch)
    let reference = run_one(oracle, oracle_dir, argv)
    let actual = run_one(candidate, candidate_dir, argv)
    total += 1
    let expected_effect = if name == "create-null" {
      actual.output_exists &&
      actual.output == expected &&
      reference.output_exists &&
      reference.output == expected
    } else if name == "delete-null" {
      !actual.input_exists && !reference.input_exists
    } else {
      true
    }
    let output_matches = if name.has_suffix("output") {
      actual.stdout == @utf8.decode(expected)
    } else {
      true
    }
    if reference.status != actual.status ||
      reference.stdout != actual.stdout ||
      reference.stderr != actual.stderr ||
      !output_matches ||
      !expected_effect ||
      (name == "exact-dry-run" && !actual.input_exists) {
      failures.push({
        "name": name,
        "expected": outcome_json(reference),
        "actual": outcome_json(actual),
        "expected_result": @utf8.decode(expected),
      })
    }
  }
  // These operations are explicit candidate boundaries because public MoonBit APIs
  // cannot preserve source mode/inode semantics. Record both oracle and candidate.
  let boundary : Array[(String, Array[String], Bytes, Bytes)] = [
    ("existing-write", ["-i", "change.diff", "input"], input, unified),
    ("named-output", ["-o", "new", "input"], input, unified),
    (
      "fuzz",
      ["--dry-run", "-F1", "-i", "change.diff"],
      b"wrong\ntwo\nthree\n",
      unified,
    ),
  ]
  for item in boundary {
    let (name, argv, fixture, patch) = item
    let oracle_dir = report + "/boundary-" + name + "-oracle"
    let candidate_dir = report + "/boundary-" + name + "-candidate"
    prepare(oracle_dir, fixture, patch)
    prepare(candidate_dir, fixture, patch)
    let reference = run_one(oracle, oracle_dir, argv)
    let actual = run_one(candidate, candidate_dir, argv)
    boundaries.push({
      "name": name,
      "oracle": outcome_json(reference),
      "candidate": outcome_json(actual),
      "candidate_boundary_status": actual.status == 2,
    })
  }
  let result : Json = {
    "oracle_version": "GNU patch 2.8",
    "supported_total": total,
    "supported_failures": failures,
    "boundaries": boundaries,
  }
  @fs.write_file(report + "/result.json", result.stringify(indent=2))
  println(
    "patch oracle: \{total} supported comparisons, \{failures.length()} differences; \{boundaries.length()} explicit boundaries; \{report}/result.json",
  )
  guard failures.is_empty() else { fail("patch oracle comparison failed") }
}
