///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn object(value : Json, context : String) -> Map[String, Json] raise {
  guard value is Object(fields) else { fail(context + ": expected object") }
  fields
}

///|
fn text(value : Json, key : String, context : String) -> String raise {
  guard object(value, context).get(key) is Some(String(value)) else {
    fail(context + ": missing string " + key)
  }
  value
}

///|
fn array(value : Json, key : String, context : String) -> Array[Json] raise {
  guard object(value, context).get(key) is Some(Array(items)) else {
    fail(context + ": missing array " + key)
  }
  items
}

///|
fn strings(value : Json, key : String, context : String) -> Array[String] raise {
  array(value, key, context).map(item => {
    guard item is String(value) else { fail(context + ": invalid " + key) }
    value
  })
}

///|
fn add_requirement(
  selected : Map[String, Json],
  entry : Json,
  report : String,
) -> Unit raise {
  let id = text(entry, "behavior_id", "registry entry")
  guard !selected.contains(id) else {
    fail("duplicate selected behavior: " + id)
  }
  guard text(entry, "status", id) == "supported" else {
    fail("this metadata release declaration does not alter a boundary: " + id)
  }
  let backends = strings(entry, "required_backends", id)
  let evidence = strings(entry, "required_evidence", id)
  let observations = strings(entry, "observations", id)
  guard !backends.is_empty() && !evidence.is_empty() && !observations.is_empty() else {
    fail("registry requirements are incomplete: " + id)
  }
  guard backends.all(value => ["native", "wasm"].contains(value)) &&
    evidence.all(value => ["contract", "backend-pair"].contains(value)) else {
    fail("unexpected backend or oracle requirement needs review: " + id)
  }
  // The schema's pass value declares the required outcome. Only audit execution
  // can establish that the referenced exact-revision reports prove it.
  selected[id] = {
    "behavior_id": id,
    "backends": Json(backends),
    "evidence": Json(evidence),
    "observations": Json(observations),
    "result": "pass",
    "reports": [Json(report)],
  }
}

///|
fn reviewed_version_ids() -> Array[String] {
  [
    "checksum-md5sum-version", "checksum-sha1sum-version", "checksum-sha512sum-version",
    "compat-catalog-line-243", "compat-catalog-line-251", "p0-echo-version", "p0-false-version",
    "p0-seq-version", "p0-sleep-version", "p0-true-version", "p2-column-version",
    "p2-date-version", "p2-strings-version", "p2-which-version",
  ]
}

///|
fn select_case(
  selected : Map[String, Json],
  entries : Map[String, Json],
  cases : Map[String, Json],
  id : String,
  command : String,
  report : String,
) -> Unit raise {
  let behavior = "case:" + id
  guard entries.get(behavior) is Some(entry) && cases.get(id) is Some(fixture) else {
    fail("generate and register the current metadata cases first: " + id)
  }
  guard text(entry, "implementation", behavior) == "json-case" &&
    text(entry, "command", behavior) == command &&
    text(entry, "case_id", behavior) == id &&
    text(entry, "source", behavior) == "tests/cases/" + command + ".json" &&
    text(fixture, "command", id) == command &&
    text(fixture, "comparison", id) == "contract" else {
    fail("metadata case ownership or contract mismatch: " + id)
  }
  guard strings(entry, "required_backends", behavior) == ["native", "wasm"] &&
    strings(entry, "required_evidence", behavior).contains("contract") &&
    strings(entry, "required_evidence", behavior).contains("backend-pair") else {
    fail(
      "metadata JSON case must retain both backend contracts and comparison: " +
      id,
    )
  }
  let observations = strings(entry, "observations", behavior)
  guard ["status", "stdout", "stderr"].all(value => observations.contains(value)) else {
    fail("metadata JSON case must retain complete stream observations: " + id)
  }
  add_requirement(selected, entry, report)
}

///|
async fn main {
  let args = @env.args()[1:]
  guard args.is_empty() else {
    fail(
      "Usage: prepare_coverage.mbtx (writes the reviewed release declaration once)",
    )
  }
  let directory = "docs/reports/2026-10-15-metadata-release"
  let output = directory + "/change.json"
  let scope_output = directory + "/change-scope.md"
  let report_root = "_build/verification/2026-10-17-metadata-release"
  let metadata_report = report_root + "/audit-metadata/summary.jsonl"
  let pair_report = report_root + "/audit-pairs/summary.jsonl"
  let receipt_report = report_root + "/audit-receipt/summary.jsonl"
  let gate_report = report_root + "/audit-gate/summary.jsonl"
  let registry = @json.parse(
    @fs.read_file("tests/registry/registry.json").text(),
  )
  guard object(registry, "registry").get("schema") == Some(Json(2)) else {
    fail("the reviewed release requires registry schema 2")
  }
  let entries : Map[String, Json] = Map([])
  let selected : Map[String, Json] = Map([])
  let commands : Array[String] = []
  let receipt_sources = [
    "tests/release_runner/acceptance_evidence_wbtest.mbt", "tests/release_runner/freeze_registry_wbtest.mbt",
  ]
  let receipt_counts : Map[String, Int32] = Map([])
  let mut receipt_count = 0
  let gate_ids = [
    "package-test:tests/coverage/entry_wbtest.mbt::audit uncovered classification keeps collective tags separate from individual evidence",
  ]
  let mut gate_count = 0
  for entry in array(registry, "entries", "registry") {
    let id = text(entry, "behavior_id", "registry entry")
    guard !entries.contains(id) else {
      fail("duplicate registry behavior: " + id)
    }
    entries[id] = entry
    let implementation = text(entry, "implementation", id)
    if implementation == "metadata-probe" {
      let command = text(entry, "command", id)
      guard command != "" &&
        !commands.contains(command) &&
        id == "metadata:" + command &&
        text(entry, "source", id) == "tests/metadata/verify.mbtx::" + command else {
        fail("metadata probe identity drift: " + id)
      }
      commands.push(command)
      add_requirement(selected, entry, metadata_report)
    } else if implementation == "package-test" {
      let source = text(entry, "source", id)
      for file in receipt_sources {
        if source.has_prefix(file + "::") {
          guard strings(entry, "required_backends", id) == ["native"] &&
            strings(entry, "required_evidence", id) == ["contract"] else {
            fail(
              "receipt regression requires a reviewed Native contract: " + id,
            )
          }
          add_requirement(selected, entry, receipt_report)
          receipt_counts[file] = receipt_counts.get(file).unwrap_or(0) + 1
          receipt_count += 1
        }
      }
      if gate_ids.contains(id) {
        guard id == "package-test:" + source &&
          strings(entry, "required_backends", id) == ["native"] &&
          strings(entry, "required_evidence", id) == ["contract"] else {
          fail(
            "audit gate regression requires its reviewed Native binding: " + id,
          )
        }
        add_requirement(selected, entry, gate_report)
        gate_count += 1
      }
    }
  }
  commands.sort()
  guard commands.length() == 79 && commands.contains("timeout") else {
    fail("the reviewed core impact must include all 79 command metadata probes")
  }
  for file in receipt_sources {
    if @fs.exists(file) {
      guard receipt_counts.get(file).unwrap_or(0) > 0 else {
        fail("refresh the registry for the new receipt test source: " + file)
      }
    }
  }
  guard receipt_counts.get(receipt_sources[0]).unwrap_or(0) > 0 else {
    fail("missing acceptance-evidence receipt regression")
  }
  guard gate_count == gate_ids.length() else {
    fail(
      "refresh the registry for the audit uncovered-classification regression",
    )
  }
  let cases : Map[String, Json] = Map([])
  for command in commands {
    let path = "tests/cases/" + command + ".json"
    let document = @json.parse(@fs.read_file(path).text())
    for fixture in array(document, "cases", path) {
      let id = text(fixture, "id", path)
      guard !cases.contains(id) else { fail("duplicate case identity: " + id) }
      cases[id] = fixture
    }
  }
  let case_ids : Array[String] = []
  let releases = array(registry, "release_commands", "registry")
  let released : Array[String] = []
  for release in releases {
    if object(release, "release command").get("releasable") != Some(Json(true)) {
      continue
    }
    let name = text(release, "name", "release command")
    guard commands.contains(name) &&
      name != "timeout" &&
      !released.contains(name) else {
      fail("unexpected release command: " + name)
    }
    released.push(name)
    let release_ids = strings(release, "case_ids", name)
    let options = strings(release, "supported_options", name)
    for probe in ["help", "version"] {
      let id = "release-metadata-" + name + "-" + probe
      let option = probe
      guard release_ids.contains(id) && options.contains(option) else {
        fail("reviewed release metadata selection is missing: " + id)
      }
      select_case(selected, entries, cases, id, name, pair_report)
      guard strings(entries["case:" + id], "coverage", id).contains(option) else {
        fail("reviewed normalized metadata option tag is missing: " + id)
      }
      case_ids.push(id)
    }
  }
  guard released.length() == 78 && case_ids.length() == 156 else {
    fail("the reviewed release requires 156 new cases for 78 commands")
  }
  let version_ids = reviewed_version_ids()
  let observed_versions : Array[String] = []
  for id, fixture in cases {
    if object(fixture, id).get("args") == Some(Json(["--version"])) &&
      !id.has_prefix("release-metadata-") {
      observed_versions.push(id)
    }
  }
  observed_versions.sort()
  version_ids.sort()
  guard observed_versions == version_ids else {
    fail(
      "existing standalone version case set changed; review the declaration scope",
    )
  }
  for id in version_ids {
    let command = text(cases[id], "command", id)
    select_case(selected, entries, cases, id, command, pair_report)
    case_ids.push(id)
  }
  case_ids.sort()
  let behaviors = selected.keys().collect()
  behaviors.sort()
  guard behaviors.length() == 249 + receipt_count + gate_count &&
    case_ids.length() == 170 else {
    fail("declaration selection count does not match the reviewed scope")
  }
  let declaration : Json = {
    "schema": 1,
    "affected_commands": Json(commands),
    "affected_behaviors": Json(behaviors),
    "affected_options": ["help", "version"],
    "affected_operands": [],
    "case_ids": Json(case_ids),
    "core_impact": "all",
    "published_manifest_affected": false,
    "required_backends": [],
    "required_evidence": [],
    "required_observations": [],
    "coverage": Json(behaviors.map(id => selected[id])),
    "boundaries": [],
    "deferred": [],
    "uncovered": [],
  }
  let scope =
    #|# Metadata release change declaration
    #|
    #|This is a reviewed coverage declaration, not an execution result. Each
    #|`result: "pass"` is a required outcome under the audit schema. The audit must
    #|verify the actual reports, exact committed revision, clean source tree,
    #|current registry and case corpus before accepting the declaration.
    #|
    #|The source range starts at `13beede`; pass that base explicitly to the audit
    #|and push launchers with the final committed head. The declaration schema
    #|does not contain Git refs. Earlier test-system repairs are outside this
    #|publication-preparation range and retain their separate evidence.
    #|
    #|This range updates package versions, matching version declarations and
    #|documentation, and dependency pins to the reviewed core release. Metadata
    #|support is selected explicitly for all 78 releasable commands. Shared-core
    #|impact is declared for all 79 commands, including local-only timeout; it is
    #|covered here by all registered metadata probes. No new operand behavior or
    #|existing rejection boundary is declared by this source range.
    #|
    #|The selected evidence requirements are the 79 metadata probes, 156 new
    #|exact help/version JSON contracts, 14 refreshed existing version contracts,
    #|and every registered receipt-validation test in acceptance_evidence_wbtest.mbt
    #|and freeze_registry_wbtest.mbt when present, plus the Native audit regression
    #|"audit uncovered classification keeps collective tags separate from individual
    #|evidence" in entry_wbtest.mbt. Receipt and audit regressions are Native-only.
    #|The audit repair keeps collective option/operand validation at declaration
    #|scope while classifying each behavior by its own evidence requirements.
    #|It must still reject missing global tags, missing report rows and missing
    #|observations. Earlier reports with contradictory uncovered classifications
    #|are retained separately and do not satisfy this declaration's fresh reports.
    #|Requirements are copied from each registry row; global backend, evidence
    #|and observation arrays stay empty so Native-only tests do not acquire a
    #|Wasm requirement. Normalized help and version option identities are checked
    #|against the catalog and new JSON bindings; command arguments remain --help
    #|and --version. Closed-input captures do not prove unread open stdin.
    #|
    #|Expected evidence files under _build/verification/2026-10-17-metadata-release:
    #|audit-metadata/summary.jsonl, audit-pairs/summary.jsonl,
    #|audit-receipt/summary.jsonl and audit-gate/summary.jsonl, each with its
    #|matching run-metadata.json.
    #|This helper neither creates nor accepts those reports. Missing, failed,
    #|dirty, stale or incomplete execution evidence must fail the coverage audit.
    #|
    #|Current and historical published snapshots are unchanged by this range,
    #|so published_manifest_affected is false. Publication and exact-version
    #|MoonX verification remain subsequent gates. Updating the published snapshot
    #|after successful upload requires a distinct follow-up impact decision and
    #|acceptance record; this declaration does not certify that future change.
    #|
  let outputs = [
    (output, declaration.stringify(indent=2) + "\n"),
    (scope_output, scope),
  ]
  for (path, content) in outputs {
    if @fs.exists(path) {
      guard @fs.read_file(path).text() == content else {
        fail("refusing to replace an existing reviewed file: " + path)
      }
    }
  }
  for (path, content) in outputs {
    if !@fs.exists(path) {
      @fs.write_file(path, content)
    }
  }
  println(
    "prepared \{behaviors.length()} behavior requirements, 170 case IDs, \{receipt_count} receipt regressions and \{gate_count} audit gate regressions",
  )
  println("declaration: " + output)
  println("scope: " + scope_output)
  println(
    "source base: 13beede (supply --base to the exact-revision audit/push gate)",
  )
  println(
    "No execution result was accepted. Collect fresh committed-source reports and run the coverage audit.",
  )
}
