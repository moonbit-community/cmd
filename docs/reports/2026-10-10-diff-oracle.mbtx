///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 4 else {
    fail(
      "Usage: moon run docs/reports/2026-10-10-diff-oracle.mbtx -- ORACLE_DIFF CANDIDATE_DIFF REPORT_DIRECTORY",
    )
  }
  let oracle = @fs.realpath(args[1])
  let candidate = @fs.realpath(args[2])
  if !@fs.exists(args[3]) {
    @fs.mkdir(args[3], recursive=true)
  }
  let report = @fs.realpath(args[3])
  let version = @shell.Cmd(oracle, ["--version"], env={
    "LC_ALL": "C",
    "TZ": "UTC",
  }).output()
  guard version.exit_code() == 0 &&
    version.stdout().has_prefix("diff (GNU diffutils) 3.12\n") else {
    fail("oracle must be GNU diffutils diff 3.12")
  }
  let samples : Array[(String, Bytes, Bytes)] = [
    ("empty", b"", b""),
    ("insert", b"", b"one\ntwo\n"),
    ("delete", b"one\ntwo\n", b""),
    ("replace", b"one\nold\nlast\n", b"one\nnew\nlast\n"),
    ("no-final-lf", b"one\ntwo", b"one\ntwo\n"),
    ("no-final-lf-both", b"one\nold", b"one\nnew"),
    ("binary", b"one\x00old\n", b"one\x00new\n"),
    ("invalid-utf8", b"\xff\nold\n", b"\xff\nnew\n"),
    (
      "separate-hunks", b"a\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk\nl\nm\nn\n", b"A\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk\nl\nm\nN\n",
    ),
    ("repeated", b"a\nb\na\nc\na\n", b"a\na\nb\nc\na\n"),
    ("blank-lines", b"a\n\n\nb\n", b"a\n\nb\n\n"),
  ]
  let options = [
    [],
    ["-u"],
    ["-c"],
    ["-U0"],
    ["-C0"],
    ["-U1"],
    ["-q"],
    ["-s"],
    ["-a", "-u"],
    ["-u", "--label=LEFT", "--label=RIGHT"],
    ["-c", "--label=LEFT", "--label=RIGHT"],
    ["-q", "--label=LEFT", "--label=RIGHT"],
    ["-s", "--label=LEFT", "--label=RIGHT"],
  ]
  let failures : Array[Json] = []
  let mut total = 0
  for sample in samples {
    let (name, left, right) = sample
    let directory = report + "/" + name
    if !@fs.exists(directory) {
      @fs.mkdir(directory, recursive=true)
    }
    @fs.write_file(directory + "/left", left)
    @fs.write_file(directory + "/right", right)
    for options in options {
      let argv = [..options, "left", "right"]
      let reference = @shell.Cmd(oracle, argv, cwd=directory, env={
        "LC_ALL": "C",
        "TZ": "UTC",
      }).output()
      let actual = @shell.Cmd(candidate, argv, cwd=directory, env={
        "LC_ALL": "C",
        "TZ": "UTC",
      }).output()
      total += 1
      if actual.exit_code() != reference.exit_code() ||
        actual.stdout_bytes() != reference.stdout_bytes() ||
        actual.stderr() != reference.stderr() {
        failures.push({
          "sample": name,
          "args": options,
          "expected_status": reference.exit_code(),
          "actual_status": actual.exit_code(),
          "expected": reference.stdout(),
          "actual": actual.stdout(),
          "stderr": actual.stderr(),
        })
      }
    }
  }
  let result : Json = {
    "oracle_version": "GNU diffutils 3.12",
    "total": total,
    "failures": failures,
  }
  @fs.write_file(report + "/result.json", result.stringify(indent=2))
  println(
    "diff oracle: \{total} comparisons, \{failures.length()} differences; \{report}/result.json",
  )
  guard failures.is_empty() else { fail("diff oracle comparison failed") }
}
