///|
import { "moonbitlang/async", "moonbitlang/async/fs", "moonbitlang/async/socket", "moonbitlang/async/process", "moonbitlang/core/encoding/utf8" }
///|
async fn main {
  @async.with_timeout(15000, () => @async.with_task_group(group => {
    let server = @socket.TcpServer(@socket.Addr::parse("127.0.0.1:0"))
    group.add_defer(() => server.close())
    group.spawn_bg(no_wait=true, () => server.run_forever((connection, _) => {
      let mut request = ""
      while !request.has_suffix("\r\n\r\n") { request += @utf8.decode(connection.read_exactly(1)) }
      println(request)
      let response = if request.has_prefix("GET /start ") {
        "HTTP/1.1 302 Found\r\nLocation: http://localhost:\{server.addr.port()}/end\r\n"
      } else { "HTTP/1.1 200 OK\r\n" }
      connection.write(response+"Content-Length: 0\r\nConnection: close\r\n\r\n")
    }))
    let path = "/tmp/cmd-cookie-redirect-\{@async.now()}.cookies"
    group.add_defer(() => @async.protect_from_cancel(() => @fs.remove(path)))
    @fs.write_file(path,"# Netscape HTTP Cookie File\n127.0.0.1\tFALSE\t/\tFALSE\t0\tsid\tstored\nlocalhost\tFALSE\t/\tFALSE\t0\tsid\tdestination\n")
    let url = "http://127.0.0.1:\{server.addr.port()}/start"
    for (cmd,args) in [
      ("curl",["-sSL","--noproxy","*","-b",path,"-H","Cookie: sid=header",url]),
      ("wget",["-qO-","--no-proxy","--load-cookies="+path,"--header=Cookie: sid=header",url]),
    ] {
      println(cmd)
      let (status,_,errors) = @process.collect_output(cmd,args)
      assert_eq(status,0,msg=errors.text())
    }
  }))
}
