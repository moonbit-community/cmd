import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
  "moonbitlang/core/json",
}

///|
async fn main {
  let root = "/tmp/cmd-audit-20260919/network"
  let cases = [
    ("21-jq-slurp-sequence", ["-sc", "."], "1\n2\n"),
    ("22-jq-arg-interpolation", ["-nr", "--arg", "name", "Moon", "\"hello \\($name)\""], ""),
    ("23-jq-arg-shadowing", ["-nc", "--arg", "x", "outer", "\"inner\" as $x | $x"], ""),
  ]
  for (name, args, input) in cases {
    for (suffix, program, argv) in [
      ("moonx", "moonx", ["cli/jq"] + args),
      ("native", "/usr/bin/jq", args),
    ] {
      let output = @shell.Cmd(program, argv, stdin=@shell.Text(input)).output(timeout_ms=30000)
      let id = name + "-" + suffix
      @fs.write_file(root + "/" + id + ".stdout", output.stdout_bytes())
      @fs.write_file(root + "/" + id + ".stderr", output.stderr())
      @fs.write_file(root + "/" + id + ".status", output.exit_code().to_string() + "\n")
      let record : Json = { "name": id, "program": program, "argv": argv, "stdin": input,
        "status": output.exit_code(), "stdout": output.stdout(), "stderr": output.stderr() }
      @fs.write_file(root + "/followup.jsonl", record.stringify() + "\n", create_mode=@fs.OpenOrCreate, append=true)
      println(record.stringify())
    }
  }
}
