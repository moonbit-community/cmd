import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/json",
}

///|
async fn observe(backend : String, command : String, args : Array[String], input : Bytes) -> Json {
  let (program, argv) = match backend {
    "native" => ("_build/native/release/build/cli/\{command}/\{command}.exe", args)
    "wasm" => ("moonrun", ["_build/wasm/release/build/cli/\{command}/\{command}.wasm", "--", ..args])
    _ => ("moonx", ["cli/\{command}@0.1.0", ..args])
  }
  let output = @shell.Cmd(program, argv, stdin=Binary(input), env={ "LC_ALL": "C", "TZ": "Asia/Shanghai" }).output(timeout_ms=120000)
  let result : Json = {
    "backend": backend,
    "command": command,
    "args": args.to_json(),
    "input": input.to_json(),
    "status": output.exit_code(),
    "stdout": output.stdout(),
    "stderr": output.stderr(),
  }
  println(result.stringify())
  result
}

///|
async fn main {
  guard @async.platform is MacOS else { fail("This observation is scoped to macOS") }
  let fixture = "test-reports/command-followups-20261011"
  @fs.mkdir(fixture, recursive=true)
  let plain = fixture + "/plain"
  @fs.write_file(plain, b"not executable\n")
  @fs.chmod(plain, 0o644)
  assert_false(@fs.can_execute(plain))
  println("{\"observation\":\"public can_execute rejects mode 0644\",\"platform\":\"macOS\"}")
  for backend in ["native", "wasm", "moonx"] {
    ignore(observe(backend, "which", ["-s", plain], b""))
    ignore(observe(backend, "column", [], b"a\nb\nc\nd\n"))
    ignore(observe(backend, "column", ["-t"], b"a b\ncc d\n"))
    ignore(observe(backend, "date", ["-d", "@0", "+%H:%M %z"], b""))
    ignore(observe(backend, "strings", ["-t", "d"], b"abcd\x00"))
    ignore(observe(backend, "strings", ["-e", "b"], b"abcd\x00"))
    ignore(observe(backend, "strings", ["-e", "s"], b"abcd\x00"))
    ignore(observe(backend, "strings", [], b"ab\tcd\x00"))
  }
  let which = @shell.Cmd("/usr/bin/which", ["-s", plain]).output(timeout_ms=15000)
  assert_eq(which.exit_code(), 1)
  println("{\"observation\":\"macOS /usr/bin/which rejects mode 0644\",\"status\":1}")
}
