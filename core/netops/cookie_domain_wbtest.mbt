///|
test "curl save and file reload clear expired response cookies at distinct boundaries" {
  let input = "a.example.com\tTRUE\t/\tFALSE\t0\tsid\tfile\n"
  let url = parse_absolute_url("http://a.example.com/step/0")
  for saved in [false, true] {
    let jar = CookieJar::new()
    jar.load_netscape_at(input, 100L, CurlProfile)
    jar.receive(
      url,
      [Cookie::new("sid", "gone", domain="a.example.com", path="/", max_age=0L)],
      100L,
      profile=CurlProfile,
    )
    assert_eq(jar.entries.length(), 1)
    assert_true(jar.entries[0].live && jar.entries[0].expired(100L))
    if saved {
      assert_eq(
        jar.netscape(now=100L, profile=CurlProfile),
        "# Netscape HTTP Cookie File\n# https://curl.se/docs/http-cookies.html\n# This file was generated by libcurl! Edit at your own risk.\n\n",
      )
      assert_eq(jar.entries.length(), 0)
    }
    jar.load_netscape_at(input, 101L, CurlProfile)
    assert_eq(
      jar.header_for(url, 101L, profile=CurlProfile),
      if saved {
        Some("sid=file")
      } else {
        None
      },
    )
  }
}

///|
test "curl imports preserve response cookies until expiry and refill deleted keys" {
  let jar = CookieJar::new()
  let input = "a.example.com\tTRUE\t/\tFALSE\t0\tsid\tfile\n"
  let url = parse_absolute_url("http://a.example.com/step/0")
  jar.load_netscape_at(input, 100L, CurlProfile)
  jar.receive(
    url,
    [
      Cookie::new(
        "sid",
        "response",
        domain="a.example.com",
        path="/",
        max_age=5L,
      ),
    ],
    100L,
    profile=CurlProfile,
  )
  jar.load_netscape_at(input, 101L, CurlProfile)
  assert_eq(
    jar.header_for(url, 101L, profile=CurlProfile),
    Some("sid=response"),
  )
  jar.load_netscape_at(input, 106L, CurlProfile)
  assert_eq(jar.header_for(url, 106L, profile=CurlProfile), None)
  jar.load_netscape_at(input, 107L, CurlProfile)
  assert_eq(jar.header_for(url, 107L, profile=CurlProfile), Some("sid=file"))
  jar.receive(
    url,
    [
      Cookie::new(
        "sid",
        "deleted",
        domain="a.example.com",
        path="/",
        max_age=0L,
      ),
    ],
    108L,
    profile=CurlProfile,
  )
  assert_eq(jar.header_for(url, 108L, profile=CurlProfile), None)
  jar.load_netscape_at(input, 109L, CurlProfile)
  assert_eq(jar.header_for(url, 109L, profile=CurlProfile), Some("sid=file"))
}

///|
test "wget response admission folds public suffix case without rewriting the chain" {
  let jar = CookieJar::new()
  jar.load_netscape(".COM\tTRUE\t/\tFALSE\t0\tsid\told\n", profile=WgetProfile)
  let url = parse_absolute_url("http://com/step/0")
  jar.receive(
    url,
    [wget_wire_cookie("sid=new; Domain=COM; Path=/").unwrap()],
    100L,
    profile=WgetProfile,
  )
  assert_eq(jar.header_for(url, 100L, profile=WgetProfile), Some("sid=new"))
  assert_true(jar.netscape().contains(".COM\tTRUE\t/\tFALSE\t0\tsid\tnew\n"))
  jar.receive(
    url,
    [
      wget_wire_cookie("sid=ignored; Domain=COM; Path=/foreign; Max-Age=0").unwrap(),
    ],
    100L,
    profile=WgetProfile,
  )
  assert_eq(jar.header_for(url, 100L, profile=WgetProfile), Some("sid=new"))
}

///|
test "wget leading dot admission is separate from stored and reloaded identity" {
  let jar = CookieJar::new()
  let url = parse_absolute_url("http://a.example.com/step/0")
  jar.receive(
    url,
    [wget_wire_cookie("sid=new; Domain=..a.example.com; Path=/").unwrap()],
    100L,
    profile=WgetProfile,
  )
  assert_eq(jar.header_for(url, 100L, profile=WgetProfile), None)
  let saved = jar.netscape()
  assert_true(saved.contains("..a.example.com\tTRUE\t/\tFALSE\t0\tsid\tnew\n"))
  let restored = CookieJar::new()
  restored.load_netscape(saved, profile=WgetProfile)
  assert_eq(restored.header_for(url, 100L, profile=WgetProfile), None)
  assert_true(
    restored
    .netscape()
    .contains("..a.example.com\tTRUE\t/\tFALSE\t0\tsid\tnew\n"),
  )
}

///|
test "curl saved domain prefixes change the next process lookup exactly once" {
  let input = "..a.example.com\tTRUE\t/\tFALSE\t0\tsid\told\n"
  let jar = CookieJar::new()
  jar.load_netscape(input, profile=CurlProfile)
  let url = parse_absolute_url("http://a.example.com/step/0")
  assert_eq(jar.header_for(url, 100L, profile=CurlProfile), None)
  let saved = jar.netscape()
  assert_true(saved.contains("\n.a.example.com\tTRUE\t/\tFALSE\t0\tsid\told\n"))
  assert_false(saved.contains("\n..a.example.com"))
  let restored = CookieJar::new()
  restored.load_netscape(saved, profile=CurlProfile)
  assert_eq(
    restored.header_for(url, 100L, profile=CurlProfile),
    Some("sid=old"),
  )
}

///|
test "fixed wget raw unicode hosts use byte lengths and the legacy domain heuristic" {
  for
    (host, domain, accepted) in [
      ("☃.github.io", "github.io", true),
      ("☃.cnn.de", "cnn.de", false),
      ("x.é.uk", "é.uk", false),
      ("x.☃.uk", "☃.uk", false),
      ("x.éé.uk", "éé.uk", true),
    ] {
    assert_eq(wget_cookie_domain_allows(host, domain), accepted, msg=host)
  }
  assert_false(wget_cookie_domain_allows("a.github.io", "github.io"))
  assert_true(wget_cookie_domain_allows("a.cnn.de", "cnn.de"))
  assert_false(wget_cookie_domain_allows("a.example.com", "ａ.example.com"))
}
