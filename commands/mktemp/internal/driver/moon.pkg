import {
  "cli/core/cli",
  "cli/core/platform",
  "moonbitlang/async/fs",
  "moonbitlang/async/os_error",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x/path",
}

supported_targets = "wasm"

rule(
  name: "gen_version",
  command: "moonx moonbit-community/gen_version@0.0.2 -o $output",
)

dev_build(rule: "gen_version", input: "../../moon.mod", output: "version.mbt")

import {
  "moonbitlang/async",
} for "wbtest"
