fn metadata_help() -> String {
  "Usage: xargs [-0prt] [-d BYTE] [-n N] [-L N] [-s BYTES] [-P N] [-E EOF] [-I REPLACE] [COMMAND [ARG...]]\n  -d, --delimiter=BYTE  separate literal input items with BYTE or an escape\n  -p, --interactive     confirm each invocation through an independent console\nComplete -n/-L batches can execute before EOF; later input errors preserve completed child effects.\n-P N replenishes individual free slots; --show-limits leaves stdin untouched.\n      --help      display this help and exit\n      --version   display version and exit\n"
}

///|
fn metadata_option_matches(name : String, spelling : String) -> Bool {
  match name {
    "0" => ["-0", "--null"].contains(spelling)
    "delimiter" => ["-d", "--delimiter"].contains(spelling)
    "max-args" => ["-n", "--max-args"].contains(spelling)
    "max-lines" => ["-L", "--max-lines"].contains(spelling)
    "max-chars" => ["-s", "--max-chars"].contains(spelling)
    "eof" => ["-E", "--eof"].contains(spelling)
    "no-run-if-empty" => ["-r", "--no-run-if-empty"].contains(spelling)
    "replace" => ["-I", "--replace"].contains(spelling)
    "P" => ["-P", "--max-procs"].contains(spelling)
    "verbose" => ["-t", "--verbose"].contains(spelling)
    "interactive" => ["-p", "--interactive"].contains(spelling)
    "show-limits" => ["--show-limits"].contains(spelling)
    "help" => ["--help"].contains(spelling)
    "version" => ["--version"].contains(spelling)
    _ => false
  }
}

