  "Usage: tree [-adfJCnsh] [-L level] [-P pattern] [-I pattern] [-H base] [-T title] [directory ...]\n      --help      display this help and exit\n      --version   display version and exit\n  -J emits JSON; -H BASE emits escaped HTML; -T TITLE selects its title.\n  -P includes files; -I excludes names/subtrees; --ignore-case changes matching.\n  --matchdirs includes matching directory contents; --prune removes empty branches.\n  --filelimit N limits entries before traversal; --noreport omits totals.\n  -s, -h, --si and --du use public size metadata; unsupported host metadata reports an error.\n  -C forces explicit type/extension colors; -n disables unforced color.\n  Symlinks are named leaves; -d selects real child directories, retaining explicit operands.\n  Symlink target text/sizes and mode-based colors require unavailable public metadata APIs.\nProject aliases: --all = -a; --dirs-only = -d; --full-path = -f; --level = -L.\n--json = -J; --html = -H; --title = -T; --pattern = -P; --ignore = -I.\n--size = -s; --human-readable = -h; --color = -C; --no-color = -n.\n"
}

