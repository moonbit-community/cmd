import {
  "cli/core/bytesearch",
  "cli/core/fswalk",
  "cli/core/bytere",
  "cli/core/cli",
  "cli/core/stream",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/stdio",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/buffer",
  "moonbitlang/core/deque",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
}

supported_targets = "native+wasm"

pkgtype(kind: "executable")

rule(
  name: "gen_version",
  command: "moonx moonbit-community/gen_version@0.0.2 -o $output",
)

dev_build(rule: "gen_version", input: "moon.mod", output: "version.mbt")
