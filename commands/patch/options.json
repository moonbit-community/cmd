  "options": [
    {
      "name": "strip",
      "aliases": [
        "-p",
        "--strip"
      ],
      "value": "required",
      "description": "remove N leading file-name components",
      "short": "p",
      "repeatable": true,
      "allow_attached": true,
      "help_lines": [
        "  -p, --strip=N       remove N leading file-name components"
      ]
    },
    {
      "name": "input",
      "aliases": [
        "-i",
        "--input"
      ],
      "value": "required",
      "description": "read the patch from FILE instead of stdin",
      "short": "i",
      "repeatable": true,
      "allow_attached": true,
      "help_lines": [
        "  -i, --input=FILE    read the patch from FILE instead of stdin"
      ]
    },
    {
      "name": "output",
      "aliases": [
        "-o",
        "--output"
      ],
      "value": "required",
      "description": "write patched files to stdout",
      "short": "o",
      "repeatable": true,
      "allow_attached": true,
      "help_lines": [
        "  -o, --output=-      write patched files to stdout"
      ]
    },
    {
      "name": "reject-file",
      "aliases": [
        "-r",
        "--reject-file"
      ],
      "value": "required",
      "description": "write rejected hunks to a new FILE; - discards",
      "short": "r",
      "repeatable": true,
      "allow_attached": true,
      "help_lines": [
        "  -r, --reject-file=FILE  write rejected hunks to a new FILE; - discards"
