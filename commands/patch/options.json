      "description": "resolve target paths relative to DIR",
      "short": "d",
      "repeatable": true,
      "allow_attached": true,
      "help_lines": [
        "  -d, --directory=DIR resolve target paths relative to DIR"
      ],
      "default_value": ".",
      "default_binding": {
        "name": "DEFAULT_DIRECTORY",
        "type_": "String"
      }
    },
    {
      "name": "reverse",
      "aliases": [
        "-R",
        "--reverse"
