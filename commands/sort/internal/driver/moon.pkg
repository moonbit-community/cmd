import {
  "cli/sort/internal/order",
}

import {
  "moonbitlang/async/fs" @legacy_fs,
  "cli/core/tempio",
  "cli/core/cli",
  "cli/core/stream",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}

supported_targets = "wasm"

rule(
  name: "gen_version",
  command: "moonx moonbit-community/gen_version@0.0.2 -o $output",
)

dev_build(rule: "gen_version", input: "../../moon.mod", output: "version.mbt")
