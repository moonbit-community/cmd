// Generated by tools/metadata from options.json. Do not edit.

///|
fn metadata_help() -> String {
  "Usage: wget [OPTION]... [URL]...\n      --help      display this help and exit\n      --version   display version and exit\n  -q, --quiet                     quiet (no output)\n  -O, --output-document=FILE      write documents to FILE\n  -o, --output-file=FILE          log messages to FILE\n  -a, --append-output=FILE        append messages to FILE\n  -i, --input-file=FILE           download URLs found in FILE\n  -c, --continue                  resume after the already written prefix\n  -N, --timestamping              do not re-retrieve unchanged files\n  -t, --tries=NUMBER              set number of retries (0 means unlimited)\n      --retry-connrefused         retry even if the connection is refused\n      --retry-on-http-error=CODES retry comma-separated HTTP status codes\n      --waitretry=SECONDS         wait between retries\n                                 partial bytes survive retries and failures\n      --max-redirect=NUMBER       maximum redirects (default 20)\n      --content-disposition       honor Content-Disposition filenames\n      --header=STRING             set a request header; last same-name value wins\n      --config=FILE               use this configuration file\n      --no-config                 skip startup configuration\n  -e, --execute=COMMAND           apply a configuration setting\n      --user=USER                 HTTP Basic user name\n      --password=PASSWORD         HTTP Basic password\n      --http-user=USER            HTTP-specific user, before --user fallback\n      --http-password=PASSWORD    HTTP-specific password, before --password fallback\n      --auth-no-challenge[=on|off] send Basic credentials before a challenge when enabled\n      --load-cookies=FILE         load a Netscape cookie jar\n      --header='Cookie: ...'      override jar cookies, including on redirects\n      --save-cookies=FILE         save persistent cookies\n      --keep-session-cookies      also save session cookies\n      --no-cookies                disable cookie storage\n      --method=HTTPMethod         use a supported HTTP method\n      --body-data=STRING          send STRING with an explicit --method\n      --body-file=FILE            send FILE with an explicit --method\n      --no-check-certificate      disable TLS certificate verification\n      --no-proxy                  do not use proxy environment variables\n      --local-encoding=ENCODING   URL host input: UTF-8 or ASCII (default ASCII)\n  -T, --timeout=SECONDS           set connect and read timeouts\n      --connect-timeout=SECONDS   set connection timeout\n      --read-timeout=SECONDS      set response inactivity timeout\n      --idle-timeout=SECONDS      extension: response inactivity timeout\n\nCompatibility limits: HTTP/HTTPS only; --method accepts GET, HEAD, POST,\nPUT, DELETE, CONNECT, OPTIONS, TRACE, and PATCH. Timer values are bounded\nby the runtime millisecond timer range.\nThe passive_ftp configuration boolean is accepted without affecting HTTP.\nContent-coding bytes remain encoded; Accept-Encoding defaults to identity.\nRaw space/TAB/CR/LF/DEL in URL paths or queries uses uppercase percent escapes.\nRedirect spaces use %20 and TAB uses %09; existing escapes remain encoded.\nSet-Cookie without '=' or a valid Max-Age numeric prefix is ignored.\nWget expiry accepts decimal/hex floating prefixes; exactly -1 rejects an update.\nZero requests deletion; nonzero negative values retain stale domain-chain entries.\nOverflow follows the fixed Linux/amd64 profile; saved expiry digits round via binary64.\nExpires uses four C-locale date formats, UTC normalization and the 69 year pivot.\nMissing/GMT/signed-digit timezone tails are accepted without applying offsets.\nGNU chunk payload/trailer EOF rules apply; missing size lines or CRLF fail.\nHTTP 416 succeeds without opening transfer output; -O is initialized first.\nUnsolicited 304 exits 8. Continued GET with --content-disposition selects\nthe filename with HEAD before choosing that file's resume offset.\nMultiple URL failures retain the lowest nonzero transfer exit code.\nBasic challenges are recognized across repeated fields and quoted comma lists.\nURL credentials take field-wise precedence; omitted and empty passwords differ.\nURL credentials wait for each hop's challenge; global credentials cache by hostname.\nHTTP 401 returns 6, including missing or unsupported challenges; other HTTP errors return 8.\nASCII response cookie domains use the complete pinned ICANN/PRIVATE suffix list.\nNon-ASCII domains/hosts use the fixed non-NLS Wget label/byte-length heuristic.\nAdmission strips leading dots separately from stored Domain identity.\nRejected domains discard a matching stored cookie after request-path validation.\nCookie request paths use raw prefix matching; missing Path uses the URL directory.\nImported cookie files retain Wget's separate admission policy.\nHost-only cookies isolate nondefault ports and preserve them in saved jars.\nCookie parameters accept quoted values; Secure ignores its value, HttpOnly is ignored.\nJar lookup skips single-label parent domains and hosts with more than 32 labels.\nUTF-8 URL hosts use pinned Unicode 15 IDNA with whole-host transitional fallback.\nHost brackets mapped colons and omits the scheme's default port.\nFailed conversion retains the raw host; other input encodings are unsupported.\n"
}

