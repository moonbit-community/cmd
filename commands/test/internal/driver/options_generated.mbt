    "L" => ["-L"].contains(spelling)
    "h" => ["-h"].contains(spelling)
    "p" => ["-p"].contains(spelling)
    "S" => ["-S"].contains(spelling)
    "b" => ["-b"].contains(spelling)
    "c" => ["-c"].contains(spelling)
    "r" => ["-r"].contains(spelling)
    "w" => ["-w"].contains(spelling)
    "x" => ["-x"].contains(spelling)
    "s" => ["-s"].contains(spelling)
    "N" => ["-N"].contains(spelling)
    "nt" => ["-nt"].contains(spelling)
    "ot" => ["-ot"].contains(spelling)
    "help" => ["--help"].contains(spelling)
    "version" => ["--version"].contains(spelling)
    "eq" => ["-eq"].contains(spelling)
    "ne" => ["-ne"].contains(spelling)
    "lt" => ["-lt"].contains(spelling)
    "le" => ["-le"].contains(spelling)
    "gt" => ["-gt"].contains(spelling)
