{
  "schema": 1,
  "command": "comm",
  "help": "Usage: comm [-123] [-z] FILE1 FILE2\n{{help:help:0}}\n{{help:version:0}}\n\nCompare two sorted files line by line, producing three columns:\nlines only in FILE1, lines only in FILE2, and lines in both.\n\nOptions:\n{{help:suppress-1:0}}\n{{help:suppress-2:0}}\n{{help:suppress-3:0}}\n{{help:output-delimiter:0}}\n{{help:total:0}}\n{{help:check-order:0}}\n{{help:nocheck-order:0}}\n{{help:zero-terminated:0}}\n\nUse '-' as a file name to read stdin.\n\nProject aliases: --suppress-1 = -1; --suppress-2 = -2; --suppress-3 = -3.\n{{help:help:1}}\n\nOrdinary option/operand errors exit 1; documented capability refusals retain their own status.\n",
  "catalog_options": [
    "1",
    "2",
    "3",
    "check-order",
    "nocheck-order",
    "help",
    "output-delimiter",
    "total",
    "zero-terminated"
  ],
  "options": [
    {
      "name": "suppress-1",
      "aliases": [
        "-1"
      ],
      "value": "none",
      "description": "Suppress lines unique to the first input.",
      "short": "1",
      "repeatable": true,
      "allow_attached": false,
      "help_lines": [
        "  -1  Suppress column 1 (lines unique to FILE1)."
      ]
    },
    {
