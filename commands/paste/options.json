{
  "schema": 1,
  "command": "paste",
  "help": "Usage: paste [-s] [-d LIST] [-z] [FILE...]\n{{help:help:0}}\n{{help:version:0}}\nOrdinary option/operand errors exit 1; documented capability refusals retain their own status.\n",
  "catalog_options": [
    "delimiters",
    "help",
    "serial",
    "zero-terminated"
  ],
  "options": [
    {
      "name": "serial",
      "aliases": [
        "-s",
        "--serial"
      ],
      "value": "none",
      "description": "Join each file's records into one output record.",
      "short": "s",
      "repeatable": true,
      "allow_attached": false
    },
    {
      "name": "delimiters",
      "aliases": [
        "-d",
        "--delimiters"
      ],
      "value": "required",
      "description": "Cycle through delimiters.",
      "short": "d",
      "repeatable": true,
      "allow_attached": true
    },
    {
      "name": "zero-terminated",
      "aliases": [
        "-z",
        "--zero-terminated"
      ],
      "value": "none",
      "description": "Use NUL-delimited records.",
      "short": "z",
      "repeatable": true,
      "allow_attached": false
    },
    {
      "name": "help",
      "aliases": [
        "--help"
      ],
      "value": "none",
      "description": "Show help / package version.",
      "repeatable": true,
      "allow_attached": false,
      "help_lines": [
        "      --help      display this help and exit"
      ]
    },
    {
      "name": "version",
      "aliases": [
        "--version"
      ],
      "value": "none",
      "description": "Show help / package version.",
      "repeatable": false,
      "allow_attached": false,
      "help_lines": [
        "      --version   display version and exit"
      ]
    }
  ],
  "tables": [
    {
      "function_name": "option_specs",
      "source": "internal/driver/main.mbt",
      "import_alias": "cli",
      "options": [
        "serial",
        "delimiters",
        "zero-terminated",
        "help"
      ]
    }
  ],
  "adapter_sources": [
    "internal/driver/main.mbt",
    "internal/driver/version.mbt"
  ]
}
