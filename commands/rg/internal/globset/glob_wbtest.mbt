// Tests ported mechanically from globset/src/glob.rs (mod tests).
// Generated by a conversion script; Rust expectations are kept verbatim.

///|
test "syntax/literal1" {
  assert_eq(Glob::new("a").tokens, [Literal('a')])
}

///|
test "syntax/literal2" {
  assert_eq(Glob::new("ab").tokens, [Literal('a'), Literal('b')])
}

///|
test "syntax/any1" {
  assert_eq(Glob::new("?").tokens, [Any])
}

///|
test "syntax/any2" {
  assert_eq(Glob::new("a?b").tokens, [Literal('a'), Any, Literal('b')])
}

///|
test "syntax/seq1" {
  assert_eq(Glob::new("*").tokens, [ZeroOrMore])
}

///|
test "syntax/seq2" {
  assert_eq(Glob::new("a*b").tokens, [Literal('a'), ZeroOrMore, Literal('b')])
}

///|
test "syntax/seq3" {
  assert_eq(Glob::new("*a*b*").tokens, [
    ZeroOrMore,
    Literal('a'),
    ZeroOrMore,
    Literal('b'),
    ZeroOrMore,
  ])
}

///|
test "syntax/rseq1" {
  assert_eq(Glob::new("**").tokens, [RecursivePrefix])
}

///|
test "syntax/rseq2" {
  assert_eq(Glob::new("**/").tokens, [RecursivePrefix])
}

///|
test "syntax/rseq3" {
  assert_eq(Glob::new("/**").tokens, [RecursiveSuffix])
}

///|
test "syntax/rseq4" {
  assert_eq(Glob::new("/**/").tokens, [RecursiveZeroOrMore])
}

///|
test "syntax/rseq5" {
  assert_eq(Glob::new("a/**/b").tokens, [
    Literal('a'),
    RecursiveZeroOrMore,
    Literal('b'),
  ])
}

///|
test "syntax/cls1" {
  assert_eq(Glob::new("[a]").tokens, [class('a', 'a')])
}

///|
test "syntax/cls2" {
  assert_eq(Glob::new("[!a]").tokens, [classn('a', 'a')])
}

///|
test "syntax/cls3" {
  assert_eq(Glob::new("[a-z]").tokens, [class('a', 'z')])
}

///|
test "syntax/cls4" {
  assert_eq(Glob::new("[!a-z]").tokens, [classn('a', 'z')])
}

///|
test "syntax/cls5" {
  assert_eq(Glob::new("[-]").tokens, [class('-', '-')])
}

///|
test "syntax/cls6" {
  assert_eq(Glob::new("[]]").tokens, [class(']', ']')])
}

///|
test "syntax/cls7" {
  assert_eq(Glob::new("[*]").tokens, [class('*', '*')])
}

///|
test "syntax/cls8" {
  assert_eq(Glob::new("[!!]").tokens, [classn('!', '!')])
}

///|
test "syntax/cls9" {
  assert_eq(Glob::new("[a-]").tokens, [rclass([('a', 'a'), ('-', '-')])])
}

///|
test "syntax/cls10" {
  assert_eq(Glob::new("[-a-z]").tokens, [rclass([('-', '-'), ('a', 'z')])])
}

///|
test "syntax/cls11" {
  assert_eq(Glob::new("[a-z-]").tokens, [rclass([('a', 'z'), ('-', '-')])])
}

///|
test "syntax/cls12" {
  assert_eq(Glob::new("[-a-z-]").tokens, [
    rclass([('-', '-'), ('a', 'z'), ('-', '-')]),
  ])
}

///|
test "syntax/cls13" {
  assert_eq(Glob::new("[]-z]").tokens, [class(']', 'z')])
}

///|
test "syntax/cls14" {
  assert_eq(Glob::new("[--z]").tokens, [class('-', 'z')])
}

///|
test "syntax/cls15" {
  assert_eq(Glob::new("[ --]").tokens, [class(' ', '-')])
}

///|
test "syntax/cls16" {
  assert_eq(Glob::new("[0-9a-z]").tokens, [rclass([('0', '9'), ('a', 'z')])])
}

///|
test "syntax/cls17" {
  assert_eq(Glob::new("[a-z0-9]").tokens, [rclass([('a', 'z'), ('0', '9')])])
}

///|
test "syntax/cls18" {
  assert_eq(Glob::new("[!0-9a-z]").tokens, [rclassn([('0', '9'), ('a', 'z')])])
}

///|
test "syntax/cls19" {
  assert_eq(Glob::new("[!a-z0-9]").tokens, [rclassn([('a', 'z'), ('0', '9')])])
}

///|
test "syntax/cls20" {
  assert_eq(Glob::new("[^a]").tokens, [classn('a', 'a')])
}

///|
test "syntax/cls21" {
  assert_eq(Glob::new("[^a-z]").tokens, [classn('a', 'z')])
}

///|
test "syntaxerr/err_unclosed1" {
  assert_eq(glob_err_kind("["), UnclosedClass)
}

///|
test "syntaxerr/err_unclosed2" {
  assert_eq(glob_err_kind("[]"), UnclosedClass)
}

///|
test "syntaxerr/err_unclosed3" {
  assert_eq(glob_err_kind("[!"), UnclosedClass)
}

///|
test "syntaxerr/err_unclosed4" {
  assert_eq(glob_err_kind("[!]"), UnclosedClass)
}

///|
test "syntaxerr/err_range1" {
  assert_eq(glob_err_kind("[z-a]"), InvalidRange('z', 'a'))
}

///|
test "syntaxerr/err_range2" {
  assert_eq(glob_err_kind("[z--]"), InvalidRange('z', '-'))
}

///|
test "syntaxerr/err_alt1" {
  assert_eq(glob_err_kind("{a,b"), UnclosedAlternates)
}

///|
test "syntaxerr/err_alt2" {
  assert_eq(glob_err_kind("{a,{b,c}"), UnclosedAlternates)
}

///|
test "syntaxerr/err_alt3" {
  assert_eq(glob_err_kind("a,b}"), UnopenedAlternates)
}

///|
test "syntaxerr/err_alt4" {
  assert_eq(glob_err_kind("{a,b}}"), UnopenedAlternates)
}

///|
test "toregex/allow_unclosed_class_single" {
  assert_eq(build("[", unccls=true).regex(), "(?-u)^\\[$")
}

///|
test "toregex/allow_unclosed_class_many" {
  assert_eq(build("[abc", unccls=true).regex(), "(?-u)^\\[abc$")
}

///|
test "toregex/allow_unclosed_class_empty1" {
  assert_eq(build("[]", unccls=true).regex(), "(?-u)^\\[\\]$")
}

///|
test "toregex/allow_unclosed_class_empty2" {
  assert_eq(build("[][", unccls=true).regex(), "(?-u)^\\[\\]\\[$")
}

///|
test "toregex/allow_unclosed_class_negated_unclosed" {
  assert_eq(build("[!", unccls=true).regex(), "(?-u)^\\[!$")
}

///|
test "toregex/allow_unclosed_class_negated_empty" {
  assert_eq(build("[!]", unccls=true).regex(), "(?-u)^\\[!\\]$")
}

///|
test "toregex/allow_unclosed_class_brace1" {
  assert_eq(build("{[abc,xyz}", unccls=true).regex(), "(?-u)^(?:\\[abc|xyz)$")
}

///|
test "toregex/allow_unclosed_class_brace2" {
  assert_eq(
    build("{[abc,[xyz}", unccls=true).regex(),
    "(?-u)^(?:\\[abc|\\[xyz)$",
  )
}

///|
test "toregex/allow_unclosed_class_brace3" {
  assert_eq(
    build("{[abc],[xyz}", unccls=true).regex(),
    "(?-u)^(?:[abc]|\\[xyz)$",
  )
}

