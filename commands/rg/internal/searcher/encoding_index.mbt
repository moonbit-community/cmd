///|
/// Calls `f` with each number of a compact string generated by
/// scripts/gen_encodings.py. Characters outside '0'..'o' are ignored.
fn each_packed_number(data : String, f : (Int32) -> Unit) -> Unit {
  let mut n = 0
  for i in 0..<data.length() {
    let c = data[i].to_int()
    if c < 0x30 || c > 0x6F {
      continue
    }
    if c < 0x50 {
      n = n * 32 + (c - 0x30)
    } else {
      f(n * 32 + (c - 0x50))
      n = 0
    }
  }
}

///|
/// Decodes a packed index (see scripts/gen_encodings.py) into a table of
/// `len` code points, with -1 for unmapped pointers.
fn unpack_index(data : String, len : Int32, base : Int32) -> FixedArray[Int32] {
  let table = FixedArray::make(len, -1)
  let mut prev = base
  let mut ptr = 0
  each_packed_number(data, v => {
    let payload = v >> 2
    match v & 3 {
      0 =>
        for _ in 0..<=payload {
          prev += 1
          table[ptr] = prev
          ptr += 1
        }
      1 => ptr += payload + 1
      2 => {
        prev += payload + 2
        table[ptr] = prev
        ptr += 1
      }
      _ => {
        prev -= payload
        table[ptr] = prev
        ptr += 1
      }
    }
  })
  table
}

///|
/// A pointer -> code point index that is unpacked on first use.
priv struct LazyIndex {
  data : String
  len : Int32
  base : Int32
  mut table : FixedArray[Int32]?
}

///|
fn LazyIndex::new(data : String, len : Int32, base : Int32) -> LazyIndex {
  { data, len, base, table: None, }
}

///|
fn LazyIndex::get(self : LazyIndex) -> FixedArray[Int32] {
  match self.table {
    Some(t) => t
    None => {
      let t = unpack_index(self.data, self.len, self.base)
      self.table = Some(t)
      t
    }
  }
}

///|
/// Returns the code point for `pointer`, or -1 if there is none.
fn LazyIndex::lookup(self : LazyIndex, pointer : Int32) -> Int32 {
  let t = self.get()
  if pointer >= 0 && pointer < t.length() {
    t[pointer]
  } else {
    -1
  }
}

///|
let index_jis0208 : LazyIndex = LazyIndex::new(jis0208_data, JIS0208_LEN, 0)

///|
let index_jis0212 : LazyIndex = LazyIndex::new(jis0212_data, JIS0212_LEN, 0)

///|
let index_euc_kr : LazyIndex = LazyIndex::new(euc_kr_data, EUC_KR_LEN, 0)

///|
let index_gb18030 : LazyIndex = LazyIndex::new(gb18030_data, GB18030_LEN, 0)

///|
let index_big5 : LazyIndex = LazyIndex::new(big5_data, BIG5_LEN, 0)

///|
/// Single-byte indexes (pointers 0..127 for bytes 0x80..0xFF), indexed like
/// `single_byte_names`.
let single_byte_indexes : FixedArray[LazyIndex] = FixedArray::makei(
  single_byte_data.length(),
  i => LazyIndex::new(single_byte_data[i], 128, 0x7F),
)

///|
/// The gb18030 ranges index as parallel arrays of pointers and code points.
priv struct Gb18030Ranges {
  pointers : Array[Int32]
  code_points : Array[Int32]
}

///|
let gb18030_ranges_cache : Ref[Gb18030Ranges?] = Ref(None)

///|
fn gb18030_ranges() -> Gb18030Ranges {
  match gb18030_ranges_cache.val {
    Some(r) => r
    None => {
      let r = { pointers: [], code_points: [], }
      let mut is_pointer = true
      let mut p = 0
      let mut c = 0
      each_packed_number(gb18030_ranges_data, v => {
        if is_pointer {
          p += v
        } else {
          c += v
          r.pointers.push(p)
          r.code_points.push(c)
        }
        is_pointer = !is_pointer
      })
      gb18030_ranges_cache.val = Some(r)
      r
    }
  }
}

///|
/// The index gb18030 ranges code point for `pointer`, or -1 if none.
fn gb18030_ranges_code_point(pointer : Int32) -> Int32 {
  if (pointer > 39419 && pointer < 189000) || pointer > 1237575 {
    return -1
  }
  if pointer == 7457 {
    return 0xE7C7
  }
  let r = gb18030_ranges()
  // Find the last range whose pointer is <= `pointer`.
  let mut lo = 0
  let mut hi = r.pointers.length()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if r.pointers[mid] <= pointer {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  r.code_points[lo - 1] + pointer - r.pointers[lo - 1]
}
