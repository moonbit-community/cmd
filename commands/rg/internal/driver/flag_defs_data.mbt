  },
  {
    is_switch: true,
    name_short: None,
    name_long: "no-ignore-global",
    aliases: [],
    name_negated: Some("ignore-global"),
    doc_variable: None,
    doc_category: Filter,
    doc_short: "Don't use global ignore files.",
    doc_long: "\nDon't respect filter rules from ignore files that come from \"global\" sources\nsuch as \\fBgit\\fP's \\fBcore.excludesFile\\fP configuration option (which\ndefaults to \\fB$HOME/.config/git/ignore\\fP).\n",
    doc_choices: [],
