///|
async test "rg_compat_hyperlink_context" {
  // rg -n -H --no-heading -C1 --hyperlink-format grep+ -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Watson"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let env = @printer.HyperlinkEnvironment::new()
    .host(None)
    .canonicalize(Some(path => fake_canonicalize(path)))
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
    hyperlink=@printer.HyperlinkFormat::parse("grep+").into_config(env),
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}]8;;grep+:///work/sherlock:1\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m\u{1b}]8;;\u{1b}\\:For the Doctor \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0ms of this world, as opposed to the Sherlock\n\u{1b}]8;;grep+:///work/sherlock:2\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m2\u{1b}[0m\u{1b}]8;;\u{1b}\\-Holmeses, success in the province of detective work must always\n--\n\u{1b}]8;;grep+:///work/sherlock:4\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m4\u{1b}[0m\u{1b}]8;;\u{1b}\\-can extract a clew from a wisp of straw or a flake of cigar ash;\n\u{1b}]8;;grep+:///work/sherlock:5\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m5\u{1b}[0m\u{1b}]8;;\u{1b}\\:but Doctor \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0m has to have it taken out for him and dusted,\n\u{1b}]8;;grep+:///work/sherlock:6\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m6\u{1b}[0m\u{1b}]8;;\u{1b}\\-and exhibited clearly, with a label attached.\n",
  )
}

///|
async test "rg_compat_summary_count_hyperlink" {
  // rg -c -H --hyperlink-format vscode -e Sherlock sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Sherlock"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let env = @printer.HyperlinkEnvironment::new()
    .host(None)
    .canonicalize(Some(path => fake_canonicalize(path)))
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Summary::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    kind=@printer.SummaryKind::Count,
    path=true,
    hyperlink=@printer.HyperlinkFormat::parse("vscode").into_config(env),
  )
  @searcher.SearcherBuilder::new()
  .line_number(false)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}]8;;vscode://file/work/sherlock:1:1\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m\u{1b}]8;;\u{1b}\\:2\n",
  )
}

///|
async test "rg_compat_path_printer_basic" {
  // rg --files sherlock
  let out = @termcolor.ByteVec::new()
  let printer = @printer.PathPrinter::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
  )
  printer.write("sherlock")
  assert_eq(contents(out), "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m\n")
}

///|
async test "rg_compat_path_printer_null_sep" {
  // rg --files -0 --path-separator @ --hyperlink-format vscode ./sherlock
  let env = @printer.HyperlinkEnvironment::new()
    .host(None)
    .canonicalize(Some(path => fake_canonicalize(path)))
  let out = @termcolor.ByteVec::new()
  let printer = @printer.PathPrinter::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    terminator=b'\x00',
    separator=Some(b'@'),
    hyperlink=@printer.HyperlinkFormat::parse("vscode").into_config(env),
  )
  printer.write("./sherlock")
  assert_eq(contents(out), "\u{1b}[0m\u{1b}[35m.@sherlock\u{1b}[0m\u{0}")
}

