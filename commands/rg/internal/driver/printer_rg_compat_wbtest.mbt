///|
async test "rg_compat_latin1_no_color" {
  // rg -n -H --no-heading -e Sherlock latin1
  let haystack = b"caf\xe9 Sherlock \xff\xfe\nok Sherlock\n"
  let matcher = SearchMatcher::new(
    ["Sherlock"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.NoColor::new(out),
    path=true,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "latin1"),
  )
  assert_eq(
    out.to_bytes(),
    b"latin1:1:caf\xe9 Sherlock \xff\xfe\nlatin1:2:ok Sherlock\n",
  )
}

///|
async test "rg_compat_hyperlink_vscode" {
  // rg -n -H --no-heading --hyperlink-format vscode --column -e Sherlock sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Sherlock"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let env = @printer.HyperlinkEnvironment::new()
    .host(None)
    .canonicalize(Some(path => fake_canonicalize(path)))
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
    column=true,
    hyperlink=@printer.HyperlinkFormat::parse("vscode").into_config(env),
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}]8;;vscode://file/work/sherlock:1:57\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m57\u{1b}[0m\u{1b}]8;;\u{1b}\\:For the Doctor Watsons of this world, as opposed to the \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\n\u{1b}]8;;vscode://file/work/sherlock:3:49\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m49\u{1b}[0m\u{1b}]8;;\u{1b}\\:be, to a very large extent, the result of luck. \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m Holmes\n",
  )
}

///|
async test "rg_compat_hyperlink_heading_file" {
  // rg -n -H --heading --hyperlink-format file -e Sherlock sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Sherlock"],
