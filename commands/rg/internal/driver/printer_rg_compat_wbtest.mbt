///|
async test "rg_compat_json_basic" {
  // rg --json -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Watson"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"sherlock\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"For the Doctor Watsons of this world, as opposed to the Sherlock\\n\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Watson\"},\"start\":15,\"end\":21}]}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"but Doctor Watson has to have it taken out for him and dusted,\\n\"},\"line_number\":5,\"absolute_offset\":258,\"submatches\":[{\"match\":{\"text\":\"Watson\"},\"start\":11,\"end\":17}]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":367,\"bytes_printed\":529,\"matched_lines\":2,\"matches\":2}}}\n",
  )
}

///|
async test "rg_compat_json_pretty_context" {
  // rg --json -C1 -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Watson"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out, pretty=true)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "{\n  \"type\": \"begin\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"sherlock\"\n    }\n  }\n}\n{\n  \"type\": \"match\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"sherlock\"\n    },\n    \"lines\": {\n      \"text\": \"For the Doctor Watsons of this world, as opposed to the Sherlock\\n\"\n    },\n    \"line_number\": 1,\n    \"absolute_offset\": 0,\n    \"submatches\": [\n      {\n        \"match\": {\n          \"text\": \"Watson\"\n        },\n        \"start\": 15,\n        \"end\": 21\n      }\n    ]\n  }\n}\n{\n  \"type\": \"context\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"sherlock\"\n    },\n    \"lines\": {\n      \"text\": \"Holmeses, success in the province of detective work must always\\n\"\n    },\n    \"line_number\": 2,\n    \"absolute_offset\": 65,\n    \"submatches\": []\n  }\n}\n{\n  \"type\": \"context\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"sherlock\"\n    },\n    \"lines\": {\n      \"text\": \"can extract a clew from a wisp of straw or a flake of cigar ash;\\n\"\n    },\n    \"line_number\": 4,\n    \"absolute_offset\": 193,\n    \"submatches\": []\n  }\n}\n{\n  \"type\": \"match\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"sherlock\"\n    },\n    \"lines\": {\n      \"text\": \"but Doctor Watson has to have it taken out for him and dusted,\\n\"\n    },\n    \"line_number\": 5,\n    \"absolute_offset\": 258,\n    \"submatches\": [\n      {\n        \"match\": {\n          \"text\": \"Watson\"\n        },\n        \"start\": 11,\n        \"end\": 17\n      }\n    ]\n  }\n}\n{\n  \"type\": \"context\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"sherlock\"\n    },\n    \"lines\": {\n      \"text\": \"and exhibited clearly, with a label attached.\\n\"\n    },\n    \"line_number\": 6,\n    \"absolute_offset\": 321,\n    \"submatches\": []\n  }\n}\n{\n  \"type\": \"end\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"sherlock\"\n    },\n    \"binary_offset\": null,\n    \"stats\": {\n      \"elapsed\": {\n        \"secs\": 0,\n        \"nanos\": 0,\n        \"human\": \"0.000000s\"\n      },\n      \"searches\": 1,\n      \"searches_with_match\": 1,\n      \"bytes_searched\": 367,\n      \"bytes_printed\": 1604,\n      \"matched_lines\": 2,\n      \"matches\": 2\n    }\n  }\n}\n",
  )
}

///|
async test "rg_compat_json_pretty_non_utf8" {
  // rg --json -e Sherlock latin1
  let haystack = b"caf\xe9 Sherlock \xff\xfe\nok Sherlock\n"
  let matcher = SearchMatcher::new(
    ["Sherlock"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out, pretty=true)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "latin1"),
  )
  assert_eq(
    contents(out),
    "{\n  \"type\": \"begin\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"latin1\"\n    }\n  }\n}\n{\n  \"type\": \"match\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"latin1\"\n    },\n    \"lines\": {\n      \"bytes\": \"Y2Fm6SBTaGVybG9jayD//go=\"\n    },\n    \"line_number\": 1,\n    \"absolute_offset\": 0,\n    \"submatches\": [\n      {\n        \"match\": {\n          \"text\": \"Sherlock\"\n        },\n        \"start\": 5,\n        \"end\": 13\n      }\n    ]\n  }\n}\n{\n  \"type\": \"match\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"latin1\"\n    },\n    \"lines\": {\n      \"text\": \"ok Sherlock\\n\"\n    },\n    \"line_number\": 2,\n    \"absolute_offset\": 17,\n    \"submatches\": [\n      {\n        \"match\": {\n          \"text\": \"Sherlock\"\n        },\n        \"start\": 3,\n        \"end\": 11\n      }\n    ]\n  }\n}\n{\n  \"type\": \"end\",\n  \"data\": {\n    \"path\": {\n      \"text\": \"latin1\"\n    },\n    \"binary_offset\": null,\n    \"stats\": {\n      \"elapsed\": {\n        \"secs\": 0,\n        \"nanos\": 0,\n        \"human\": \"0.000000s\"\n      },\n      \"searches\": 1,\n      \"searches_with_match\": 1,\n      \"bytes_searched\": 29,\n      \"bytes_printed\": 739,\n      \"matched_lines\": 2,\n      \"matches\": 2\n    }\n  }\n}\n",
  )
}

///|
async test "rg_compat_json_context" {
  // rg --json -C1 -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Watson"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"sherlock\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"For the Doctor Watsons of this world, as opposed to the Sherlock\\n\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Watson\"},\"start\":15,\"end\":21}]}}\n{\"type\":\"context\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"Holmeses, success in the province of detective work must always\\n\"},\"line_number\":2,\"absolute_offset\":65,\"submatches\":[]}}\n{\"type\":\"context\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"can extract a clew from a wisp of straw or a flake of cigar ash;\\n\"},\"line_number\":4,\"absolute_offset\":193,\"submatches\":[]}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"but Doctor Watson has to have it taken out for him and dusted,\\n\"},\"line_number\":5,\"absolute_offset\":258,\"submatches\":[{\"match\":{\"text\":\"Watson\"},\"start\":11,\"end\":17}]}}\n{\"type\":\"context\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"and exhibited clearly, with a label attached.\\n\"},\"line_number\":6,\"absolute_offset\":321,\"submatches\":[]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":367,\"bytes_printed\":1093,\"matched_lines\":2,\"matches\":2}}}\n",
  )
}

///|
async test "rg_compat_json_replace" {
  // rg --json -r '<$0>' -e 'Sher(lock)' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Sher(lock)"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out, replacement=Some(b"<$0>"))
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"sherlock\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"For the Doctor Watsons of this world, as opposed to the Sherlock\\n\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Sherlock\"},\"replacement\":{\"text\":\"<Sherlock>\"},\"start\":56,\"end\":64}]}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"be, to a very large extent, the result of luck. Sherlock Holmes\\n\"},\"line_number\":3,\"absolute_offset\":129,\"submatches\":[{\"match\":{\"text\":\"Sherlock\"},\"replacement\":{\"text\":\"<Sherlock>\"},\"start\":48,\"end\":56}]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":367,\"bytes_printed\":606,\"matched_lines\":2,\"matches\":2}}}\n",
  )
}

///|
async test "rg_compat_json_invert" {
  // rg --json -v -n -e o sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["o"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .invert_match(true)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"sherlock\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"and exhibited clearly, with a label attached.\\n\"},\"line_number\":6,\"absolute_offset\":321,\"submatches\":[]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":367,\"bytes_printed\":227,\"matched_lines\":1,\"matches\":0}}}\n",
  )
}

///|
async test "rg_compat_json_non_utf8" {
  // rg --json -e Sherlock latin1
  let haystack = b"caf\xe9 Sherlock \xff\xfe\nok Sherlock\n"
  let matcher = SearchMatcher::new(
    ["Sherlock"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "latin1"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"latin1\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"latin1\"},\"lines\":{\"bytes\":\"Y2Fm6SBTaGVybG9jayD//go=\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Sherlock\"},\"start\":5,\"end\":13}]}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"latin1\"},\"lines\":{\"text\":\"ok Sherlock\\n\"},\"line_number\":2,\"absolute_offset\":17,\"submatches\":[{\"match\":{\"text\":\"Sherlock\"},\"start\":3,\"end\":11}]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"latin1\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":29,\"bytes_printed\":432,\"matched_lines\":2,\"matches\":2}}}\n",
  )
}

///|
async test "rg_compat_json_binary" {
  // rg --json -e Sherlock bin2
  let haystack = b"Sherlock first\nmiddle\x00\nSherlock again\n"
  let matcher = SearchMatcher::new(
    ["Sherlock"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "bin2"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"bin2\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"bin2\"},\"lines\":{\"text\":\"Sherlock first\\n\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Sherlock\"},\"start\":0,\"end\":8}]}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"bin2\"},\"lines\":{\"text\":\"Sherlock again\\n\"},\"line_number\":4,\"absolute_offset\":23,\"submatches\":[{\"match\":{\"text\":\"Sherlock\"},\"start\":0,\"end\":8}]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"bin2\"},\"binary_offset\":21,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":38,\"bytes_printed\":418,\"matched_lines\":2,\"matches\":2}}}\n",
  )
}

///|
async test "rg_compat_json_multiline" {
  // rg --json -U -e 'Sherlock\nHolmeses' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = SearchMatcher::new(
    ["Sherlock\\nHolmeses"],
    multi_line=true,
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .multi_line(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"sherlock\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"For the Doctor Watsons of this world, as opposed to the Sherlock\\nHolmeses, success in the province of detective work must always\\n\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Sherlock\\nHolmeses\"},\"start\":56,\"end\":73}]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":367,\"bytes_printed\":368,\"matched_lines\":2,\"matches\":1}}}\n",
  )
}
