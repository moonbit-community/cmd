  assert_eq(
    contents(out),
    "\u{1b}]8;;file://myhost/work/sherlock\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the Doctor Watsons of this world, as opposed to the \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m:be, to a very large extent, the result of luck. \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m Holmes\n",
  )
}

