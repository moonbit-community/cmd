///|
/// Canonicalizes paths of files that exist in the test data directory
/// (mounted at `/work`), failing for anything else.
fn fake_canonicalize(p : String) -> String? {
  match p {
    "sherlock" | "./sherlock" => Some("/work/sherlock")
    _ => None
  }
}

// Tests generated by running the real `rg` (ripgrep 15.1.0) and comparing
// the printer output byte for byte. Absolute paths are normalized to
// `/work`, the hostname to `myhost` and JSON timings to zero.
// CLI-equivalent cases now live in tests/cases/rg.json. These cases retain
// injected paths/timing, binary conversion or byte-decoding behavior that is
// not equivalent to an ordinary command invocation.

///|
async test "rg_compat_binary_convert" {
  // rg -n -H --no-heading -e Sherlock bin2
  let haystack = b"Sherlock first\nmiddle\x00\nSherlock again\n"
  let matcher = SearchMatcher::new(
    ["Sherlock"],
    multi_line=true,
    line_terminator=Some(b'\n').map(@matcher.LineTerminator::byte),
    ban=Some(b'\x00'),
  )
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "bin2"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35mbin2\u{1b}[0m: binary file matches (found \"\\0\" byte around offset 21)\n",
  )
}

