async test "rg_compat_hyperlink_heading_kitty" {
  // rg -n -H --heading --hyperlink-format kitty -e Sherlock sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherlock")
  let env = @printer.HyperlinkEnvironment::new()
    .host(Some("myhost"))
    .canonicalize(Some(path => fake_canonicalize(path)))
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
    heading=true,
    hyperlink=@printer.HyperlinkFormat::parse("kitty").into_config(env),
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}]8;;file://myhost/work/sherlock#1\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}]8;;file://myhost/work/sherlock#1\u{1b}\\\u{1b}[0m\u{1b}[32m1\u{1b}[0m\u{1b}]8;;\u{1b}\\:For the Doctor Watsons of this world, as opposed to the \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\n\u{1b}]8;;file://myhost/work/sherlock#3\u{1b}\\\u{1b}[0m\u{1b}[32m3\u{1b}[0m\u{1b}]8;;\u{1b}\\:be, to a very large extent, the result of luck. \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m Holmes\n",
  )
}

///|
async test "rg_compat_hyperlink_context" {
  // rg -n -H --no-heading -C1 --hyperlink-format grep+ -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Watson")
  let env = @printer.HyperlinkEnvironment::new()
    .host(None)
    .canonicalize(Some(path => fake_canonicalize(path)))
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
    hyperlink=@printer.HyperlinkFormat::parse("grep+").into_config(env),
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}]8;;grep+:///work/sherlock:1\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m\u{1b}]8;;\u{1b}\\:For the Doctor \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0ms of this world, as opposed to the Sherlock\n\u{1b}]8;;grep+:///work/sherlock:2\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m2\u{1b}[0m\u{1b}]8;;\u{1b}\\-Holmeses, success in the province of detective work must always\n--\n\u{1b}]8;;grep+:///work/sherlock:4\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m4\u{1b}[0m\u{1b}]8;;\u{1b}\\-can extract a clew from a wisp of straw or a flake of cigar ash;\n\u{1b}]8;;grep+:///work/sherlock:5\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m5\u{1b}[0m\u{1b}]8;;\u{1b}\\:but Doctor \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0m has to have it taken out for him and dusted,\n\u{1b}]8;;grep+:///work/sherlock:6\u{1b}\\\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m6\u{1b}[0m\u{1b}]8;;\u{1b}\\-and exhibited clearly, with a label attached.\n",
  )
}

///|
async test "rg_compat_passthru" {
  // rg -n --passthru -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Watson")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .passthru(true)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the Doctor \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0ms of this world, as opposed to the Sherlock\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m-Holmeses, success in the province of detective work must always\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m-be, to a very large extent, the result of luck. Sherlock Holmes\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m-can extract a clew from a wisp of straw or a flake of cigar ash;\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:but Doctor \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0m has to have it taken out for him and dusted,\n\u{1b}[0m\u{1b}[32m6\u{1b}[0m-and exhibited clearly, with a label attached.\n",
  )
}

///|
async test "rg_compat_max_count_after" {
  // rg -n -m1 -A2 -e Doctor sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Doctor")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .max_matches(Some(1))
  .after_context(2)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the \u{1b}[0m\u{1b}[1m\u{1b}[31mDoctor\u{1b}[0m Watsons of this world, as opposed to the Sherlock\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m-Holmeses, success in the province of detective work must always\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m-be, to a very large extent, the result of luck. Sherlock Holmes\n",
  )
}

///|
async test "rg_compat_crlf" {
  // rg -n --crlf -e 'Sherlock$|^can' crlf
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\r\nHolmeses, success in the province of detective work must always\r\nbe, to a very large extent, the result of luck. Sherlock Holmes\r\ncan extract a clew from a wisp of straw or a flake of cigar ash;\r\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .crlf(true)
    .build("Sherlock$|^can")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .line_terminator(@matcher.LineTerminator::crlf())
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "crlf"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the Doctor Watsons of this world, as opposed to the \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\r\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mcan\u{1b}[0m extract a clew from a wisp of straw or a flake of cigar ash;\r\n",
  )
}

