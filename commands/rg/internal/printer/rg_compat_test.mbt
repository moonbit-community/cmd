  )
}

///|
async test "rg_compat_byte_offset_only_matching" {
  // rg -n -b -o -e 'o[a-z]' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("o[a-z]")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
    byte_offset=true,
    only_matching=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mor\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m9\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31moc\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m12\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mor\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m19\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mon\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m23\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mof\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m32\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mor\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m41\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mop\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m44\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mos\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m61\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31moc\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m66\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mol\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m92\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mov\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m99\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mof\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m113\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mor\u{1b}[0m\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m168\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mof\u{1b}[0m\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m182\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31moc\u{1b}[0m\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m187\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mol\u{1b}[0m\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m214\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mom\u{1b}[0m\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m224\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mof\u{1b}[0m\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m233\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mor\u{1b}[0m\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m244\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mof\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m263\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31moc\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m266\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mor\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m273\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mon\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m297\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mou\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m302\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mor\u{1b}[0m\n",
  )
}

///|
async test "rg_compat_column_context" {
  // rg -n --column -C1 -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Watson")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
    column=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m16\u{1b}[0m:For the Doctor \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0ms of this world, as opposed to the Sherlock\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m-Holmeses, success in the province of detective work must always\n--\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m-can extract a clew from a wisp of straw or a flake of cigar ash;\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m12\u{1b}[0m:but Doctor \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0m has to have it taken out for him and dusted,\n\u{1b}[0m\u{1b}[32m6\u{1b}[0m-and exhibited clearly, with a label attached.\n",
  )
}

///|
async test "rg_compat_max_columns_context" {
  // rg -n -M 20 -C1 -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Watson")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
    max_columns=Some(20),
