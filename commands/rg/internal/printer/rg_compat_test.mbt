  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\r\nHolmeses, success in the province of detective work must always\r\nbe, to a very large extent, the result of luck. Sherlock Holmes\r\ncan extract a clew from a wisp of straw or a flake of cigar ash;\r\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
