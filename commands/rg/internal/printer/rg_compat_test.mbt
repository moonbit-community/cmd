  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:[Omitted long line with 1 matches]\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m-[Omitted long context line]\n--\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m-[Omitted long context line]\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:[Omitted long line with 1 matches]\n\u{1b}[0m\u{1b}[32m6\u{1b}[0m-[Omitted long context line]\n",
  )
}

///|
async test "rg_compat_max_columns_only_matching_preview" {
  // rg -n -o -M 5 --max-columns-preview -e Sherlock sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherlock")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
    max_columns=Some(5),
    max_columns_preview=true,
    only_matching=true,
