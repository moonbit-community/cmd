///|
async test "rg_compat_graphemes_max_columns_preview" {
  // rg -n -M 9 --max-columns-preview -e Sherlock graph
  let haystack = b"e\xcc\x81e\xcc\x81e\xcc\x81 \xf0\x9f\x87\xba\xf0\x9f\x87\xb8 Sherlock and more text after the match Sherlock\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherlock")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
    max_columns=Some(9),
    max_columns_preview=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "graph"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:ééé 🇺🇸 \u{1b}[0m\u{1b}[1m\u{1b}[31mShe\u{1b}[0m [... 1 more match]\n",
  )
}

///|
async test "rg_compat_custom_colors" {
  // rg -n -H --no-heading --colors match:bg:yellow --colors match:fg:0x10 --colors line:style:underline --colors path:fg:255,0,128 --colors highlight:bg:blue --colors column:fg:cyan --colors column:style:intense --column -e Sherlock sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherlock")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::new(
      [
        ..@printer.default_color_specs(),
        @printer.UserColorSpec::parse("match:bg:yellow"),
        @printer.UserColorSpec::parse("match:fg:0x10"),
        @printer.UserColorSpec::parse("line:style:underline"),
        @printer.UserColorSpec::parse("path:fg:255,0,128"),
        @printer.UserColorSpec::parse("highlight:bg:blue"),
        @printer.UserColorSpec::parse("column:fg:cyan"),
        @printer.UserColorSpec::parse("column:style:intense"),
      ],
    ),
    path=true,
    per_match_one_line=true,
    column=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[38;2;255;0;128msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[4m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[38;5;14m57\u{1b}[0m:\u{1b}[0m\u{1b}[44mFor the Doctor Watsons of this world, as opposed to the \u{1b}[0m\u{1b}[1m\u{1b}[38;5;16m\u{1b}[43mSherlock\u{1b}[0m\u{1b}[44m\u{1b}[0m\n\u{1b}[0m\u{1b}[38;2;255;0;128msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[4m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m\u{1b}[38;5;14m49\u{1b}[0m:\u{1b}[0m\u{1b}[44mbe, to a very large extent, the result of luck. \u{1b}[0m\u{1b}[1m\u{1b}[38;5;16m\u{1b}[43mSherlock\u{1b}[0m\u{1b}[44m Holmes\u{1b}[0m\n",
  )
}

///|
async test "rg_compat_colors_none" {
  // rg -n -H --no-heading --colors match:none --colors path:none -C1 -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Watson")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::new(
      [
        ..@printer.default_color_specs(),
        @printer.UserColorSpec::parse("match:none"),
        @printer.UserColorSpec::parse("path:none"),
      ],
    ),
    path=true,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the Doctor Watsons of this world, as opposed to the Sherlock\n\u{1b}[0msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m2\u{1b}[0m-Holmeses, success in the province of detective work must always\n--\n\u{1b}[0msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m4\u{1b}[0m-can extract a clew from a wisp of straw or a flake of cigar ash;\n\u{1b}[0msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m5\u{1b}[0m:but Doctor Watson has to have it taken out for him and dusted,\n\u{1b}[0msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m6\u{1b}[0m-and exhibited clearly, with a label attached.\n",
  )
}

///|
async test "rg_compat_trim" {
  // rg -n --trim -e 'Sherlock|Watson' indented
  let haystack = b"   indented Sherlock line\n\tTabbed Watson\nplain\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherlock|Watson")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
    trim_ascii=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "indented"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:indented \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m line\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:Tabbed \u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0m\n",
  )
}

///|
async test "rg_compat_trim_only_matching" {
  // rg -n --trim -o -e '\s+\S+' indented
  let haystack = b"   indented Sherlock line\n\tTabbed Watson\nplain\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("\\s+\\S+")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
    trim_ascii=true,
    only_matching=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
