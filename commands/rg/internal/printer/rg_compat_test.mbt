///|
/// Canonicalizes paths of files that exist in the test data directory
/// (mounted at `/work`), failing for anything else.
fn fake_canonicalize(p : String) -> String? {
  match p {
    "sherlock" | "./sherlock" => Some("/work/sherlock")
    _ => None
  }
}

// Tests generated by running the real `rg` (ripgrep 15.1.0) and comparing
// the printer output byte for byte. Absolute paths are normalized to
// `/work`, the hostname to `myhost` and JSON timings to zero.

///|
async test "rg_compat_color_basic" {
  // rg -n -H --no-heading -e Sherlock sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherlock")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the Doctor Watsons of this world, as opposed to the \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m3\u{1b}[0m:be, to a very large extent, the result of luck. \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m Holmes\n",
  )
}

