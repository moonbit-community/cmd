///|
async test "rg_compat_json_basic" {
  // rg --json -e Watson sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Watson")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"sherlock\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"For the Doctor Watsons of this world, as opposed to the Sherlock\\n\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Watson\"},\"start\":15,\"end\":21}]}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"but Doctor Watson has to have it taken out for him and dusted,\\n\"},\"line_number\":5,\"absolute_offset\":258,\"submatches\":[{\"match\":{\"text\":\"Watson\"},\"start\":11,\"end\":17}]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":367,\"bytes_printed\":529,\"matched_lines\":2,\"matches\":2}}}\n",
  )
}

