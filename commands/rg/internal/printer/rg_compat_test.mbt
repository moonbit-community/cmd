  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherl\\w+|Hol\\w+")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
    only_matching=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mHolmeses\u{1b}[0m\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mHolmes\u{1b}[0m\n",
  )
}

///|
async test "rg_compat_color_vimgrep" {
  // rg --vimgrep -e 'Doctor|Holmes' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Doctor|Holmes")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
    column=true,
    per_match=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m9\u{1b}[0m:For the \u{1b}[0m\u{1b}[1m\u{1b}[31mDoctor\u{1b}[0m Watsons of this world, as opposed to the Sherlock\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mHolmes\u{1b}[0mes, success in the province of detective work must always\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m58\u{1b}[0m:be, to a very large extent, the result of luck. Sherlock \u{1b}[0m\u{1b}[1m\u{1b}[31mHolmes\u{1b}[0m\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m5\u{1b}[0m:but \u{1b}[0m\u{1b}[1m\u{1b}[31mDoctor\u{1b}[0m Watson has to have it taken out for him and dusted,\n",
  )
}

///|
async test "rg_compat_color_replace" {
  // rg -n -H --no-heading -r '[$1]' -e 'Sher(lock)' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sher(lock)")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
    replacement=Some(b"[$1]"),
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the Doctor Watsons of this world, as opposed to the \u{1b}[0m\u{1b}[1m\u{1b}[31m[lock]\u{1b}[0m\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m3\u{1b}[0m:be, to a very large extent, the result of luck. \u{1b}[0m\u{1b}[1m\u{1b}[31m[lock]\u{1b}[0m Holmes\n",
  )
}

///|
async test "rg_compat_color_replace_only_matching" {
  // rg -n -o -r '<$0>' -e 'o[a-z]' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("o[a-z]")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=false,
    per_match_one_line=true,
    replacement=Some(b"<$0>"),
    only_matching=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<or>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<oc>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<or>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<on>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<of>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<or>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<op>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<os>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<oc>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<ol>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<ov>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<of>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<or>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<of>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<oc>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m3\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<ol>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<om>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<of>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<or>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<of>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<oc>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<or>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<on>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<ou>\u{1b}[0m\n\u{1b}[0m\u{1b}[32m5\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31m<or>\u{1b}[0m\n",
  )
}

///|
async test "rg_compat_color_multiline" {
  // rg -n -H --no-heading -U -e 'Sherlock\nHolmeses' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .ban_byte(Some(b'\x00'))
    .build("Sherlock\\nHolmeses")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .multi_line(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the Doctor Watsons of this world, as opposed to the \u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mHolmeses\u{1b}[0m, success in the province of detective work must always\n",
  )
}

///|
async test "rg_compat_color_multiline_context" {
  // rg -n -H --no-heading -U -C1 -e 'luck\. Sherlock Holmes\ncan' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .ban_byte(Some(b'\x00'))
    .build("luck\\. Sherlock Holmes\\ncan")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .multi_line(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m2\u{1b}[0m-Holmeses, success in the province of detective work must always\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m3\u{1b}[0m:be, to a very large extent, the result of \u{1b}[0m\u{1b}[1m\u{1b}[31mluck. Sherlock Holmes\u{1b}[0m\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m4\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mcan\u{1b}[0m extract a clew from a wisp of straw or a flake of cigar ash;\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m5\u{1b}[0m-but Doctor Watson has to have it taken out for him and dusted,\n",
  )
}

