///|
async test "rg_compat_json_binary" {
  // rg --json -e Sherlock bin2
  let haystack = b"Sherlock first\nmiddle\x00\nSherlock again\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherlock")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "bin2"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"bin2\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"bin2\"},\"lines\":{\"text\":\"Sherlock first\\n\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Sherlock\"},\"start\":0,\"end\":8}]}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"bin2\"},\"lines\":{\"text\":\"Sherlock again\\n\"},\"line_number\":4,\"absolute_offset\":23,\"submatches\":[{\"match\":{\"text\":\"Sherlock\"},\"start\":0,\"end\":8}]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"bin2\"},\"binary_offset\":21,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":38,\"bytes_printed\":418,\"matched_lines\":2,\"matches\":2}}}\n",
  )
}

///|
async test "rg_compat_json_multiline" {
  // rg --json -U -e 'Sherlock\nHolmeses' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .ban_byte(Some(b'\x00'))
    .build("Sherlock\\nHolmeses")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.JSON::new(out)
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .multi_line(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "{\"type\":\"begin\",\"data\":{\"path\":{\"text\":\"sherlock\"}}}\n{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"lines\":{\"text\":\"For the Doctor Watsons of this world, as opposed to the Sherlock\\nHolmeses, success in the province of detective work must always\\n\"},\"line_number\":1,\"absolute_offset\":0,\"submatches\":[{\"match\":{\"text\":\"Sherlock\\nHolmeses\"},\"start\":56,\"end\":73}]}}\n{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"sherlock\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0,\"human\":\"0.000000s\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":367,\"bytes_printed\":368,\"matched_lines\":2,\"matches\":1}}}\n",
  )
}
