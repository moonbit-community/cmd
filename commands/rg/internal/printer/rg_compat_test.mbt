    reader(haystack),
    printer.sink_with_path(matcher, "indented"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mindented\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mSherlock\u{1b}[0m\n\u{1b}[0m\u{1b}[32m1\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mline\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mTabbed\u{1b}[0m\n\u{1b}[0m\u{1b}[32m2\u{1b}[0m:\u{1b}[0m\u{1b}[1m\u{1b}[31mWatson\u{1b}[0m\n",
  )
}

///|
async test "rg_compat_invert" {
  // rg -n -H --no-heading -v -e 'Sherlock|Watson' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Sherlock|Watson")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .invert_match(true)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m2\u{1b}[0m:Holmeses, success in the province of detective work must always\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m4\u{1b}[0m:can extract a clew from a wisp of straw or a flake of cigar ash;\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m6\u{1b}[0m:and exhibited clearly, with a label attached.\n",
  )
}

///|
async test "rg_compat_invert_context" {
  // rg -n -H --no-heading -v -C1 -e 'Holmeses|cigar' sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Holmeses|cigar")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .invert_match(true)
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m1\u{1b}[0m:For the Doctor Watsons of this world, as opposed to the Sherlock\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m2\u{1b}[0m-\u{1b}[0m\u{1b}[1m\u{1b}[31mHolmeses\u{1b}[0m, success in the province of detective work must always\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m3\u{1b}[0m:be, to a very large extent, the result of luck. Sherlock Holmes\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m-\u{1b}[0m\u{1b}[32m4\u{1b}[0m-can extract a clew from a wisp of straw or a flake of \u{1b}[0m\u{1b}[1m\u{1b}[31mcigar\u{1b}[0m ash;\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m5\u{1b}[0m:but Doctor Watson has to have it taken out for him and dusted,\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m:\u{1b}[0m\u{1b}[32m6\u{1b}[0m:and exhibited clearly, with a label attached.\n",
  )
}

///|
async test "rg_compat_separators" {
  // rg -n -H --no-heading -C1 --field-match-separator :: --field-context-separator '~~' --context-separator '##' -e Doctor sherlock
  let haystack = b"For the Doctor Watsons of this world, as opposed to the Sherlock\nHolmeses, success in the province of detective work must always\nbe, to a very large extent, the result of luck. Sherlock Holmes\ncan extract a clew from a wisp of straw or a flake of cigar ash;\nbut Doctor Watson has to have it taken out for him and dusted,\nand exhibited clearly, with a label attached.\n"
  let matcher = @grep_regex.RegexMatcherBuilder::new()
    .multi_line(true)
    .line_terminator(Some(b'\n'))
    .ban_byte(Some(b'\x00'))
    .build("Doctor")
  let out = @termcolor.ByteVec::new()
  let printer = @printer.Standard::new(
    @termcolor.Ansi::new(out),
    colors=@printer.ColorSpecs::default_with_color(),
    path=true,
    per_match_one_line=true,
    separator_field_match=b"::",
    separator_field_context=b"~~",
    separator_context=Some(b"##"),
  )
  @searcher.SearcherBuilder::new()
  .line_number(true)
  .binary_detection(@searcher.BinaryDetection::BinaryConvert(b'\x00'))
  .before_context(1)
  .after_context(1)
  .build()
  .search_reader(
    matcher,
    reader(haystack),
    printer.sink_with_path(matcher, "sherlock"),
  )
  assert_eq(
    contents(out),
    "\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m::\u{1b}[0m\u{1b}[32m1\u{1b}[0m::For the \u{1b}[0m\u{1b}[1m\u{1b}[31mDoctor\u{1b}[0m Watsons of this world, as opposed to the Sherlock\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m~~\u{1b}[0m\u{1b}[32m2\u{1b}[0m~~Holmeses, success in the province of detective work must always\n##\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m~~\u{1b}[0m\u{1b}[32m4\u{1b}[0m~~can extract a clew from a wisp of straw or a flake of cigar ash;\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m::\u{1b}[0m\u{1b}[32m5\u{1b}[0m::but \u{1b}[0m\u{1b}[1m\u{1b}[31mDoctor\u{1b}[0m Watson has to have it taken out for him and dusted,\n\u{1b}[0m\u{1b}[35msherlock\u{1b}[0m~~\u{1b}[0m\u{1b}[32m6\u{1b}[0m~~and exhibited clearly, with a label attached.\n",
  )
}

