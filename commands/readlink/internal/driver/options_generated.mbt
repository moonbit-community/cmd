fn metadata_help() -> String {
  "Usage: readlink -e|-f|-m [-nzv] FILE...\n  -f, --canonicalize  Allow a missing final component.\n  -e, --canonicalize-existing  Require every component to exist.\n  -m, --canonicalize-missing  Allow missing components.\n  -z, --zero  Terminate paths with NUL.\n  -n, --no-newline  Omit the newline for a single operand.\n  -v, --verbose  Report lookup errors.\n  --help  Show command help.\n  --version  Show the package version.\n\nPhysical canonicalization can resolve existing links. Reading stored link text, including the spelling of a dangling target, requires a public Wasm binding.\n"
}

