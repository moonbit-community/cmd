import {
  "cli/core/bytesearch",
  "moonbitlang/core/argparse",
  "moonbitlang/async/fs" @async_fs,
  "moonbitlang/async/io",
  "moonbitlang/async/os_error",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/simd",
}

warnings = "-alert_experimental"

supported_targets = "wasm"

options(
  "allow-experimental-packages": [ "moonbitlang/core/simd" ],
)

import {
  "cli/core/stream",
} for "wbtest"

rule(
  name: "gen_version",
  command: "moonx moonbit-community/gen_version@0.0.2 -o $output",
)

dev_build(rule: "gen_version", input: "../../moon.mod", output: "version.mbt")

import {
  "moonbitlang/async",
} for "wbtest"
