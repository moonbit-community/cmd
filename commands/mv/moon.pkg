import {
  "cli/core/cli",
  "cli/core/fsops",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x/sys",
}

import {
  "moonbitlang/async/process",
  "moonbitlang/core/json",
} for "wbtest"

supported_targets = "native+wasm"

pkgtype(kind: "executable")

rule(
  name: "gen_version",
  command: "moonx moonbit-community/gen_version@0.0.2 -o $output",
)

dev_build(rule: "gen_version", input: "moon.mod", output: "version.mbt")
