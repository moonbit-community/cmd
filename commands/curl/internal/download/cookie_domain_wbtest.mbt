///|
test "curl save and file reload clear expired response cookies at distinct boundaries" {
  let input = "a.example.com\tTRUE\t/\tFALSE\t0\tsid\tfile\n"
  let url = @netops.parse_absolute_url("http://a.example.com/step/0")
  for saved in [false, true] {
    let jar = CookieJar::new()
    jar.load_netscape_at(input, 100L)
    jar.receive(
      url,
      [Cookie::new("sid", "gone", domain="a.example.com", path="/", max_age=0L)],
      100L,
    )
    assert_eq(jar.entries.length(), 1)
    assert_true(jar.entries[0].live && jar.entries[0].expired(100L))
    if saved {
      assert_eq(
        jar.netscape(now=100L),
        "# Netscape HTTP Cookie File\n# https://curl.se/docs/http-cookies.html\n# This file was generated by libcurl! Edit at your own risk.\n\n",
      )
      assert_eq(jar.entries.length(), 0)
    }
    jar.load_netscape_at(input, 101L)
    assert_eq(
      jar.header_for(url, 101L),
      if saved {
        Some("sid=file")
      } else {
        None
      },
    )
  }
}

///|
test "curl imports preserve response cookies until expiry and refill deleted keys" {
  let jar = CookieJar::new()
  let input = "a.example.com\tTRUE\t/\tFALSE\t0\tsid\tfile\n"
  let url = @netops.parse_absolute_url("http://a.example.com/step/0")
  jar.load_netscape_at(input, 100L)
  jar.receive(
    url,
    [
      Cookie::new(
        "sid",
        "response",
        domain="a.example.com",
        path="/",
        max_age=5L,
      ),
    ],
    100L,
  )
  jar.load_netscape_at(input, 101L)
  assert_eq(jar.header_for(url, 101L), Some("sid=response"))
  jar.load_netscape_at(input, 106L)
  assert_eq(jar.header_for(url, 106L), None)
  jar.load_netscape_at(input, 107L)
  assert_eq(jar.header_for(url, 107L), Some("sid=file"))
  jar.receive(
    url,
    [
      Cookie::new(
        "sid",
        "deleted",
        domain="a.example.com",
        path="/",
        max_age=0L,
      ),
    ],
    108L,
  )
  assert_eq(jar.header_for(url, 108L), None)
  jar.load_netscape_at(input, 109L)
  assert_eq(jar.header_for(url, 109L), Some("sid=file"))
}

///|
test "curl saved domain prefixes change the next process lookup exactly once" {
  let input = "..a.example.com\tTRUE\t/\tFALSE\t0\tsid\told\n"
  let jar = CookieJar::new()
  jar.load_netscape(input)
  let url = @netops.parse_absolute_url("http://a.example.com/step/0")
  assert_eq(jar.header_for(url, 100L), None)
  let saved = jar.netscape()
  assert_true(saved.contains("\n.a.example.com\tTRUE\t/\tFALSE\t0\tsid\told\n"))
  assert_false(saved.contains("\n..a.example.com"))
  let restored = CookieJar::new()
  restored.load_netscape(saved)
  assert_eq(restored.header_for(url, 100L), Some("sid=old"))
}
