  #|
  #|          Possible values:
  #|          - 1.4:  PDF 1.4
  #|          - 1.5:  PDF 1.5
  #|          - 1.6:  PDF 1.6
  #|          - 1.7:  PDF 1.7
  #|          - 2.0:  PDF 2.0
  #|          - a-1b: PDF/A-1b
  #|          - a-1a: PDF/A-1a
  #|          - a-2b: PDF/A-2b
  #|          - a-2u: PDF/A-2u
