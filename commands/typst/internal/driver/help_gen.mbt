// Generated by tools/metadata from options.json.
// Help text retains the pinned upstream Typst provenance; see NOTICE.

///|
let help_texts : ReadOnlyArray[(String, Bool, String)] = [
  (
    "", false, "Typst 0.15.1 (e58a63af)\n\nUsage: typst [OPTIONS] <COMMAND>\n\nCommands:\n  compile      Compiles an input file into a supported output format [alias: c]\n  watch        Watches an input file and recompiles on changes [alias: w]\n  init         Initializes a new project from a template\n  eval         Evaluates a piece of Typst code, optionally in the context of a\n               document\n  fonts        Lists all discovered fonts in system and custom font paths\n  completions  Generates shell completion scripts\n  info         Displays debugging information about Typst\n  help         Print this message or the help of the given subcommand(s)\n\nOptions:\n      --color <COLOR>  Whether to use color. When set to `auto`, uses color if\n                       the terminal supports it [default: auto] [possible\n                       values: auto, always, never]\n      --cert <CERT>    Path to a custom CA certificate to use when making\n                       network requests [env: TYPST_CERT=]\n  -h, --help           Print help\n  -V, --version        Print version\n\nResources:\n  Tutorial:                 https://typst.app/docs/tutorial/\n  Reference documentation:  https://typst.app/docs/reference/\n  Templates & Packages:     https://typst.app/universe/\n  Forum for questions:      https://forum.typst.app/",
  ),
  (
    "", true, "Typst 0.15.1 (e58a63af)\n\nUsage: typst [OPTIONS] <COMMAND>\n\nCommands:\n  compile      Compiles an input file into a supported output format [alias: c]\n  watch        Watches an input file and recompiles on changes [alias: w]\n  init         Initializes a new project from a template\n  eval         Evaluates a piece of Typst code, optionally in the context of a\n               document\n  fonts        Lists all discovered fonts in system and custom font paths\n  completions  Generates shell completion scripts\n  info         Displays debugging information about Typst\n  help         Print this message or the help of the given subcommand(s)\n\nOptions:\n      --color <COLOR>  Whether to use color. When set to `auto`, uses color if\n                       the terminal supports it [default: auto] [possible\n                       values: auto, always, never]\n      --cert <CERT>    Path to a custom CA certificate to use when making\n                       network requests [env: TYPST_CERT=]\n  -h, --help           Print help\n  -V, --version        Print version\n\nResources:\n  Tutorial:                 https://typst.app/docs/tutorial/\n  Reference documentation:  https://typst.app/docs/reference/\n  Templates & Packages:     https://typst.app/universe/\n  Forum for questions:      https://forum.typst.app/",
  ),
  (
    "compile", false, "Compiles an input file into a supported output format\n\nUsage: typst compile [OPTIONS] <INPUT> [OUTPUT]\n\nArguments:\n  <INPUT>   Path to input Typst file. Use `-` to read input from stdin\n  [OUTPUT]  Path to output file (PDF, PNG, SVG, or HTML). Use `-` to write\n            output to stdout\n\nOptions:\n  -f, --format <FORMAT>\n          The format of the output file, inferred from the extension by default\n          [possible values: pdf, png, svg, html, bundle]\n      --root <DIR>\n          Configures the project root (for absolute paths) [env: TYPST_ROOT=]\n  -i, --input <key=value>\n          Add a string key-value pair visible through `sys.inputs`\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts\n          [env: TYPST_FONT_PATHS=]\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path` [env: TYPST_IGNORE_SYSTEM_FONTS=]\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered [env:\n          TYPST_IGNORE_EMBEDDED_FONTS=]\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          [env: TYPST_PACKAGE_PATH=]\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          [env: TYPST_PACKAGE_CACHE_PATH=]\n      --creation-timestamp <UNIX_TIMESTAMP>\n          The document's creation date formatted as a UNIX timestamp [env:\n          SOURCE_DATE_EPOCH=]\n      --pretty[=<PRETTY>]\n          Whether to pretty-print produced output [possible values: true, false]\n      --pages <PAGES>\n          Which pages to export. When unspecified, all pages are exported\n      --pdf-standard <PDF_STANDARD>\n          One (or multiple comma-separated) PDF standards that Typst will\n          enforce conformance with [possible values: 1.4, 1.5, 1.6, 1.7, 2.0,\n          a-1b, a-1a, a-2b, a-2u, a-2a, a-3b, a-3u, a-3a, a-4, a-4f, a-4e, ua-1]\n      --pdf-tagged[=<PDF_TAGGED>]\n          Enables or disables PDF tagging [possible values: true, false]\n      --ppi <PPI>\n          The PPI (pixels per inch) to use for PNG export\n      --deps <PATH>\n          File path to which a list of current compilation's dependencies will\n          be written. Use `-` to write to stdout\n      --deps-format <DEPS_FORMAT>\n          File format to use for dependencies [default: json] [possible values:\n          json, zero, make]\n  -j, --jobs <JOBS>\n          Number of parallel jobs spawned during compilation. Defaults to number\n          of CPUs. Setting it to 1 disables parallelism\n      --features <FEATURES>\n          Enables in-development features that may be changed or removed at any\n          time [env: TYPST_FEATURES=] [possible values: html, bundle,\n          a11y-extras]\n      --diagnostic-format <DIAGNOSTIC_FORMAT>\n          The format to emit diagnostics in [env: TYPST_DIAGNOSTIC_FORMAT=]\n          [default: human] [possible values: human, short]\n      --open[=<VIEWER>]\n          Opens the output file with the default viewer or a specific program\n          after compilation. Ignored if output is stdout\n      --timings <OUTPUT_JSON>\n          Produces performance timings of the compilation process.\n          (experimental)\n  -h, --help\n          Print help (see more with '--help')",
  ),
  (
    "compile", true, "Compiles an input file into a supported output format\n\nUsage: typst compile [OPTIONS] <INPUT> [OUTPUT]\n\nArguments:\n  <INPUT>\n          Path to input Typst file. Use `-` to read input from stdin\n\n  [OUTPUT]\n          Path to output file (PDF, PNG, SVG, or HTML). Use `-` to write output\n          to stdout.\n          \n          For output formats emitting one file per page (PNG & SVG), a page\n          number template must be present if the source document renders to\n          multiple pages. Use `{p}` for page numbers, `{0p}` for zero padded\n          page numbers and `{t}` for page count. For example,\n          `page-{0p}-of-{t}.png` creates `page-01-of-10.png`,\n          `page-02-of-10.png`, and so on.\n\nOptions:\n  -f, --format <FORMAT>\n          The format of the output file, inferred from the extension by default\n          \n          [possible values: pdf, png, svg, html, bundle]\n\n      --root <DIR>\n          Configures the project root (for absolute paths)\n          \n          [env: TYPST_ROOT=]\n\n  -i, --input <key=value>\n          Add a string key-value pair visible through `sys.inputs`\n\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts.\n          \n          If multiple paths are specified, they are separated by the system's\n          path separator (`:` on Unix-like systems and `;` on Windows).\n          \n          [env: TYPST_FONT_PATHS=]\n\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path`\n          \n          [env: TYPST_IGNORE_SYSTEM_FONTS=]\n\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered\n          \n          [env: TYPST_IGNORE_EMBEDDED_FONTS=]\n\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_PATH=]\n\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_CACHE_PATH=]\n\n      --creation-timestamp <UNIX_TIMESTAMP>\n          The document's creation date formatted as a UNIX timestamp.\n          \n          For more information, see\n          <https://reproducible-builds.org/specs/source-date-epoch/>.\n          \n          [env: SOURCE_DATE_EPOCH=]\n\n      --pretty[=<PRETTY>]\n          Whether to pretty-print produced output.\n          \n          This formats the output in a more human-readable, but less\n          space-efficient way. Affects HTML, SVG, and PDF export, but not PNG\n          export.\n          \n          [possible values: true, false]\n\n      --pages <PAGES>\n          Which pages to export. When unspecified, all pages are exported.\n          \n          Pages to export are separated by commas, and can be either simple page\n          numbers (e.g. '2,5' to export only pages 2 and 5) or page ranges (e.g.\n          '2,3-6,8-' to export page 2, pages 3 to 6 (inclusive), page 8 and any\n          pages after it).\n          \n          Page numbers are one-indexed and correspond to physical page numbers\n          in the document (therefore not being affected by the document's page\n          counter).\n\n      --pdf-standard <PDF_STANDARD>\n          One (or multiple comma-separated) PDF standards that Typst will\n          enforce conformance with\n\n          Possible values:\n          - 1.4:  PDF 1.4\n          - 1.5:  PDF 1.5\n          - 1.6:  PDF 1.6\n          - 1.7:  PDF 1.7\n          - 2.0:  PDF 2.0\n          - a-1b: PDF/A-1b\n          - a-1a: PDF/A-1a\n          - a-2b: PDF/A-2b\n          - a-2u: PDF/A-2u\n          - a-2a: PDF/A-2a\n          - a-3b: PDF/A-3b\n          - a-3u: PDF/A-3u\n          - a-3a: PDF/A-3a\n          - a-4:  PDF/A-4\n          - a-4f: PDF/A-4f\n          - a-4e: PDF/A-4e\n          - ua-1: PDF/UA-1\n\n      --pdf-tagged[=<PDF_TAGGED>]\n          Enables or disables PDF tagging.\n          \n          By default, even when not producing a `PDF/UA-1` document, a tagged\n          PDF document is written to provide a baseline of accessibility. In\n          some circumstances (for example when trying to reduce the size of a\n          document) it can be desirable to disable PDF tags.\n          \n          [possible values: true, false]\n\n      --ppi <PPI>\n          The PPI (pixels per inch) to use for PNG export.\n          \n          [default: 144]\n\n      --deps <PATH>\n          File path to which a list of current compilation's dependencies will\n          be written. Use `-` to write to stdout\n\n      --deps-format <DEPS_FORMAT>\n          File format to use for dependencies\n\n          Possible values:\n          - json: Encodes as JSON, failing for non-Unicode paths\n          - zero: Separates paths with NULL bytes and can express all paths\n          - make: Emits in Make format, omitting inexpressible paths\n          \n          [default: json]\n\n  -j, --jobs <JOBS>\n          Number of parallel jobs spawned during compilation. Defaults to number\n          of CPUs. Setting it to 1 disables parallelism\n\n      --features <FEATURES>\n          Enables in-development features that may be changed or removed at any\n          time\n          \n          [env: TYPST_FEATURES=]\n          [possible values: html, bundle, a11y-extras]\n\n      --diagnostic-format <DIAGNOSTIC_FORMAT>\n          The format to emit diagnostics in\n          \n          [env: TYPST_DIAGNOSTIC_FORMAT=]\n          [default: human]\n          [possible values: human, short]\n\n      --open[=<VIEWER>]\n          Opens the output file with the default viewer or a specific program\n          after compilation. Ignored if output is stdout.\n          \n          When passing a specific program, the name must be attached with an\n          equals sign (`--open=VIEWER`).\n\n      --timings <OUTPUT_JSON>\n          Produces performance timings of the compilation process.\n          (experimental)\n          \n          The resulting JSON file can be loaded into a tracing tool such as\n          <https://ui.perfetto.dev>. It does not contain any sensitive\n          information apart from file names and line numbers.\n\n  -h, --help\n          Print help (see a summary with '-h')",
  ),
  (
    "watch", false, "Watches an input file and recompiles on changes\n\nUsage: typst watch [OPTIONS] <INPUT> [OUTPUT]\n\nArguments:\n  <INPUT>   Path to input Typst file. Use `-` to read input from stdin\n  [OUTPUT]  Path to output file (PDF, PNG, SVG, or HTML). Use `-` to write\n            output to stdout\n\nOptions:\n  -f, --format <FORMAT>\n          The format of the output file, inferred from the extension by default\n          [possible values: pdf, png, svg, html, bundle]\n      --root <DIR>\n          Configures the project root (for absolute paths) [env: TYPST_ROOT=]\n  -i, --input <key=value>\n          Add a string key-value pair visible through `sys.inputs`\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts\n          [env: TYPST_FONT_PATHS=]\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path` [env: TYPST_IGNORE_SYSTEM_FONTS=]\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered [env:\n          TYPST_IGNORE_EMBEDDED_FONTS=]\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          [env: TYPST_PACKAGE_PATH=]\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          [env: TYPST_PACKAGE_CACHE_PATH=]\n      --creation-timestamp <UNIX_TIMESTAMP>\n          The document's creation date formatted as a UNIX timestamp [env:\n          SOURCE_DATE_EPOCH=]\n      --pretty[=<PRETTY>]\n          Whether to pretty-print produced output [possible values: true, false]\n      --pages <PAGES>\n          Which pages to export. When unspecified, all pages are exported\n      --pdf-standard <PDF_STANDARD>\n          One (or multiple comma-separated) PDF standards that Typst will\n          enforce conformance with [possible values: 1.4, 1.5, 1.6, 1.7, 2.0,\n          a-1b, a-1a, a-2b, a-2u, a-2a, a-3b, a-3u, a-3a, a-4, a-4f, a-4e, ua-1]\n      --pdf-tagged[=<PDF_TAGGED>]\n          Enables or disables PDF tagging [possible values: true, false]\n      --ppi <PPI>\n          The PPI (pixels per inch) to use for PNG export\n      --deps <PATH>\n          File path to which a list of current compilation's dependencies will\n          be written. Use `-` to write to stdout\n      --deps-format <DEPS_FORMAT>\n          File format to use for dependencies [default: json] [possible values:\n          json, zero, make]\n  -j, --jobs <JOBS>\n          Number of parallel jobs spawned during compilation. Defaults to number\n          of CPUs. Setting it to 1 disables parallelism\n      --features <FEATURES>\n          Enables in-development features that may be changed or removed at any\n          time [env: TYPST_FEATURES=] [possible values: html, bundle,\n          a11y-extras]\n      --diagnostic-format <DIAGNOSTIC_FORMAT>\n          The format to emit diagnostics in [env: TYPST_DIAGNOSTIC_FORMAT=]\n          [default: human] [possible values: human, short]\n      --open[=<VIEWER>]\n          Opens the output file with the default viewer or a specific program\n          after compilation. Ignored if output is stdout\n      --timings <OUTPUT_JSON>\n          Produces performance timings of the compilation process.\n          (experimental)\n      --no-fullscreen\n          Stops the watcher from taking over the terminal\n      --no-serve\n          Disables the built-in HTTP server for HTML export\n      --no-reload\n          Disables the injected live reload script for HTML export. The HTML\n          that is written to disk isn't affected either way\n      --port <PORT>\n          The port where HTML is served\n  -h, --help\n          Print help (see more with '--help')",
  ),
  (
    "watch", true, "Watches an input file and recompiles on changes\n\nUsage: typst watch [OPTIONS] <INPUT> [OUTPUT]\n\nArguments:\n  <INPUT>\n          Path to input Typst file. Use `-` to read input from stdin\n\n  [OUTPUT]\n          Path to output file (PDF, PNG, SVG, or HTML). Use `-` to write output\n          to stdout.\n          \n          For output formats emitting one file per page (PNG & SVG), a page\n          number template must be present if the source document renders to\n          multiple pages. Use `{p}` for page numbers, `{0p}` for zero padded\n          page numbers and `{t}` for page count. For example,\n          `page-{0p}-of-{t}.png` creates `page-01-of-10.png`,\n          `page-02-of-10.png`, and so on.\n\nOptions:\n  -f, --format <FORMAT>\n          The format of the output file, inferred from the extension by default\n          \n          [possible values: pdf, png, svg, html, bundle]\n\n      --root <DIR>\n          Configures the project root (for absolute paths)\n          \n          [env: TYPST_ROOT=]\n\n  -i, --input <key=value>\n          Add a string key-value pair visible through `sys.inputs`\n\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts.\n          \n          If multiple paths are specified, they are separated by the system's\n          path separator (`:` on Unix-like systems and `;` on Windows).\n          \n          [env: TYPST_FONT_PATHS=]\n\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path`\n          \n          [env: TYPST_IGNORE_SYSTEM_FONTS=]\n\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered\n          \n          [env: TYPST_IGNORE_EMBEDDED_FONTS=]\n\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_PATH=]\n\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_CACHE_PATH=]\n\n      --creation-timestamp <UNIX_TIMESTAMP>\n          The document's creation date formatted as a UNIX timestamp.\n          \n          For more information, see\n          <https://reproducible-builds.org/specs/source-date-epoch/>.\n          \n          [env: SOURCE_DATE_EPOCH=]\n\n      --pretty[=<PRETTY>]\n          Whether to pretty-print produced output.\n          \n          This formats the output in a more human-readable, but less\n          space-efficient way. Affects HTML, SVG, and PDF export, but not PNG\n          export.\n          \n          [possible values: true, false]\n\n      --pages <PAGES>\n          Which pages to export. When unspecified, all pages are exported.\n          \n          Pages to export are separated by commas, and can be either simple page\n          numbers (e.g. '2,5' to export only pages 2 and 5) or page ranges (e.g.\n          '2,3-6,8-' to export page 2, pages 3 to 6 (inclusive), page 8 and any\n          pages after it).\n          \n          Page numbers are one-indexed and correspond to physical page numbers\n          in the document (therefore not being affected by the document's page\n          counter).\n\n      --pdf-standard <PDF_STANDARD>\n          One (or multiple comma-separated) PDF standards that Typst will\n          enforce conformance with\n\n          Possible values:\n          - 1.4:  PDF 1.4\n          - 1.5:  PDF 1.5\n          - 1.6:  PDF 1.6\n          - 1.7:  PDF 1.7\n          - 2.0:  PDF 2.0\n          - a-1b: PDF/A-1b\n          - a-1a: PDF/A-1a\n          - a-2b: PDF/A-2b\n          - a-2u: PDF/A-2u\n          - a-2a: PDF/A-2a\n          - a-3b: PDF/A-3b\n          - a-3u: PDF/A-3u\n          - a-3a: PDF/A-3a\n          - a-4:  PDF/A-4\n          - a-4f: PDF/A-4f\n          - a-4e: PDF/A-4e\n          - ua-1: PDF/UA-1\n\n      --pdf-tagged[=<PDF_TAGGED>]\n          Enables or disables PDF tagging.\n          \n          By default, even when not producing a `PDF/UA-1` document, a tagged\n          PDF document is written to provide a baseline of accessibility. In\n          some circumstances (for example when trying to reduce the size of a\n          document) it can be desirable to disable PDF tags.\n          \n          [possible values: true, false]\n\n      --ppi <PPI>\n          The PPI (pixels per inch) to use for PNG export.\n          \n          [default: 144]\n\n      --deps <PATH>\n          File path to which a list of current compilation's dependencies will\n          be written. Use `-` to write to stdout\n\n      --deps-format <DEPS_FORMAT>\n          File format to use for dependencies\n\n          Possible values:\n          - json: Encodes as JSON, failing for non-Unicode paths\n          - zero: Separates paths with NULL bytes and can express all paths\n          - make: Emits in Make format, omitting inexpressible paths\n          \n          [default: json]\n\n  -j, --jobs <JOBS>\n          Number of parallel jobs spawned during compilation. Defaults to number\n          of CPUs. Setting it to 1 disables parallelism\n\n      --features <FEATURES>\n          Enables in-development features that may be changed or removed at any\n          time\n          \n          [env: TYPST_FEATURES=]\n          [possible values: html, bundle, a11y-extras]\n\n      --diagnostic-format <DIAGNOSTIC_FORMAT>\n          The format to emit diagnostics in\n          \n          [env: TYPST_DIAGNOSTIC_FORMAT=]\n          [default: human]\n          [possible values: human, short]\n\n      --open[=<VIEWER>]\n          Opens the output file with the default viewer or a specific program\n          after compilation. Ignored if output is stdout.\n          \n          When passing a specific program, the name must be attached with an\n          equals sign (`--open=VIEWER`).\n\n      --timings <OUTPUT_JSON>\n          Produces performance timings of the compilation process.\n          (experimental)\n          \n          The resulting JSON file can be loaded into a tracing tool such as\n          <https://ui.perfetto.dev>. It does not contain any sensitive\n          information apart from file names and line numbers.\n\n      --no-fullscreen\n          Stops the watcher from taking over the terminal.\n          \n          With this flag, the watcher will only ever print normal output lines,\n          not clear or reconfigure the terminal.\n\n      --no-serve\n          Disables the built-in HTTP server for HTML export\n\n      --no-reload\n          Disables the injected live reload script for HTML export. The HTML\n          that is written to disk isn't affected either way\n\n      --port <PORT>\n          The port where HTML is served.\n          \n          Defaults to the first free port in the range 3000-3005.\n\n  -h, --help\n          Print help (see a summary with '-h')",
  ),
  (
    "init", false, "Initializes a new project from a template\n\nUsage: typst init [OPTIONS] <TEMPLATE> [DIR]\n\nArguments:\n  <TEMPLATE>  The template to use, e.g. `@preview/charged-ieee`\n  [DIR]       The project directory, defaults to the template's name\n\nOptions:\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          [env: TYPST_PACKAGE_PATH=]\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          [env: TYPST_PACKAGE_CACHE_PATH=]\n  -h, --help\n          Print help (see more with '--help')",
  ),
  (
    "init", true, "Initializes a new project from a template\n\nUsage: typst init [OPTIONS] <TEMPLATE> [DIR]\n\nArguments:\n  <TEMPLATE>\n          The template to use, e.g. `@preview/charged-ieee`.\n          \n          You can specify the version by appending e.g. `:0.1.0`. If no version\n          is specified, Typst will default to the latest version.\n          \n          Supports both local and published templates.\n\n  [DIR]\n          The project directory, defaults to the template's name\n\nOptions:\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_PATH=]\n\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_CACHE_PATH=]\n\n  -h, --help\n          Print help (see a summary with '-h')",
  ),
  (
    "query", false, "Processes an input file to extract provided metadata (deprecated, use `eval`\ninstead)\n\nUsage: typst query [OPTIONS] <INPUT> <SELECTOR>\n\nArguments:\n  <INPUT>     Path to input Typst file. Use `-` to read input from stdin\n  <SELECTOR>  Defines which elements to retrieve\n\nOptions:\n      --field <FIELD>\n          Extracts just one field from all retrieved elements\n      --one\n          Expects and retrieves exactly one element\n      --format <FORMAT>\n          The format to serialize in [default: json] [possible values: json,\n          yaml]\n      --pretty\n          Whether to pretty-print the serialized output\n      --target <TARGET>\n          The target to compile for [default: paged] [possible values: paged,\n          html, bundle]\n      --root <DIR>\n          Configures the project root (for absolute paths) [env: TYPST_ROOT=]\n  -i, --input <key=value>\n          Add a string key-value pair visible through `sys.inputs`\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts\n          [env: TYPST_FONT_PATHS=]\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path` [env: TYPST_IGNORE_SYSTEM_FONTS=]\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered [env:\n          TYPST_IGNORE_EMBEDDED_FONTS=]\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          [env: TYPST_PACKAGE_PATH=]\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          [env: TYPST_PACKAGE_CACHE_PATH=]\n      --creation-timestamp <UNIX_TIMESTAMP>\n          The document's creation date formatted as a UNIX timestamp [env:\n          SOURCE_DATE_EPOCH=]\n  -j, --jobs <JOBS>\n          Number of parallel jobs spawned during compilation. Defaults to number\n          of CPUs. Setting it to 1 disables parallelism\n      --features <FEATURES>\n          Enables in-development features that may be changed or removed at any\n          time [env: TYPST_FEATURES=] [possible values: html, bundle,\n          a11y-extras]\n      --diagnostic-format <DIAGNOSTIC_FORMAT>\n          The format to emit diagnostics in [env: TYPST_DIAGNOSTIC_FORMAT=]\n          [default: human] [possible values: human, short]\n  -h, --help\n          Print help (see more with '--help')",
  ),
  (
    "query", true, "Processes an input file to extract provided metadata (deprecated, use `eval`\ninstead)\n\nUsage: typst query [OPTIONS] <INPUT> <SELECTOR>\n\nArguments:\n  <INPUT>\n          Path to input Typst file. Use `-` to read input from stdin\n\n  <SELECTOR>\n          Defines which elements to retrieve\n\nOptions:\n      --field <FIELD>\n          Extracts just one field from all retrieved elements\n\n      --one\n          Expects and retrieves exactly one element\n\n      --format <FORMAT>\n          The format to serialize in\n          \n          [default: json]\n          [possible values: json, yaml]\n\n      --pretty\n          Whether to pretty-print the serialized output.\n          \n          Only applies to JSON format.\n\n      --target <TARGET>\n          The target to compile for\n\n          Possible values:\n          - paged:  PDF and image formats\n          - html:   HTML\n          - bundle: Bundle\n          \n          [default: paged]\n\n      --root <DIR>\n          Configures the project root (for absolute paths)\n          \n          [env: TYPST_ROOT=]\n\n  -i, --input <key=value>\n          Add a string key-value pair visible through `sys.inputs`\n\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts.\n          \n          If multiple paths are specified, they are separated by the system's\n          path separator (`:` on Unix-like systems and `;` on Windows).\n          \n          [env: TYPST_FONT_PATHS=]\n\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path`\n          \n          [env: TYPST_IGNORE_SYSTEM_FONTS=]\n\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered\n          \n          [env: TYPST_IGNORE_EMBEDDED_FONTS=]\n\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_PATH=]\n\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_CACHE_PATH=]\n\n      --creation-timestamp <UNIX_TIMESTAMP>\n          The document's creation date formatted as a UNIX timestamp.\n          \n          For more information, see\n          <https://reproducible-builds.org/specs/source-date-epoch/>.\n          \n          [env: SOURCE_DATE_EPOCH=]\n\n  -j, --jobs <JOBS>\n          Number of parallel jobs spawned during compilation. Defaults to number\n          of CPUs. Setting it to 1 disables parallelism\n\n      --features <FEATURES>\n          Enables in-development features that may be changed or removed at any\n          time\n          \n          [env: TYPST_FEATURES=]\n          [possible values: html, bundle, a11y-extras]\n\n      --diagnostic-format <DIAGNOSTIC_FORMAT>\n          The format to emit diagnostics in\n          \n          [env: TYPST_DIAGNOSTIC_FORMAT=]\n          [default: human]\n          [possible values: human, short]\n\n  -h, --help\n          Print help (see a summary with '-h')",
  ),
  (
    "eval", false, "Evaluates a piece of Typst code, optionally in the context of a document\n\nUsage: typst eval [OPTIONS] <EXPRESSION>\n\nArguments:\n  <EXPRESSION>  The piece of Typst code to evaluate\n\nOptions:\n      --in <IN>\n          A file in whose context to evaluate the code. Can be used to\n          introspect the document. Use `-` to read input from stdin\n      --target <TARGET>\n          The target to compile for [default: paged] [possible values: paged,\n          html, bundle]\n      --format <FORMAT>\n          The format to serialize in [default: json] [possible values: json,\n          yaml, raw]\n      --pretty\n          Whether to pretty-print the serialized output\n      --root <DIR>\n          Configures the project root (for absolute paths) [env: TYPST_ROOT=]\n  -i, --input <key=value>\n          Add a string key-value pair visible through `sys.inputs`\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts\n          [env: TYPST_FONT_PATHS=]\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path` [env: TYPST_IGNORE_SYSTEM_FONTS=]\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered [env:\n          TYPST_IGNORE_EMBEDDED_FONTS=]\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          [env: TYPST_PACKAGE_PATH=]\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          [env: TYPST_PACKAGE_CACHE_PATH=]\n      --creation-timestamp <UNIX_TIMESTAMP>\n          The document's creation date formatted as a UNIX timestamp [env:\n          SOURCE_DATE_EPOCH=]\n  -j, --jobs <JOBS>\n          Number of parallel jobs spawned during compilation. Defaults to number\n          of CPUs. Setting it to 1 disables parallelism\n      --features <FEATURES>\n          Enables in-development features that may be changed or removed at any\n          time [env: TYPST_FEATURES=] [possible values: html, bundle,\n          a11y-extras]\n      --diagnostic-format <DIAGNOSTIC_FORMAT>\n          The format to emit diagnostics in [env: TYPST_DIAGNOSTIC_FORMAT=]\n          [default: human] [possible values: human, short]\n  -h, --help\n          Print help (see more with '--help')",
  ),
  (
    "eval", true, "Evaluates a piece of Typst code, optionally in the context of a document\n\nUsage: typst eval [OPTIONS] <EXPRESSION>\n\nArguments:\n  <EXPRESSION>\n          The piece of Typst code to evaluate\n\nOptions:\n      --in <IN>\n          A file in whose context to evaluate the code. Can be used to\n          introspect the document. Use `-` to read input from stdin\n\n      --target <TARGET>\n          The target to compile for\n\n          Possible values:\n          - paged:  PDF and image formats\n          - html:   HTML\n          - bundle: Bundle\n          \n          [default: paged]\n\n      --format <FORMAT>\n          The format to serialize in\n\n          Possible values:\n          - json\n          - yaml\n          - raw:  Prints the output without any additional formatting or\n            escaping (only supports strings and bytes)\n          \n          [default: json]\n\n      --pretty\n          Whether to pretty-print the serialized output.\n          \n          Only applies to JSON format.\n\n      --root <DIR>\n          Configures the project root (for absolute paths)\n          \n          [env: TYPST_ROOT=]\n\n  -i, --input <key=value>\n          Add a string key-value pair visible through `sys.inputs`\n\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts.\n          \n          If multiple paths are specified, they are separated by the system's\n          path separator (`:` on Unix-like systems and `;` on Windows).\n          \n          [env: TYPST_FONT_PATHS=]\n\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path`\n          \n          [env: TYPST_IGNORE_SYSTEM_FONTS=]\n\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered\n          \n          [env: TYPST_IGNORE_EMBEDDED_FONTS=]\n\n      --package-path <DIR>\n          Custom path to local packages, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_PATH=]\n\n      --package-cache-path <DIR>\n          Custom path to package cache, defaults to system-dependent location\n          \n          [env: TYPST_PACKAGE_CACHE_PATH=]\n\n      --creation-timestamp <UNIX_TIMESTAMP>\n          The document's creation date formatted as a UNIX timestamp.\n          \n          For more information, see\n          <https://reproducible-builds.org/specs/source-date-epoch/>.\n          \n          [env: SOURCE_DATE_EPOCH=]\n\n  -j, --jobs <JOBS>\n          Number of parallel jobs spawned during compilation. Defaults to number\n          of CPUs. Setting it to 1 disables parallelism\n\n      --features <FEATURES>\n          Enables in-development features that may be changed or removed at any\n          time\n          \n          [env: TYPST_FEATURES=]\n          [possible values: html, bundle, a11y-extras]\n\n      --diagnostic-format <DIAGNOSTIC_FORMAT>\n          The format to emit diagnostics in\n          \n          [env: TYPST_DIAGNOSTIC_FORMAT=]\n          [default: human]\n          [possible values: human, short]\n\n  -h, --help\n          Print help (see a summary with '-h')",
  ),
  (
    "fonts", false, "Lists all discovered fonts in system and custom font paths\n\nUsage: typst fonts [OPTIONS]\n\nOptions:\n      --font-path <DIR>        Adds additional directories that are recursively\n                               searched for fonts [env: TYPST_FONT_PATHS=]\n      --ignore-system-fonts    Ensures system fonts won't be searched, unless\n                               explicitly included via `--font-path` [env:\n                               TYPST_IGNORE_SYSTEM_FONTS=]\n      --ignore-embedded-fonts  Ensures fonts embedded into Typst won't be\n                               considered [env: TYPST_IGNORE_EMBEDDED_FONTS=]\n      --variants               Also lists style variants of each font family\n  -h, --help                   Print help (see more with '--help')",
  ),
  (
    "fonts", true, "Lists all discovered fonts in system and custom font paths\n\nUsage: typst fonts [OPTIONS]\n\nOptions:\n      --font-path <DIR>\n          Adds additional directories that are recursively searched for fonts.\n          \n          If multiple paths are specified, they are separated by the system's\n          path separator (`:` on Unix-like systems and `;` on Windows).\n          \n          [env: TYPST_FONT_PATHS=]\n\n      --ignore-system-fonts\n          Ensures system fonts won't be searched, unless explicitly included via\n          `--font-path`\n          \n          [env: TYPST_IGNORE_SYSTEM_FONTS=]\n\n      --ignore-embedded-fonts\n          Ensures fonts embedded into Typst won't be considered\n          \n          [env: TYPST_IGNORE_EMBEDDED_FONTS=]\n\n      --variants\n          Also lists style variants of each font family\n\n  -h, --help\n          Print help (see a summary with '-h')",
  ),
  (
    "update", false, "Self update the Typst CLI\n\nUsage: typst update [OPTIONS] [VERSION]\n\nArguments:\n  [VERSION]  Which version to update to (defaults to latest)\n\nOptions:\n      --force               Forces a downgrade to an older version (required for\n                            downgrading)\n      --revert              Reverts to the version from before the last update\n                            (only possible if `typst update` has previously ran)\n      --backup-path <FILE>  Custom path to the backup file created on update and\n                            used by `--revert`, defaults to system-dependent\n                            location [env: TYPST_UPDATE_BACKUP_PATH=]\n  -h, --help                Print help",
  ),
  (
    "update", true, "Self update the Typst CLI\n\nUsage: typst update [OPTIONS] [VERSION]\n\nArguments:\n  [VERSION]  Which version to update to (defaults to latest)\n\nOptions:\n      --force               Forces a downgrade to an older version (required for\n                            downgrading)\n      --revert              Reverts to the version from before the last update\n                            (only possible if `typst update` has previously ran)\n      --backup-path <FILE>  Custom path to the backup file created on update and\n                            used by `--revert`, defaults to system-dependent\n                            location [env: TYPST_UPDATE_BACKUP_PATH=]\n  -h, --help                Print help",
  ),
  (
    "completions", false, "Generates shell completion scripts\n\nUsage: typst completions <SHELL>\n\nArguments:\n  <SHELL>  The shell to generate completions for [possible values: bash, elvish,\n           fish, nushell, powershell, zsh]\n\nOptions:\n  -h, --help  Print help",
  ),
  (
    "completions", true, "Generates shell completion scripts\n\nUsage: typst completions <SHELL>\n\nArguments:\n  <SHELL>  The shell to generate completions for [possible values: bash, elvish,\n           fish, nushell, powershell, zsh]\n\nOptions:\n  -h, --help  Print help",
  ),
  (
    "info", false, "Displays debugging information about Typst\n\nUsage: typst info [OPTIONS]\n\nOptions:\n  -f, --format <FORMAT>  The format to serialize in, if it should be\n                         machine-readable [possible values: json, yaml]\n      --pretty           Whether to pretty-print the serialized output\n  -h, --help             Print help (see more with '--help')",
  ),
  (
    "info", true, "Displays debugging information about Typst\n\nUsage: typst info [OPTIONS]\n\nOptions:\n  -f, --format <FORMAT>\n          The format to serialize in, if it should be machine-readable.\n          \n          If no format is passed the output is displayed human-readable. Note\n          that human-readable format truncates the build commit hash value.\n          \n          [possible values: json, yaml]\n\n      --pretty\n          Whether to pretty-print the serialized output.\n          \n          Only applies to JSON format.\n\n  -h, --help\n          Print help (see a summary with '-h')",
