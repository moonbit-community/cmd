import {
  "cli/jqlog/internal/parser",
  "cli/jqlog/internal/ast",
  "moonbitlang/core/json",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

supported_targets = "native+wasm"

import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @fixture_fs,
} for "wbtest"

rule(
  name: "gen_version",
  command: "moonx moonbit-community/gen_version@0.0.2 -o $output",
)

dev_build(rule: "gen_version", input: "../../moon.mod", output: "version.mbt")
